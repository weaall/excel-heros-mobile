/* Excel Heroes - shared runtime styling.
   Portrait phone. The look is Microsoft Excel, not a game with a spreadsheet motif: white sheet,
   #217346 chrome, hairline cell borders, and small dense type. That is the premise — the game has
   to survive being looked at over your shoulder — so the chrome is the product, not decoration. */

/* ---------------------------------------------------------------- shell */

.root {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    color: rgb(34, 34, 34);
    font-size: 26px;
}

.spacer { flex-grow: 1; }

/* ---------------------------------------------------------------- title bar */

.titlebar {
    flex-direction: row;
    align-items: center;
    height: 72px;
    padding-left: 16px;
    padding-right: 10px;
    background-color: rgb(33, 115, 70);
}

.app-icon {
    width: 40px;
    height: 40px;
    -unity-text-align: middle-center;
    background-color: rgb(255, 255, 255);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    font-size: 26px;
    border-radius: 4px;
    margin-right: 12px;
}

.title-text { color: rgb(255, 255, 255); font-size: 26px; }

.autosave {
    color: rgb(255, 255, 255);
    font-size: 22px;
    opacity: 0.9;
    margin-right: 8px;
}

.tb-btn {
    height: 52px;
    min-width: 52px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0;
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 28px;
}

.tb-btn:hover { background-color: rgba(255, 255, 255, 0.3); }

/* ---------------------------------------------------------------- ribbon */

.ribbon-tabs {
    flex-direction: row;
    height: 60px;
    background-color: rgb(33, 115, 70);
    padding-left: 8px;
}

.ribbon-tab {
    height: 60px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
}

.ribbon-tab--file { -unity-font-style: bold; }

.ribbon-tab--active {
    background-color: rgb(243, 243, 243);
    color: rgb(34, 34, 34);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.ribbon-dot {
    position: absolute;
    top: 10px;
    right: 8px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(196, 43, 28);
}

.ribbon {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(243, 243, 243);
    border-bottom-width: 1px;
    border-bottom-color: rgb(191, 191, 191);
}

.rb-btn {
    height: 76px;
    min-width: 108px;
    margin-right: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    color: rgb(34, 34, 34);
    font-size: 22px;
}

.rb-btn:hover { background-color: rgb(226, 239, 218); border-color: rgb(191, 191, 191); }
.rb-btn:disabled { opacity: 0.45; }
.rb-btn__icon { font-size: 28px; color: rgb(33, 115, 70); }
.rb-btn__sub { font-size: 18px; color: rgb(107, 107, 107); }

.rb-sep {
    width: 1px;
    height: 64px;
    margin-left: 6px;
    margin-right: 10px;
    background-color: rgb(212, 212, 212);
}

/* ---------------------------------------------------------------- formula bar */

.formula-bar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.name-box {
    width: 150px;
    height: 56px;
    -unity-text-align: middle-center;
    font-size: 22px;
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.fx {
    width: 56px;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(107, 107, 107);
    -unity-font-style: italic;
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.formula {
    flex-grow: 1;
    padding-left: 14px;
    font-size: 22px;
    color: rgb(34, 34, 34);
}

/* ---------------------------------------------------------------- sheet + status */

.sheet {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
}

.screen { flex-grow: 1; overflow: hidden; }

.screen-body {
    flex-grow: 1;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
}

.statusbar {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding-left: 16px;
    padding-right: 12px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-top-color: rgb(212, 212, 212);
}

.status-text { font-size: 20px; color: rgb(107, 107, 107); }

.cell-stat {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
}

.cell-stat__icon { font-size: 20px; margin-right: 6px; color: rgb(107, 107, 107); }
.cell-stat__value { font-size: 22px; -unity-font-style: bold; }

#gemChip .cell-stat__value { color: rgb(31, 111, 235); }
#goldChip .cell-stat__value { color: rgb(150, 112, 8); }

/* ---------------------------------------------------------------- sheet tabs */

/* Excel Mobile scrolls its sheet tabs rather than wrapping them, so eight tabs on a phone is
   ordinary rather than a sign that something has been squeezed in. */
.sheet-tabs-scroll {
    height: 76px;
    flex-shrink: 0;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-top-color: rgb(212, 212, 212);
}

.sheet-tabs { flex-direction: row; align-items: center; height: 76px; }

.sheet-tab {
    height: 76px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
    color: rgb(70, 70, 70);
    font-size: 23px;
}

.sheet-tab--active {
    background-color: rgb(255, 255, 255);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    border-bottom-width: 4px;
    border-bottom-color: rgb(33, 115, 70);
}

.sheet-tab__badge {
    position: absolute;
    top: 10px;
    right: 8px;
    min-width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(196, 43, 28);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- overlay */

/* The result panel used to be bare text floating on the battle, because the overlay was only a
   full-screen box with no surface of its own. It dims what is behind it and centres one card. */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
}

/* ---------------------------------------------------------------- generic pieces */

.panel {
    background-color: rgb(250, 250, 250);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    padding: 20px;
    margin-bottom: 16px;
}

.section-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(107, 107, 107);
    margin-bottom: 10px;
}

.muted { color: rgb(128, 128, 128); }
.hidden { display: none; }

.btn {
    height: 88px;
    background-color: rgb(238, 238, 238);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(34, 34, 34);
    font-size: 28px;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.btn:hover { background-color: rgb(226, 239, 218); }
.btn:disabled { opacity: 0.4; }

.btn--primary {
    background-color: rgb(150, 112, 8);
    border-color: rgb(176, 132, 10);
    color: rgb(253, 246, 227);
}

.btn--primary:hover { background-color: rgb(24, 92, 55); }

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(191, 191, 191);
}

/* ---------------------------------------------------------------- home */

.home { flex-grow: 1; }

.home__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* stacked on the base art so a motion frame can cross-fade in */
.home__art-motion {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 0.9s;
}

.home__art-motion--on { opacity: 1; }

.home__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 620px;
    background-color: rgba(255, 255, 255, 0.62);
}

.home__strip {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 16px;
    flex-direction: row;
    justify-content: space-between;
}

.home__stat {
    flex-grow: 1;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgba(255, 255, 255, 0.72);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.6);
}

.home__stat-value { font-size: 30px; -unity-font-style: bold; color: rgb(176, 132, 10); }
.home__stat-key { font-size: 19px; color: rgb(107, 107, 107); }

.home__bubble {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 240px;
    padding: 20px;
    background-color: rgba(255, 255, 255, 0.82);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.7);
}

.home__who { font-size: 24px; color: rgb(33, 115, 70); -unity-font-style: bold; }

.home__speech {
    font-size: 27px;
    white-space: normal;
    margin-top: 8px;
    color: rgb(34, 34, 34);
}

.home__bond { margin-top: 16px; }
.home__bond-level { font-size: 20px; color: rgb(200, 60, 110); }

.home__bond-track {
    height: 10px;
    margin-top: 6px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 5px;
    overflow: hidden;
}

.home__bond-fill { height: 100%; background-color: rgb(200, 60, 110); }

.home__actions {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    flex-direction: row;
}

.home__actions .btn { flex-grow: 1; margin-left: 5px; margin-right: 5px; }

/* ---------------------------------------------------------------- pickup banner */

.pickup {
    flex-direction: row;
    width: 100%;
    margin-bottom: 14px;
}

.pickup__card {
    flex-grow: 1;
    height: 300px;
    margin-left: 6px;
    margin-right: 6px;
    border-radius: 16px;
    border-width: 3px;
    overflow: hidden;
    justify-content: flex-end;
}

.pickup__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.pickup__plate {
    background-color: rgba(255, 255, 255, 0.86);
    padding: 8px;
    align-items: center;
}

.pickup__tag {
    position: absolute;
    left: 8px;
    top: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 12px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgb(196, 43, 28);
    color: rgb(120, 40, 70);
}

.pickup__name { font-size: 21px; -unity-font-style: bold; }
.pickup__spark { font-size: 18px; color: rgb(31, 111, 235); }

.pickup__timer {
    font-size: 21px;
    color: rgb(200, 60, 110);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

/* ---------------------------------------------------------------- gacha */

.gacha {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(255, 255, 255);
}

.gacha__banner {
    align-items: center;
    margin-top: 40px;
    margin-bottom: 20px;
}

.gacha__banner-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(196, 152, 20);
}

.gacha__banner-sub {
    font-size: 22px;
    color: rgb(107, 107, 107);
    margin-top: 6px;
}

.gacha__pity {
    flex-direction: row;
    margin-top: 16px;
}

.pity-chip {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    font-size: 22px;
}

.gacha__actions {
    width: 100%;
    margin-bottom: 24px;
}

.gacha__actions .btn { margin-top: 12px; }

/* ---------------------------------------------------------------- reveal */

.reveal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.94);
    align-items: center;
    justify-content: center;
}

.reveal__card {
    width: 560px;
    height: 780px;
    border-radius: 20px;
    border-width: 4px;
    overflow: hidden;
    align-items: center;
    justify-content: flex-end;
}

.reveal__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal__plate {
    width: 100%;
    padding: 18px;
    background-color: rgba(255, 255, 255, 0.86);
    align-items: center;
}

.reveal__grade {
    font-size: 54px;
    -unity-font-style: bold;
}

.reveal__name {
    font-size: 34px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.reveal__nick { font-size: 22px; color: rgb(107, 107, 107); }

.reveal__line {
    font-size: 22px;
    color: rgb(70, 70, 70);
    margin-top: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.reveal__badge {
    margin-top: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    font-size: 20px;
    background-color: rgb(150, 112, 8);
    color: rgb(253, 246, 227);
}

.reveal__hint {
    margin-top: 28px;
    font-size: 24px;
    color: rgb(107, 107, 107);
}

/* --- the tell -------------------------------------------------------------
   A column of light rises before the card resolves, in the rarity's colour.
   This is where the tension of a pull actually lives: by the time the art is
   on screen the player already knows, and the card is the confirmation. */

.tell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.tell__beam {
    width: 90px;
    height: 0;
    opacity: 0;
    transition-duration: 0.45s;
}

.tell__beam--up { height: 1100px; opacity: 0.9; }

.tell__ring {
    position: absolute;
    width: 160px;
    height: 160px;
    border-radius: 80px;
    border-width: 4px;
    opacity: 0;
    scale: 0.3 0.3;
    transition-duration: 0.5s;
}

.tell__ring--out { opacity: 0; scale: 3.4 3.4; }
.tell__ring--in { opacity: 0.95; scale: 1 1; }

.tell__label {
    position: absolute;
    bottom: 300px;
    font-size: 34px;
    -unity-font-style: bold;
    opacity: 0;
    transition-duration: 0.3s;
}

.tell__label--on { opacity: 1; }

/* the card landing */
.reveal__card {
    transition-duration: 0.28s;
}

/* ten-pull summary grid */

.reveal-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.reveal-grid__cell {
    width: 190px;
    height: 264px;
    margin: 6px;
    border-radius: 12px;
    border-width: 3px;
    overflow: hidden;
    justify-content: flex-end;
}

.reveal-grid__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-grid__plate {
    background-color: rgba(255, 255, 255, 0.86);
    padding-top: 4px;
    padding-bottom: 4px;
    align-items: center;
}

.reveal-grid__name { font-size: 18px; }
.reveal-grid__grade { font-size: 20px; -unity-font-style: bold; }

/* ---------------------------------------------------------------- roster */

.roster-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.card {
    width: 214px;
    height: 306px;
    margin: 7px;
    border-radius: 14px;
    border-width: 3px;
    overflow: hidden;
    justify-content: flex-end;
    transition-duration: 0.12s;
}

.card:hover { scale: 1.03 1.03; }

.card--locked { opacity: 0.32; }

.card__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.card__top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    flex-direction: row;
    justify-content: space-between;
    padding: 8px;
}

.card__grade {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.card__role {
    padding-left: 10px;
    padding-right: 10px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(255, 255, 255, 0.8);
    -unity-text-align: middle-center;
    font-size: 19px;
}

.card__plate {
    background-color: rgba(255, 255, 255, 0.88);
    padding: 8px;
}

.card__name { font-size: 21px; -unity-font-style: bold; }
.card__stars { font-size: 19px; color: rgb(176, 132, 10); }

.card__copies {
    font-size: 18px;
    color: rgb(31, 111, 235);
}

/* ---------------------------------------------------------------- hero detail */

/* The card detail is a sheet, not a poster: the illustration sits in a fixed header and everything
   below it is ordinary white rows. The first version floated text straight on the art with a dark
   scrim, which was unreadable the moment the theme went light — and the panel had no background at
   all, so the roster grid showed through it. */
.detail {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
}

.detail__art {
    height: 720px;
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-to-fit;
}

.detail__scrim { display: none; }

.detail__head {
    padding: 14px 24px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(212, 212, 212);
    border-bottom-color: rgb(212, 212, 212);
}

.detail__name { font-size: 40px; -unity-font-style: bold; }
.detail__nick { font-size: 24px; color: rgb(107, 107, 107); }

.detail__body {
    flex-grow: 1;
    padding: 24px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(238, 238, 238);
}

.stat-row__key { color: rgb(107, 107, 107); font-size: 24px; }
.stat-row__value { font-size: 24px; -unity-font-style: bold; }

.detail__close {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgba(255, 255, 255, 0.8);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(34, 34, 34);
    font-size: 32px;
}

/* ---------------------------------------------------------------- party */

.party-slots {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 16px;
}

.slot {
    width: 190px;
    height: 262px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(250, 250, 250);
    overflow: hidden;
    justify-content: flex-end;
}

.slot--empty {
    align-items: center;
    justify-content: center;
    border-color: rgb(226, 239, 218);
}

.slot__plus { font-size: 44px; color: rgb(160, 160, 160); }

.synergy-line {
    font-size: 22px;
    color: rgb(24, 92, 55);
    margin-bottom: 4px;
}

.power-readout {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 8px;
}

.power-readout__value {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(176, 132, 10);
}

.power-readout__label {
    font-size: 22px;
    color: rgb(107, 107, 107);
    margin-left: 10px;
    margin-bottom: 10px;
}

/* ---------------------------------------------------------------- battle */

.battle {
    flex-grow: 1;
}

/* The battlefield is the worksheet. A painted landscape was both off-premise and unreadable behind
   16x28 pixel sprites; a tiled cell grid gives them a surface to stand on and survives the disguise,
   because what a passer-by sees is cells. */
.battle__stage {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/UI/cell_grid.png");
    background-repeat: repeat;
    background-size: 64px 64px;
    overflow: hidden;
}

.fighter {
    position: absolute;
    width: 110px;
    align-items: center;
}

/* Pixel sprites want whole-number scale and no crop. 16x28 at 6x is 96x168, which reads clearly at
   arm's length on a phone and still lines the cast up on one baseline. */
.fighter__body {
    width: 64px;
    height: 112px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.fighter__body--chibi {
    width: 64px;
    height: 112px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Monsters face the party: the tileset draws everything facing right. */
.fighter--monster .fighter__body { scale: -1 1; }

.fighter--dead { opacity: 0.25; }

.fighter__hpbar {
    width: 84px;
    height: 10px;
    margin-top: 6px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 5px;
    overflow: hidden;
}

.fighter__hpfill {
    height: 100%;
    background-color: rgb(33, 115, 70);
}

.fighter--monster .fighter__hpfill { background-color: rgb(196, 43, 28); }

.fighter__name {
    font-size: 17px;
    margin-top: 4px;
    color: rgb(70, 70, 70);
}

.floater {
    position: absolute;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(150, 112, 8);
}

.floater--heal { color: rgb(24, 92, 55); }
.floater--skill { color: rgb(31, 111, 235); font-size: 24px; }

.battle__hud {
    height: 90px;
    flex-direction: row;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgb(243, 243, 243);
}

.battle__wave {
    flex-grow: 1;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(34, 34, 34);
    transition-duration: 0.3s;
}

/* 야근: overtime has started and the errors are hitting harder every second */
.battle__wave--enraged { color: rgb(196, 43, 28); }

.ex-bar {
    flex-direction: row;
    height: 160px;
    align-items: center;
    justify-content: center;
    background-color: rgb(250, 250, 250);
    padding-top: 10px;
    padding-bottom: 10px;
}

.ex-button {
    width: 132px;
    height: 132px;
    margin-left: 7px;
    margin-right: 7px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(243, 243, 243);
    overflow: hidden;
    justify-content: flex-end;
    align-items: center;
    transition-duration: 0.15s;
}

.ex-button--ready {
    border-color: rgb(176, 132, 10);
    scale: 1.05 1.05;
}

.ex-button--spent { opacity: 0.45; }

.ex-button__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.ex-button__charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(240, 196, 70, 0.28);
}

.ex-button__label {
    width: 100%;
    font-size: 17px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.85);
    padding-top: 3px;
    padding-bottom: 3px;
}

.result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.92);
    align-items: center;
    justify-content: center;
}

.result__title {
    font-size: 72px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.result__title--win { color: rgb(176, 132, 10); }
.result__title--lose { color: rgb(196, 43, 28); }

/* ---------------------------------------------------------------- daily */

.stamp__row { flex-direction: row; margin-top: 8px; margin-bottom: 8px; }

.stamp__dot {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    margin-right: 8px;
    background-color: rgb(238, 238, 238);
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    transition-duration: 0.2s;
}

.stamp__dot--on {
    background-color: rgb(33, 115, 70);
    border-color: rgb(196, 152, 20);
}

.quest--done { opacity: 0.5; }

.quest__track {
    height: 12px;
    margin-top: 10px;
    background-color: rgb(238, 238, 238);
    border-radius: 6px;
    overflow: hidden;
}

.quest__fill { height: 100%; background-color: rgb(31, 111, 235); }

.quest__meta { font-size: 21px; color: rgb(107, 107, 107); margin-top: 8px; }

/* a count of claimable rewards, parked on the nav button */
.nav-badge {
    position: absolute;
    right: 18px;
    top: 14px;
    min-width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: rgb(196, 43, 28);
    color: rgb(120, 40, 70);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 8px;
    padding-right: 8px;
}

/* ---------------------------------------------------------------- onboarding */

.onboard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 28px;
    padding-right: 28px;
}

.onboard__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(243, 243, 243);
}

.onboard__card {
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.8);
    padding: 30px;
}

.onboard__title {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    margin-bottom: 18px;
}

.onboard__line {
    font-size: 27px;
    white-space: normal;
    margin-bottom: 8px;
    color: rgb(34, 34, 34);
}

.onboard__tip {
    margin-top: 22px;
    margin-bottom: 22px;
    padding: 18px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 14px;
    border-left-width: 4px;
    border-left-color: rgb(31, 111, 235);
}

.onboard__tip-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
    margin-bottom: 4px;
}

.onboard__card .btn { margin-top: 10px; }

/* ---------------------------------------------------------------- EX cut-in */

/* The signature moment: firing a skill throws the character's own illustration across the
   screen shouting their line. It is the one time the art is at full size during play, and
   it is what makes a skill feel like a person acting rather than a number resolving. */

.cutin {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    overflow: hidden;
}

.cutin__sweep {
    position: absolute;
    left: -120%;
    right: 120%;
    height: 420px;
    background-color: rgba(240, 196, 70, 0.22);
    transition-duration: 0.28s;
}

.cutin__sweep--in { left: -10%; right: -10%; }

.cutin__art {
    position: absolute;
    left: -60%;
    width: 70%;
    height: 420px;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__art--in { left: -4%; opacity: 1; }

.cutin__plate {
    position: absolute;
    right: 24px;
    align-items: flex-end;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__plate--in { opacity: 1; }

.cutin__skill {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(150, 112, 8);
}

.cutin__line {
    font-size: 26px;
    color: rgb(34, 34, 34);
    max-width: 560px;
    white-space: normal;
    -unity-text-align: upper-right;
    margin-top: 6px;
}

/* --- hit feedback ------------------------------------------------------- */

.fighter__body { transition-duration: 0.09s; }

/* a lunge towards the enemy on the swing, so an attack has a body behind it */
.fighter--hero .fighter__body--swing { translate: 22px 0; }
.fighter--monster .fighter__body--swing { translate: -22px 0; }

.fighter__body--hurt { scale: 1.18 1.18; }

.fighter--dead {
    opacity: 0.25;
    transition-duration: 0.35s;
    scale: 0.82 0.82;
}

/* ---------------------------------------------------------------- story */

/* episode list */

.ep--locked { opacity: 0.45; }

.ep__cast { flex-direction: row; margin-bottom: 10px; }

.ep__face {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-right: -14px;
    border-width: 2px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
}

/* the log itself */

.chat__header {
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.chat__title { font-size: 34px; -unity-font-style: bold; }

.chat-room {
    font-size: 22px;
    color: rgb(31, 111, 235);
    margin-top: 4px;
}

.chat-line {
    flex-direction: row;
    margin-bottom: 16px;
    align-items: flex-start;
}

.chat-line--mine { justify-content: flex-end; }

.chat-line--sys {
    justify-content: center;
    margin-top: 6px;
    margin-bottom: 18px;
}

.chat-avatar {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    margin-right: 12px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(243, 243, 243);
    -unity-background-scale-mode: scale-and-crop;
}

/* a repeated speaker keeps the indent but drops the face */
.chat-avatar--blank {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.chat-column { flex-shrink: 1; }

.chat-who {
    font-size: 20px;
    color: rgb(107, 107, 107);
    margin-bottom: 5px;
}

.chat-bubble {
    max-width: 660px;
    padding: 15px;
    border-radius: 16px;
    background-color: rgb(240, 240, 240);
    font-size: 24px;
    white-space: normal;
}

.chat-line--mine .chat-bubble {
    background-color: rgb(226, 239, 218);
    color: rgb(253, 246, 227);
}

.chat-line--sys .chat-bubble {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(107, 107, 107);
    font-size: 21px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- sheet furniture */

/* Every sheet opens with a summary strip, the way a real one opens with a header row. */
.sheet-head {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 12px 20px;
    background-color: rgb(243, 243, 243);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.sheet-head__stat { font-size: 22px; -unity-font-style: bold; margin-right: 20px; }
.sheet-head .muted { font-size: 20px; }

.xl-row {
    flex-direction: row;
    align-items: center;
    min-height: 60px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.xl-row--head {
    background-color: rgb(243, 243, 243);
    border-bottom-color: rgb(191, 191, 191);
}

.xl-row--head .xl-cell { -unity-font-style: bold; color: rgb(70, 70, 70); }
.xl-row--boss .xl-cell { color: rgb(150, 112, 8); -unity-font-style: bold; }
.xl-row--locked .xl-cell { color: rgb(170, 170, 170); }

.xl-cell {
    width: 200px;
    padding-left: 16px;
    font-size: 22px;
    border-right-width: 1px;
    border-right-color: rgb(226, 226, 226);
}

.xl-cell--wide { flex-grow: 1; }
.xl-cell--num { -unity-text-align: middle-right; padding-right: 16px; }
.xl-body { flex-grow: 1; }

/* ---------------------------------------------------------------- album */

.album { flex-grow: 1; }
.album__scroll { flex-grow: 1; }

.album__grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
}

/* Three across on a 1080-wide phone, at the art's own 2:3 — cropping a card to a square is what
   made the thumbnails look mismatched. */
.album__cell {
    width: 33%;
    padding: 6px;
}

.album__art {
    height: 470px;
    background-color: rgb(238, 238, 238);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    -unity-background-scale-mode: scale-and-crop;
}

.album__name {
    font-size: 20px;
    -unity-text-align: middle-center;
    padding-top: 6px;
}

.album__cell--locked .album__art { opacity: 0.18; }
.album__cell--locked .album__name { color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- full-size viewer */

.viewer {
    width: 96%;
    height: 94%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    align-items: center;
}

/* scale-to-fit, not scale-and-crop: the whole point of the viewer is that nothing is cut off. */
.viewer__art {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.viewer__caption { align-items: center; padding: 10px; }
.viewer__name { font-size: 34px; -unity-font-style: bold; color: rgb(33, 115, 70); }
.viewer__nick { font-size: 22px; color: rgb(107, 107, 107); }

.viewer__skins { flex-direction: row; justify-content: center; padding-bottom: 10px; }

.viewer__skin {
    height: 64px;
    min-width: 140px;
    margin: 0 6px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 4px;
    font-size: 22px;
}

.viewer__skin--active {
    background-color: rgb(226, 239, 218);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
}

.viewer__close { margin-bottom: 14px; min-width: 200px; }

.detail__skins { flex-direction: row; justify-content: center; padding: 8px; }

.detail__skin {
    height: 56px;
    min-width: 120px;
    margin: 0 5px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 4px;
    font-size: 20px;
}

/* ---------------------------------------------------------------- picker */

.picker {
    width: 86%;
    max-height: 80%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: 18px;
}

.picker__list { flex-grow: 1; }

.picker__row {
    flex-direction: row;
    align-items: center;
    min-height: 88px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.picker__face {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
}

.picker__name { font-size: 24px; }

/* ---------------------------------------------------------------- charts */

.charts { flex-grow: 1; }
.charts__scroll { flex-grow: 1; padding: 14px; }

/* A chart object dropped on a sheet: a plain white box with a border and a shadowless edge. */
.chart-obj {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: 14px;
    margin-bottom: 16px;
}

.chart-obj__title {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 10px;
}

.chart-row { flex-direction: row; align-items: center; height: 48px; }
.chart-row__label { width: 200px; font-size: 21px; }
.chart-row__track { flex-grow: 1; height: 26px; background-color: rgb(243, 243, 243); }
.chart-row__fill { height: 26px; background-color: rgb(33, 115, 70); }
.chart-row__value { width: 120px; -unity-text-align: middle-right; font-size: 21px; }

/* Excel's 작업 창: a panel docked over the sheet rather than a centred dialog. */
.task-pane {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 86%;
    background-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-left-color: rgb(191, 191, 191);
    padding: 16px;
}
