/* Excel Heroes — runtime styling for a portrait phone.

   The layout is Excel for Android, not desktop Excel scaled down. The phone app has no ribbon
   above the grid: a slim green app bar, then column letters, then the sheet, and every control
   along the bottom where a thumb reaches. Sizes are in the 1080x1920 reference the PanelSettings
   uses, so 40px here is roughly 15dp on a real 1080-wide phone — body text sits at 40-44px and
   anything tappable is at least 130px tall (~48dp). */

/* ---------------------------------------------------------------- shell */

/* ---------------------------------------------------------------- tokens

   Every colour, gap, radius and text size in this file comes from here.

   It did not before, and that was the problem: each screen was styled the day it was written, so
   the game had five button treatments, four card treatments and twenty-four distinct font sizes,
   none of which agreed. A player reads that as five different people having built five screens,
   which is exactly what happened.

   The scale is the 1080x2400 reference PanelSettings uses. On a 1080-wide phone at 3x density one
   dp is three of these units, so 42px is 14dp — the standard body size, and considerably larger
   than the 28px this build was using, which was 9dp and simply too small to read comfortably. */

.root {
    flex-grow: 1;
    background-color: var(--ex-surface);

    --ex-surface: rgb(238, 242, 246);
    --ex-surface-raised: rgba(255, 255, 255, 0.84);   /* frosted glass over the scene (Chrome.SetScene) */
    --ex-surface-sunken: rgb(222, 228, 234);

    --ex-ink: rgb(26, 46, 78);
    --ex-ink-muted: rgb(110, 132, 162);

    --ex-line: rgb(168, 202, 230);
    --ex-line-strong: rgb(130, 172, 208);

    --ex-navy: rgb(30, 46, 74);
    --ex-navy-deep: rgb(20, 32, 54);
    --ex-navy-line: rgb(58, 82, 122);

    --ex-accent: rgb(77, 166, 232);
    --ex-accent-deep: rgb(42, 118, 186);
    --ex-accent-ink: rgb(255, 255, 255);
    --ex-accent-wash: rgb(226, 240, 253);

    /* Buttons get their own fill, and it is deliberately NOT white.
       The reference never puts a white button on a white panel: every button there is filled and
       outlined, so it reads as a raised thing rather than as a rectangle someone drew a hairline
       around. This build did the opposite - .btn was --ex-surface-raised, the same colour as the
       sheet behind it, with only a 3px --ex-line between them. On the card sheet you saw the
       panel straight through the button. */
    --ex-btn: rgb(223, 233, 245);
    --ex-btn-line: rgb(165, 188, 214);
    --ex-btn-edge: rgb(134, 162, 194);
    --ex-btn-down: rgb(205, 220, 238);

    --ex-btn-off: rgb(211, 217, 226);
    --ex-btn-off-line: rgb(168, 178, 192);
    --ex-btn-off-ink: rgb(118, 129, 146);

    --ex-danger: rgb(226, 62, 74);
    --ex-gold: rgb(247, 181, 41);

    --ex-space-1: 8px;
    --ex-space-2: 16px;
    --ex-space-3: 24px;
    --ex-space-4: 32px;
    --ex-space-5: 48px;
    --ex-space-6: 64px;

    --ex-rad-sm: 8px;
    --ex-rad-md: 16px;
    --ex-rad-lg: 24px;

    --ex-tap: 120px;
    --ex-tap-lg: 136px;

    --ex-text-xs: 26px;
    --ex-text-sm: 32px;
    --ex-text-base: 38px;
    --ex-text-lg: 48px;
    --ex-text-xl: 64px;
}

/* ---------------------------------------------------------------- components

   One button, one card, one section header. Anything that wants to look like a button uses these;
   a screen does not get to invent its own. */

.ex-btn {
    height: var(--ex-tap);
    padding-left: var(--ex-space-4);
    padding-right: var(--ex-space-4);
    border-radius: var(--ex-rad-md);
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;

    /* Elevation is a thicker bottom border — USS has no shadow, and a flat fill on a flat sheet
       reads as a label rather than as something to press. */
    border-width: 2px;
    border-bottom-width: 8px;
}

.ex-btn--primary {
    background-color: var(--ex-accent);
    border-color: var(--ex-accent);
    border-bottom-color: var(--ex-accent-deep);
    color: var(--ex-accent-ink);
}

.ex-btn--secondary {
    background-color: var(--ex-surface);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    color: var(--ex-ink);
}

.ex-btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ex-ink-muted);
}

.ex-btn:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

.ex-card {
    background-color: var(--ex-surface);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
    padding: var(--ex-space-4);
}

.ex-section-head {
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 0;
    padding-bottom: var(--ex-space-2);
    margin-bottom: var(--ex-space-3);
    border-bottom-width: 2px;
    border-bottom-color: var(--ex-line);
}

.ex-section-head__name {
    font-size: var(--ex-text-lg);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-right: var(--ex-space-2);
}

.ex-section-head__note {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    flex-shrink: 1;
    white-space: normal;
}

.spacer { flex-grow: 1; }
/* ---------------------------------------------------------------- app bar */

/* Material Symbols, drawn as text. One variable font covers four thousand icons, scales without a
   second asset and takes its colour from `color` like any other label — so an icon that is white on
   the app bar and grey in the tab strip is one glyph rather than two PNGs. */
.icon {
    -unity-font-definition: url("project://database/Assets/ExcelHeroes/Fonts/MaterialSymbolsOutlined%20SDF.asset");
    -unity-text-align: middle-center;
    font-size: 46px;
}

/* The back arrow and the screen's name. A round dark button at the far left is how the reference
   marks "you are inside something" on 부대 편성 and 현상수배 alike.
   ---------------------------------------------------------------------------------- */
.navback { flex-direction: row; align-items: center; }

.navback__btn {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    background-color: rgb(40, 62, 108);
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    border-radius: 42px;
    color: rgb(255, 255, 255);
    font-size: 42px;
}

.navback__btn:hover { background-color: var(--ex-navy-line); }

/* flex-shrink: 0, because the title is the one thing on this bar that must not be squeezed.
   The audit caught "사내 메신저" given 80px of the 216 it needs — the currency chips grew and
   the only flexible thing in the row gave way. */
/* Dark ink with a yellow underline, as on 부대 편성 and 현상수배. */
.navback__title {
    flex-shrink: 0;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(22, 38, 63);
    margin-left: var(--ex-space-2);
    padding-bottom: 2px;
    border-bottom-width: 5px;
    border-bottom-color: rgb(255, 214, 58);
}

/* The player plate: a dark badge with the phase on a coloured tab, top left, where the reference
   puts the sensei's level. It is the one place on the chrome that says who is playing.
   ---------------------------------------------------------------------------------- */
.plate {
    flex-direction: row;
    align-items: center;
    height: 96px;
    padding-right: 60px;
    margin-left: -24px;
}

.plate__rank {
    align-items: center;
    justify-content: center;
    width: 110px;
    height: 100%;
}

.plate__rank-word { font-size: 24px; -unity-font-style: bold-and-italic; color: rgb(255, 214, 58); }
.plate__rank-num { font-size: 50px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); margin-top: -10px; }

.plate__body { justify-content: center; padding-left: var(--ex-space-2); }
.plate__name { font-size: 30px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.plate__sub { font-size: 22px; color: rgba(255, 255, 255, 0.6); }

/* The top bar: what you have, and nothing else. It used to be an Excel app bar with a file name
   and a row of document actions, none of which did anything. */
/* The frame is 120 / 820 / 140 and it adds to 1080 exactly. Every screen's content lives in
   the middle band with a 60px gutter, which is the width the card grids below are measured
   against: 2400 - 120 = 2280 of working room. */
.topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 120px;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
}

.topbar__title {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.72);
}

/* The sheet's small buttons are white discs with a navy glyph, on the bar rather than in it. */
/* Bare navy glyphs, as the reference sets its settings cog and home. */
.topbar__btn {
    width: 82px;
    height: 82px;
    flex-shrink: 0;
    margin-left: var(--ex-space-1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(34, 54, 96);
    font-size: 56px;
}

.topbar__btn:hover { color: rgb(20, 150, 210); }

.topbar .spacer { flex-grow: 1; flex-shrink: 1; min-width: 0; }

/* A currency reads as a coin and a number, not as a spreadsheet cell called 합계. */
/* The currency chips sit on a NAVY bar, so they are white plates rather than sunken wells, and
   flex-shrink: 0 stops them squeezing the screen title out of the row.

   This was written as a second `.chip { ... }` rule five lines ABOVE this one, which lost to
   this one on every repaint — a duplicate selector does not merge, the later copy wins per
   property, and "later" is measured in the file rather than in the order someone edited them. */
.chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 74px;
    margin-left: var(--ex-space-2);
    padding-left: 28px;
    padding-right: 10px;
}

.chip__icon { font-size: 40px; height: 64px; width: 64px; color: var(--ex-gold); margin-right: var(--ex-space-1); }
.chip__icon--gem { color: rgb(64, 156, 236); }
.chip__value {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-right: var(--ex-space-2);
}

/* ---------------------------------------------------------------- navigation rail

   Held sideways, the thumbs rest at the left and right edges and the bottom is the hardest place
   to reach — so navigation runs down the side, not along the bottom where a portrait phone puts
   it. Each tab is an icon over a word, which survives being glanced at. */





/* The active tab is lit and marked on the edge it is attached to. */





/* ---------------------------------------------------------------- navigation

   A row of icon-over-label buttons along the bottom, every screen on it, exactly as the reference
   arranges its lobby. What was here was four tabs down a rail with the other four behind a 더보기
   menu — and a screen behind a menu is a screen nobody opens. */

.navbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 140px;
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-3);
    background-color: rgba(255, 255, 255, 0.95);
    margin: 0 var(--ex-space-4) var(--ex-space-3) var(--ex-space-4);
    border-radius: 28px;
    border-width: 3px;
    border-color: rgb(186, 214, 240);
    border-bottom-width: 6px;
    border-bottom-color: rgb(160, 190, 220);
}

.navtab {
    width: 196px;
    height: 140px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--ex-rad-md);
    align-items: center;
    justify-content: center;
}

.navtab:hover { background-color: var(--ex-accent-wash); }

/* The lit tab, the way the reference lights one: a filled plate, not a hairline. */
.navtab--active {
    background-color: var(--ex-accent);
    border-bottom-width: 6px;
    border-bottom-color: var(--ex-accent-deep);
}

.navtab__icon { font-size: 54px; height: 76px; flex-shrink: 0; color: rgb(88, 106, 134); }
.navtab--active .navtab__icon { color: rgb(255, 255, 255); }

.navtab__label {
    font-size: var(--ex-text-xs);
    -unity-font-style: bold;
    color: rgb(88, 106, 134);
    margin-top: 2px;
}

.navtab--active .navtab__label { color: rgb(255, 255, 255); -unity-font-style: bold; }

.navtab__badge {
    position: absolute;
    top: 12px;
    right: 30px;
    min-width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: var(--ex-danger);
    color: rgb(255, 255, 255);
    font-size: var(--ex-text-xs);
    -unity-text-align: middle-center;
}

/* One loud button in the corner the thumb rests on, carrying the thing the game sells. */
.navcta {
    width: 300px;
    height: 132px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* The gold plate is painted by SkewPlate, like every other button. */

.navcta__icon { font-size: 52px; height: 74px; flex-shrink: 0; color: rgb(72, 44, 0); margin-right: var(--ex-space-1); }

.navcta__label {
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    color: rgb(72, 44, 0);
}

/* ---------------------------------------------------------------- content */

.sheet {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    /* Transparent: the backdrop is painted on the root (Chrome.DrawBackdrop), and every screen
       sits on it the way the reference's menus sit on its sky. */
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.screen-body { flex-grow: 1; min-height: 0; }

/* The illustrated scene behind every screen (Chrome.SetScene). Cover-fit, anchored low so the
   floor and furniture stay in view under the top bar. */
.shell-scene {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: bottom;
}
.shell-scene--page { -unity-background-scale-mode: scale-and-crop; background-position-y: bottom; }

/* A thin line along the bottom for whatever just happened — a reward collected, a run finished. */
/* The status line only exists when it has something to say.
   It used to hold a 44px band of --ex-surface-sunken under the tab bar at all times, so every
   screen ended in a stray blue-grey strip below the navigation with nothing in it. USS has no
   :empty selector, so AppRoot toggles `hidden` from SetStatus. */
.statusbar {
    flex-shrink: 0;
    height: 44px;
    padding-left: var(--ex-space-3);
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--ex-ink);
    background-color: var(--ex-accent-wash);
    border-top-width: 2px;
    border-top-color: var(--ex-btn-line);
    -unity-text-align: middle-left;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 18, 32, 0.72);
    align-items: center;
    justify-content: center;
}

/* ---------------------------------------------------------------- sheet furniture */

.sheet-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: var(--ex-space-3);
    padding-bottom: var(--ex-space-3);
    padding-left: var(--ex-space-4);
    padding-right: var(--ex-space-4);
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}

.sheet-head__stat { font-size: 36px; -unity-font-style: bold; margin-right: 28px; }
.sheet-head .muted { font-size: 28px; white-space: normal; }

/* ---------------------------------------------------------------- generic pieces */

/* The panel is the card. Same borders, same radius, same padding as .ex-card and .qs-block —
   before this there were four different panel treatments depending on which screen you were on. */
/* A panel is a WHITE card on the blue page, which is how every panel in the sheet reads. It
   was --ex-surface — the page colour — behind a hairline, so a panel and its background were the
   same thing with a line drawn between them. */
.panel {
    flex-shrink: 0;
    background-color: var(--ex-surface-raised);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.95);
    border-radius: var(--ex-rad-md);
    padding: var(--ex-space-4);
    margin-bottom: var(--ex-space-3);
    overflow: hidden;
}

/* A block's caption is a BAR, as it is in the asset sheet: navy, a gold stripe down the left,
   and the right end cut at an angle. It was 38px of grey text with nothing around it, which is
   a heading in a document rather than the header of a panel — the sheet's captions are what let
   the eye find where one block ends and the next begins.

   Left-aligned, because the caption starts where the content starts. The padding clears the gold
   stripe on one side and the slant on the other. */
.section-title {
    height: 66px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 28px;
    padding-right: 48px;
    margin-bottom: var(--ex-space-2);
    background-image: url("project://database/Assets/ExcelHeroes/Art/UI/panel_head.png");
    -unity-slice-left: 30;
    -unity-slice-right: 38;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* Inside a panel the bar spans the full width, so it is pulled out through the panel's padding.
   A caption inset from three edges reads as a label sitting on the panel rather than as its
   header. */
/* -32px written out, not calc(var(--ex-space-4) * -1). UI Toolkit's parser accepted that form
   and produced a property with NO values, and the style updater then threw
   ArgumentOutOfRangeException while walking the tree — which killed the whole screen, not the
   rule. A blank sheet with the previous screen's title still in the app bar was the symptom. */
.panel > .section-title {
    margin-left: -32px;
    margin-right: -32px;
    margin-top: -32px;
}

.muted { color: rgb(128, 128, 128); white-space: normal; }
.hidden { display: none; }

/* The game's button. It is .ex-btn with a different name — every call site already says
   `btn`, and renaming three hundred of them buys nothing that keeping the values in one place
   does not. Anything that wants to look like a button gets these values, not its own. */
/* The bevel is 5px, not 9px. A thick lip reads as a toy; the reference's buttons are nearly
   flat, with just enough of a darker bottom edge to sit above the panel. The radius drops from
   24px to 16px for the same reason - those are rounded rectangles, not pills. */
/* ===== Buttons =============================================================================
   The plate — the slanted parallelogram with its rim, gold notch and highlight — is PAINTED, by
   SkewPlate, from the element's own size. USS supplies only what text needs.

   It was a set of 9-sliced PNGs first. Two faults, both structural: everything decorative has to
   fit inside the fixed end caps or it stretches with the middle (a gold bar down the whole top
   edge, the first time), and a 9-slice stretches vertically too, so the same plate drawn at 98px
   and at 136px has two different slant angles. A mesh computes the slant from the height it is
   actually given.

   Padding is 44px rather than 32: the slant eats about a fifth of the height off each end, and a
   label needs to clear it. */
.btn {
    height: var(--ex-tap);
    padding-left: 44px;
    padding-right: 44px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ex-ink);
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

/* The label of a plated button. It is a child, not the button's own text, because the plate is
   painted after the element's content and would otherwise cover it. Everything it needs —
   size, colour, weight, alignment, white-space — is inherited. */
.plate__label {
    flex-shrink: 1;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    /* Upright bold, as the reference's own buttons are (확인, 모집, 레벨 업). The italic came from
       the generated asset sheet, which is not the game. */
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
}

/* Ink per plate. Dark navy on the light plates (cyan, white, glass, gold), white on the navy
   ones — measured off the sheet, where OK and REWARD INFO are both #16263f. */
.plate--primary, .plate--light, .plate--glass, .plate--gold { color: rgb(30, 46, 76); }
.plate--navy, .plate--glow { color: rgb(255, 255, 255); }
.plate--navy .plate__label, .plate--glow .plate__label {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(8, 16, 34, 0.6);
}

/* Only the text colour varies here — which plate is painted comes from the same class name, read
   by SkewPlate.KindFor. Two places reading one class is the price of a painted background; the
   alternative is five custom USS properties resolved per element per repaint. */
.btn:disabled { color: var(--ex-btn-off-ink); }

.btn--primary { color: rgb(12, 48, 78); }

.btn--primary:disabled { color: var(--ex-btn-off-ink); }

.btn--ghost { color: rgb(255, 255, 255); }

.btn--ghost:disabled { color: var(--ex-btn-off-ink); }

/* ---------------------------------------------------------------- home */

.home { flex-grow: 1; }

.home__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* stacked on the base art so a motion frame can cross-fade in */
.home__art-motion {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 0.9s;
}

.home__art-motion--on { opacity: 1; }

.home__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 992px;
    background-color: rgba(255, 255, 255, 0.62);
}

.home__strip {
    position: absolute;
    left: 32px;
    right: 32px;
    top: 26px;
    flex-direction: row;
    justify-content: space-between;
}

.home__stat {
    flex-grow: 1;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.72);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.6);
}

.home__stat-value { font-size: 48px; -unity-font-style: bold; color: rgb(176, 132, 10); }
.home__stat-key { font-size: 30px; color: rgb(107, 107, 107); }

.home__bubble {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 384px;
    padding: 32px;
    background-color: rgba(255, 255, 255, 0.82);
    border-radius: 29px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.7);
}

.home__who { font-size: 38px; color: rgb(33, 115, 70); -unity-font-style: bold; }

.home__speech {
    font-size: 43px;
    white-space: normal;
    margin-top: 13px;
    color: rgb(34, 34, 34);
}

.home__bond { margin-top: 26px; }
.home__bond-level { font-size: 32px; color: rgb(200, 60, 110); }

.home__bond-track {
    height: 16px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    overflow: hidden;
}

.home__bond-fill { height: 100%; background-color: rgb(200, 60, 110); }

.home__actions {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
    flex-direction: row;
}

.home__actions .btn { flex-grow: 1; margin-left: 8px; margin-right: 8px; }

/* ---------------------------------------------------------------- reveal */

.reveal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(228, 241, 253, 0.96);
    align-items: center;
    justify-content: center;
}

.reveal__card {
    width: 896px;
    height: 1248px;
    border-radius: 32px;
    border-width: 4px;
    overflow: hidden;
    align-items: center;
    justify-content: flex-end;
}

.reveal__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal__plate {
    width: 100%;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.86);
    align-items: center;
}

.reveal__grade { flex-shrink: 0; font-size: 46px; -unity-text-align: middle-left; }

.reveal__name {
    font-size: 54px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.reveal__nick { font-size: 35px; color: rgb(107, 107, 107); }

.reveal__line {
    font-size: 35px;
    color: rgb(70, 70, 70);
    margin-top: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.reveal__badge {
    margin-top: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 22px;
    font-size: 32px;
    background-color: rgb(150, 112, 8);
    color: rgb(253, 246, 227);
}

.reveal__hint {
    margin-top: 45px;
    font-size: 38px;
    color: rgb(107, 107, 107);
}

/* --- the tell -------------------------------------------------------------
   A column of light rises before the card resolves, in the rarity's colour.
   This is where the tension of a pull actually lives: by the time the art is
   on screen the player already knows, and the card is the confirmation. */

.tell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.tell__beam {
    width: 144px;
    height: 0;
    opacity: 0;
    transition-duration: 0.45s;
}

.tell__beam--up { height: 1760px; opacity: 0.9; }

.tell__ring {
    position: absolute;
    width: 256px;
    height: 256px;
    border-radius: 128px;
    border-width: 4px;
    opacity: 0;
    scale: 0.3 0.3;
    transition-duration: 0.5s;
}

.tell__ring--out { opacity: 0; scale: 3.4 3.4; }
.tell__ring--in { opacity: 0.95; scale: 1 1; }

.tell__label {
    position: absolute;
    bottom: 480px;
    font-size: 54px;
    -unity-font-style: bold;
    opacity: 0;
    transition-duration: 0.3s;
}

.tell__label--on { opacity: 1; }

/* the card landing */
.reveal__card {
    transition-duration: 0.28s;
}

/* ten-pull summary grid */

.reveal-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    width: 86%;
    height: 72%;
}

/* Painted as a whole (GachaScreen.BuildSummary): only size, and the labels on top. */
.reveal-grid__cell {
    width: 16.5%;
    height: 44%;
    margin: 1% 1.2%;
    justify-content: flex-end;
    align-items: center;
}

.reveal-grid__name {
    position: absolute;
    bottom: -40px;
    left: 0;
    right: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(30, 44, 70);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.reveal-grid__grade { font-size: 32px; -unity-font-style: bold; }

/* ---------------------------------------------------------------- roster */

/* The 60px gutter from the layout spec, which is what makes the working width 2280. */
.roster-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    padding-left: 60px;
    padding-right: 60px;
}

/* 390 x 290, five across and two down inside the 2280px working width: 1950 of card and 330
   of gap. Fixed pixels rather than percentages because PanelSettings maps this panel to a
   2400x1080 reference, so a pixel here IS a design pixel — and because a percentage margin
   resolves against the parent's WIDTH even when it is applied vertically, which is what pushed
   the second row into the pager the last time this grid was measured in percent. */
/* 390 x 280 with a 10px margin, five across and two down.
   The height is 280 and not the spec's 290 because of what the band actually leaves. Content is
   820: two filter rows take 120 and the pager is pinned at 70, so the grid gets 612 — and two
   rows of 290 plus their margins come to 620. Eight pixels of the bottom row were drawn OVER the
   pager, which LayoutAudit called a clean run because overlap is not overflow: both elements
   were inside their containers and inside the screen, one was simply on top of the other. */
/* card: reference sheet panel 6 */
.card {
    width: 390px;
    height: 280px;
    margin: 10px;
    background-color: rgb(206, 222, 238);
    border-width: 0;
    border-radius: 16px;
    overflow: hidden;
}

/* Portrait proportions, cropped from the TOP — the face identifies the card, and a centred crop
   on a 2:3 illustration lands on the chest. */
.card__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(226, 236, 246);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top 8%;
}

/* Painted over everything else — see UiKit.Card. */
.card__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.card__grade {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 66px;
    height: 42px;
    align-items: center;
    justify-content: center;
}

.card__grade-label {
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold-and-italic;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 20, 40, 0.5);
}

.card__role {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
}

.card__role-glyph {
    font-size: 32px;
    color: rgb(255, 255, 255);
}

.card__stars {
    position: absolute;
    right: 14px;
    bottom: 90px;
    font-size: 32px;
    letter-spacing: -4px;
    color: rgb(255, 208, 40);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(120, 76, 0);
}

.card__keep {
    position: absolute;
    right: 12px;
    top: 72px;
    padding: 2px 10px;
    border-radius: 10px;
    background-color: rgba(228, 158, 42, 0.95);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 20px;
}

/* The navy band across the foot, as on the sheet's roster tiles. */
.card__plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 86px;
    padding: 4px 16px 6px 16px;
    justify-content: center;
    background-color: rgba(28, 44, 80, 0.94);
    border-top-width: 2px;
    border-top-color: rgba(120, 200, 245, 0.55);
}

/* Neither line may shrink: a shrunk line with an overflow:hidden label inside is a line whose
   text is clipped to nothing — the name vanished that way while the level beside it, which has
   no overflow set, went on drawing. */
.card__line {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.card__name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 27px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card__level {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 26px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 255, 255);
}

.card__sub { flex-shrink: 0; font-size: 20px; color: rgba(200, 220, 240, 0.75); }

.card--locked { background-color: rgb(38, 50, 72); }

/* Over the art, under the badges — it is added before them, and UI Toolkit has no z-index, so
   build order is what decides. Deep navy rather than black: the reference's locked entries are
   cold, not grimy. */
.card__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(16, 26, 46, 0.58);
}
.card--locked .card__name { color: rgb(196, 207, 222); }

/* A modal, not a second full screen. Tapping a card is a look at one card — taking over the whole
   display for it loses where you were in a list of fifty-five, and on the way back the scroll
   position went with it. The dim behind it is the overlay's own.

   Held sideways it is two columns: the illustration is a tall 2:3 and the stats are a list, so
   stacking them meant a modal three times the height of the screen. Side by side, each gets the
   axis it actually wants. */
.detail {
    flex-direction: row;
    width: 88%;
    max-width: 1700px;
    height: 88%;
    padding: 3px;
    /* NOT overflow:hidden. The frame is painted by the element itself (ModalFrame.Frame), with
       its glow and corner brackets OUTSIDE the box, and an element's own mesh is clipped by its
       own overflow. The illustration rounds its own corners instead. */
}

/* The left column: the whole illustration, fitted inside it rather than sized from the modal's
   width, so nothing is cropped and nothing overflows. */
.detail__art {
    width: 38%;
    flex-shrink: 0;
    background-color: rgb(226, 236, 246);
    -unity-background-scale-mode: scale-to-fit;
    /* Rounds itself to the frame, now that the frame no longer clips its children. */
    border-top-left-radius: 13px;
    border-bottom-left-radius: 13px;
    overflow: hidden;
}

.detail__scrim { display: none; }

.detail__right {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.detail__head {
    flex-shrink: 0;
    padding: var(--ex-space-2) var(--ex-space-3) var(--ex-space-2) var(--ex-space-3);
    background-color: var(--ex-navy);
    border-bottom-width: 5px;
    border-bottom-color: var(--ex-gold);
}

.detail__name { font-size: var(--ex-text-lg); -unity-font-style: bold; }
.detail__nick { font-size: var(--ex-text-xs); color: rgba(255, 255, 255, 0.66); }

/* flex-shrink is what makes this scroll. With only flex-grow the body kept its content height
   inside a modal capped at 88%, so anything past the fold simply could not be reached. */
/* Declared twice, and the late one-liner silently won — the space-4 padding here had not
   applied for as long as both existed. One rule now. */
.detail__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    padding: var(--ex-space-2);
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    height: 74px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ex-line);
}

.stat-row__key { color: var(--ex-ink-muted); font-size: var(--ex-text-sm); }
.stat-row__value { font-size: var(--ex-text-sm); -unity-font-style: bold; color: var(--ex-ink); }

/* A navy ✕ on the frame, as on the reference's modal — not a second round button. */
.detail__close {
    position: absolute;
    right: 18px;
    top: 14px;
    width: 84px;
    height: 84px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(22, 38, 63);
    font-size: 60px;
}

/* ---------------------------------------------------------------- party */

.party-slots {
    flex-direction: row;
    justify-content: center;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.slot {
    flex-grow: 1;
    flex-basis: 0;
    width: auto;
    height: auto;
    margin: 6px;
}

.slot--empty {
    background-color: var(--ex-surface-sunken);
    border-width: 4px;
    border-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
    align-items: center;
    justify-content: center;
}

.slot__plus { font-size: 70px; color: rgb(160, 160, 160); }

.synergy-line {
    font-size: 35px;
    color: rgb(24, 92, 55);
    margin-bottom: 6px;
}

.power-readout {
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 0;
    margin-bottom: var(--ex-space-2);
    padding-left: var(--ex-space-2);
}

.power-readout__value {
    font-size: 58px;
    -unity-font-style: bold;
    color: var(--ex-gold);
}

.power-readout__label {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    margin-left: var(--ex-space-2);
}

/* ---------------------------------------------------------------- battle */

.battle {
    flex-grow: 1;
}

/* The battlefield is the worksheet. A painted landscape was both off-premise and unreadable behind
   16x28 pixel sprites; a tiled cell grid gives them a surface to stand on and survives the disguise,
   because what a passer-by sees is cells. */
/* The battlefield keeps the web build's 2:1 shape — a side-view street band across the top of
   the sheet, with the party's EX buttons below it. The backdrop texture is set from code because
   it is generated per phase. */
/* The field takes most of the sheet and the log takes the rest — between them there is no dead
   space. With the EX card row and the cost bar gone this screen had a fifth of its height doing
   nothing, which on the sheet the player looks at most is the worst place to leave it. */
/* The field takes the sheet. Its contents are placed from code against a scale taken from this
   box's width, so the street always spans it and the sky is cropped rather than stretched. */
.battle__stage {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgb(30, 34, 44);
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.fighter {
    position: absolute;
    width: 190px;
    align-items: center;
}

/* Pixel sprites want whole-number scale and no crop. 16x28 at 6x is 96x168, which reads clearly at
   arm's length on a phone and still lines the cast up on one baseline. */
.fighter__body {
    width: 104px;
    height: 184px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.fighter__body--chibi {
    width: 104px;
    height: 140px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Monsters face the party: the tileset draws everything facing right. */
.fighter--monster .fighter__body { scale: -1 1; }

/* Integer multiples only, and the web build's ratio: wave enemies 2x, bosses 3x. */
.fighter--boss { width: 440px; }
.fighter--boss .fighter__body { width: 156px; height: 276px; }
.fighter--boss .fighter__hpbar { width: 150px; height: 12px; border-radius: 6px; }
.fighter--elite .fighter__body { width: 124px; height: 220px; }

.fighter__hpbar {
    width: 64px;
    height: 8px;
    margin-top: 2px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 4px;
    overflow: hidden;
}

.fighter__hpfill {
    height: 100%;
    background-color: rgb(33, 115, 70);
}

.fighter__name { display: none; }

/* Damage numbers. White on the dark field rather than the old mustard, which was invisible over
   the road, and with a dark outline so they stay readable over a lit window or a sprite. */
.floater {
    position: absolute;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 12, 18, 0.9);
}

.floater--heal { color: rgb(24, 92, 55); }
.floater--skill { color: rgb(31, 111, 235); font-size: 38px; }

.battle__hud {
    position: absolute;
    right: var(--ex-space-2);
    top: var(--ex-space-2);
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-1);
    background-color: rgba(12, 18, 32, 0.72);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 40px;
}

.battle__wave {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-right: var(--ex-space-2);
    transition-duration: 0.3s;
}

/* 야근: overtime has started and the errors are hitting harder every second */
.battle__wave--enraged { color: rgb(255, 120, 104); }

.ex-bar {
    flex-direction: row;
    height: 256px;
    align-items: center;
    justify-content: center;
    background-color: rgb(250, 250, 250);
    padding-top: 16px;
    padding-bottom: 16px;
}

.ex-cost-bar {
    height: 32px;
    background-color: rgb(220, 224, 230);
    width: 100%;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.ex-cost-fill {
    height: 100%;
    background-color: rgb(31, 111, 235);
    width: 0%;
    transition-duration: 0.1s;
}

.ex-cost-text {
    position: absolute;
    left: 32px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(34, 34, 34);
}

.ex-button {
    width: 211px;
    height: 211px;
    margin-left: 11px;
    margin-right: 11px;
    border-radius: 29px;
    border-width: 3px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(243, 243, 243);
    overflow: hidden;
    justify-content: flex-end;
    align-items: center;
    transition-duration: 0.15s;
}

.ex-button--ready {
    border-color: rgb(176, 132, 10);
    scale: 1.05 1.05;
}

.ex-button--spent { opacity: 0.45; }

.ex-button__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.ex-button__charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(240, 196, 70, 0.28);
}

.ex-button__label {
    width: 100%;
    font-size: 27px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.85);
    padding-top: 5px;
    padding-bottom: 5px;
}

.result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.92);
    align-items: center;
    justify-content: center;
}

.result__title {
    font-size: 115px;
    -unity-font-style: bold;
    margin-bottom: 26px;
}

.result__title--win { color: rgb(176, 132, 10); }
.result__title--lose { color: rgb(196, 43, 28); }

/* ---------------------------------------------------------------- daily */

.stamp__row { flex-direction: row; margin-top: 13px; margin-bottom: 13px; }

.stamp__dot {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    margin-right: 13px;
    background-color: rgb(238, 238, 238);
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    transition-duration: 0.2s;
}

.stamp__dot--on {
    background-color: rgb(33, 115, 70);
    border-color: rgb(196, 152, 20);
}

.quest--done { opacity: 0.5; }

.quest__track {
    height: 19px;
    margin-top: 16px;
    background-color: rgb(238, 238, 238);
    border-radius: 10px;
    overflow: hidden;
}

.quest__fill { height: 100%; background-color: rgb(31, 111, 235); }

.quest__meta { font-size: 34px; color: rgb(107, 107, 107); margin-top: 13px; }

/* a count of claimable rewards, parked on the nav button */
.nav-badge {
    position: absolute;
    right: 29px;
    top: 22px;
    min-width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgb(196, 43, 28);
    color: rgb(120, 40, 70);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 13px;
    padding-right: 13px;
}

/* ---------------------------------------------------------------- onboarding */

.onboard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 45px;
    padding-right: 45px;
}

.onboard__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(243, 243, 243);
}

.onboard__card {
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 32px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.8);
    padding: 48px;
}

.onboard__title {
    font-size: 70px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    margin-bottom: 29px;
}

.onboard__line {
    font-size: 43px;
    white-space: normal;
    margin-bottom: 13px;
    color: rgb(34, 34, 34);
}

.onboard__tip {
    margin-top: 35px;
    margin-bottom: 35px;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 22px;
    border-left-width: 4px;
    border-left-color: rgb(31, 111, 235);
}

.onboard__tip-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
    margin-bottom: 6px;
}

.onboard__card .btn { margin-top: 16px; }

/* ---------------------------------------------------------------- EX cut-in */

/* The signature moment: firing a skill throws the character's own illustration across the
   screen shouting their line. It is the one time the art is at full size during play, and
   it is what makes a skill feel like a person acting rather than a number resolving. */

/* `clips` tells LayoutAudit that children overrunning this box are deliberate. */
/* The EX cut-in: a band across the bottom of the battlefield, not a takeover of it.

   It used to cover the whole field, so firing a skill hid the fight the skill was part of — the
   party, the monsters and the effects all disappeared for a second and a quarter behind a portrait.
   Blue Archive puts its EX portrait in the lower corner for exactly this reason: the moment is
   worth announcing, but not worth blinding the player through.

   `clips` tells LayoutAudit that children overrunning this box are deliberate. */
.cutin {
    position: absolute;
    left: 0;
    right: 0;
    top: 108px;
    height: 46%;
    justify-content: center;
    overflow: hidden;
}

.cutin__sweep {
    position: absolute;
    left: -120%;
    right: 120%;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 20, 28, 0.62);
    border-top-width: 3px;
    border-top-color: rgba(240, 196, 70, 0.9);
    border-bottom-width: 3px;
    border-bottom-color: rgba(240, 196, 70, 0.9);
    transition-duration: 0.28s;
}

.cutin__sweep--in { left: -10%; right: -10%; }

/* A bust crop anchored to the left of the band, sliding in from off-screen. */
.cutin__art {
    position: absolute;
    left: -30%;
    bottom: 0;
    width: 26%;
    height: 150%;
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__art--in { left: 1%; opacity: 1; }

.cutin__plate {
    position: absolute;
    left: 30%;
    align-items: flex-start;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__plate--in { opacity: 1; }

.cutin__skill {
    font-size: 74px;
    -unity-font-style: bold;
    color: rgb(250, 210, 90);
}

.cutin__line {
    font-size: 38px;
    color: rgba(255, 255, 255, 0.86);
    max-width: 1100px;
    white-space: normal;
}

/* --- hit feedback ------------------------------------------------------- */

.fighter__body { transition-duration: 0.09s; }

/* a lunge towards the enemy on the swing, so an attack has a body behind it */
.fighter--hero .fighter__body--swing { translate: 22px 0; }
.fighter--monster .fighter__body--swing { translate: -22px 0; }

.fighter__body--hurt { scale: 1.18 1.18; }

.fighter--dead {
    opacity: 0.25;
    transition-duration: 0.35s;
    scale: 0.82 0.82;
}

/* ---------------------------------------------------------------- story */

/* episode list */

.ep--locked { opacity: 0.45; }

.ep__cast {
    flex-direction: row;
    flex-shrink: 0;
    height: 74px;
    overflow: hidden;
}

.ep__face {
    width: 74px;
    height: 74px;
    flex-shrink: 0;
    border-radius: 37px;
    margin-right: -10px;
    border-width: 2px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
}

/* the log itself */

.chat__header {
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.chat__title { font-size: 54px; -unity-font-style: bold; }

.chat-room {
    font-size: 35px;
    color: rgb(31, 111, 235);
    margin-top: 6px;
}

.chat-line {
    flex-direction: row;
    margin-bottom: 26px;
    align-items: flex-start;
}

.chat-line--mine { justify-content: flex-end; }

.chat-line--sys {
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 29px;
}

.chat-avatar {
    width: 122px;
    height: 122px;
    border-radius: 61px;
    margin-right: 19px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(243, 243, 243);
    -unity-background-scale-mode: scale-and-crop;
}

/* a repeated speaker keeps the indent but drops the face */
.chat-avatar--blank {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.chat-column { flex-shrink: 1; }

.chat-who {
    font-size: 32px;
    color: rgb(107, 107, 107);
    margin-bottom: 8px;
}

.chat-bubble {
    max-width: 1056px;
    padding: 24px 32px;
    border-radius: 24px;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(220, 224, 230);
    color: rgb(26, 46, 78);
    font-size: 38px;
    white-space: normal;
}

.chat-line--mine .chat-bubble {
    background-color: rgb(31, 111, 235);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.chat-line--sys .chat-bubble {
    background-color: rgb(222, 228, 234);
    border-width: 0;
    color: rgb(88, 106, 134);
    font-size: 34px;
    -unity-text-align: middle-center;
    border-radius: 12px;
}

/* ---------------------------------------------------------------- sheet furniture */

/* Every sheet opens with a summary strip, the way a real one opens with a header row. */


.xl-row--head {
    background-color: rgb(243, 243, 243);
    border-bottom-color: rgb(191, 191, 191);
}

.xl-row--head .xl-cell { -unity-font-style: bold; color: rgb(70, 70, 70); }
.xl-row--boss .xl-cell { color: rgb(150, 112, 8); -unity-font-style: bold; }
.xl-row--locked .xl-cell { color: rgb(170, 170, 170); }

.xl-cell {
    flex-shrink: 1;
    width: 230px;
    padding-left: 26px;
    font-size: 35px;
    border-right-width: 1px;
    border-right-color: rgb(226, 226, 226);
}

.xl-cell--wide { flex-grow: 1; flex-basis: 0; min-width: 0; }
.xl-cell--num { -unity-text-align: middle-right; padding-right: 26px; }
.xl-body { flex-grow: 1; }

/* ---------------------------------------------------------------- 오류 도감
   A gallery rather than a table. Two rows of five, each card carrying the sprite you actually
   meet — which is what the reference does with everything it asks you to collect. */
.codex-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.mcard {
    width: 18.4%;
    height: 250px;
    margin: 8px;
    padding: var(--ex-space-1);
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background-color: var(--ex-surface-raised);
    border-width: 2px;
    border-color: var(--ex-line);
    border-radius: var(--ex-rad-md);
}

.mcard__art {
    width: 100%;
    height: 150px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.mcard__name {
    flex-shrink: 0;
    height: 42px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mcard__meta {
    flex-shrink: 0;
    height: 40px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: var(--ex-ink-muted);
}

.mcard__unknown { font-size: 64px; -unity-font-style: bold; color: rgb(198, 202, 210); }

/* Same reasoning as .card--locked: dark, not washed out. */
.mcard--locked { background-color: rgb(38, 50, 72); }
.mcard--locked .mcard__name { color: rgb(166, 170, 178); }

/* A boss is the one entry in its phase you had to beat, so it gets the border that says so. */
.mcard--boss { border-color: var(--ex-gold); }

/* ---------------------------------------------------------------- 스킨
   One row per look. The left border carries the skin's own frame colour, which is the web build's
   way of telling 퇴근 사복 from 회사 정장 at a glance. */
.skin-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 104px;
    margin-bottom: var(--ex-space-1);
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
    background-color: var(--ex-surface-raised);
    border-left-width: 6px;
    border-left-color: var(--ex-line);
    border-radius: var(--ex-rad-md);
}

.skin-row--on { background-color: var(--ex-accent-wash); }
.skin-row--locked { background-color: var(--ex-surface-sunken); }

.skin-row__text { flex-grow: 1; flex-shrink: 1; }
.skin-row__name { font-size: 28px; -unity-font-style: bold; color: var(--ex-ink); }
.skin-row__desc { font-size: 21px; color: var(--ex-ink-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.skin-row__on {
    flex-shrink: 0;
    min-width: 150px;
    height: 62px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-accent-deep);
}

/* The 강화 panel's buttons. These were --ex-surface on a white sheet behind a 2px --ex-line,
   so a row of four of them read as faint smudges rather than as the only things on the panel a
   player can press. Same fill and outline as every other button now, just smaller. */
.skin-row__btn {
    flex-shrink: 0;
    min-width: 200px;
    height: 62px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-ink);
    background-color: var(--ex-btn);
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ex-btn-line);
    border-bottom-color: var(--ex-btn-edge);
    border-radius: var(--ex-rad-sm);
}

.skin-row__btn:hover { background-color: var(--ex-btn-down); }

/* Two buttons on one row need the first of them to stop claiming 200px. */
.skin-row__btn--narrow { min-width: 90px; margin-right: var(--ex-space-1); }

.skin-row__btn--buy {
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-color: rgb(126, 190, 240);
    border-bottom-color: var(--ex-accent-deep);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- 승진
   One row per next job, and one line per condition. Both are lists of "here is what you need and
   here is where you are", which is the only useful shape for a gate. */
.promo-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 86px;
    margin-bottom: 6px;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
    background-color: var(--ex-surface-raised);
    border-left-width: 6px;
    border-left-color: var(--ex-accent);
    border-radius: var(--ex-rad-md);
}

.promo-row__text { flex-grow: 1; flex-shrink: 1; }
.promo-row__name { font-size: 28px; -unity-font-style: bold; color: var(--ex-ink); }
.promo-row__desc { font-size: 21px; color: var(--ex-ink-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.promo-row__btn {
    flex-shrink: 0;
    min-width: 200px;
    height: 62px;
    font-size: 24px;
    -unity-text-align: middle-center;
    color: var(--ex-ink);
    background-color: var(--ex-surface);
    border-width: 2px;
    border-color: var(--ex-line);
    border-radius: var(--ex-rad-md);
}

.promo-row__btn--go {
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-color: var(--ex-accent);
    -unity-font-style: bold;
}

.promo-row__btn:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

.promo-cond { flex-direction: row; align-items: center; flex-shrink: 0; height: 50px; }
.promo-cond__mark { width: 40px; font-size: 26px; -unity-text-align: middle-center; color: rgb(170, 176, 186); }
.promo-cond__what { flex-grow: 1; font-size: 24px; color: var(--ex-ink-muted); }
.promo-cond__num { flex-shrink: 0; font-size: 24px; color: var(--ex-ink-muted); }

.promo-cond--met .promo-cond__mark { color: rgb(33, 150, 96); }
.promo-cond--met .promo-cond__what,
.promo-cond--met .promo-cond__num { color: var(--ex-ink); -unity-font-style: bold; }

.skin-row__btn:disabled {
    background-color: var(--ex-btn-off);
    border-color: var(--ex-btn-off-line);
    border-bottom-color: var(--ex-btn-off-line);
    color: var(--ex-btn-off-ink);
}

/* ---------------------------------------------------------------- album */

.album { flex-grow: 1; }
.album__scroll { flex-grow: 1; }

.album__grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
}

/* Three across on a 1080-wide phone, at the art's own 2:3 — cropping a card to a square is what
   made the thumbnails look mismatched. */
.album__cell {
    width: 15.6%;
    height: 48%;
    margin: 0.4%;
}

.album__art {
    flex-grow: 1;
    background-color: rgb(238, 238, 238);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    -unity-background-scale-mode: scale-and-crop;
}

.album__name {
    font-size: var(--ex-text-xs);
    height: 48px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.album__cell--locked .album__art { opacity: 0.18; }
.album__cell--locked .album__name { color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- full-size viewer */

.viewer {
    width: 96%;
    height: 94%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    align-items: center;
}

/* scale-to-fit, not scale-and-crop: the whole point of the viewer is that nothing is cut off. */
.viewer__art {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.viewer__caption { align-items: center; padding: 16px; }
.viewer__name { font-size: 54px; -unity-font-style: bold; color: rgb(33, 115, 70); }
.viewer__nick { font-size: 35px; color: rgb(107, 107, 107); }

.viewer__skins { flex-direction: row; justify-content: center; padding-bottom: 16px; }

.viewer__skin {
    height: 102px;
    min-width: 224px;
    margin: 0 10px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 35px;
}

.viewer__skin--active {
    background-color: rgb(226, 239, 218);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
}

.viewer__close { margin-bottom: 22px; min-width: 320px; }

.detail__skins { flex-direction: row; justify-content: center; padding: 13px; }

.detail__skin {
    height: 90px;
    min-width: 192px;
    margin: 0 8px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 32px;
}

/* ---------------------------------------------------------------- picker */

.picker {
    width: 72%;
    max-height: 84%;
    background-color: var(--ex-surface-raised);
    border-width: 3px;
    border-color: var(--ex-navy-line);
    border-radius: var(--ex-rad-lg);
    padding: var(--ex-space-3);
}

.picker__list { flex-grow: 1; }

.picker__row {
    flex-direction: row;
    align-items: center;
    min-height: 141px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.picker__face {
    width: 102px;
    height: 102px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
}

.picker__name { font-size: 38px; }

/* ---------------------------------------------------------------- charts */

.charts { flex-grow: 1; }
.charts__scroll { flex-grow: 1; padding: 22px; }

/* A chart object dropped on a sheet: a plain white box with a border and a shadowless edge. */
.chart-obj {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: var(--ex-space-2);
    margin-left: 6px;
    margin-right: 6px;
}

.chart-obj__title {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 16px;
}

.chart-row { flex-direction: row; align-items: center; height: 77px; }
.chart-row__label { width: 320px; font-size: 34px; }
.chart-row__track { flex-grow: 1; height: 42px; background-color: rgb(243, 243, 243); }
.chart-row__fill { height: 42px; background-color: rgb(33, 115, 70); }
.chart-row__value { width: 192px; -unity-text-align: middle-right; font-size: 34px; }

/* Excel's 작업 창: a panel docked over the sheet rather than a centred dialog. */
.task-pane {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 76%;
    background-color: var(--ex-surface-raised);
    border-left-width: 3px;
    border-left-color: var(--ex-navy-line);
    padding: var(--ex-space-3);
}

/* ---------------------------------------------------------------- cost pool */

.cost-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.cost-row__value {
    width: 70px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
}

.cost-row__track { flex-direction: row; flex-grow: 1; }

.cost-cell {
    flex-grow: 1;
    height: 24px;
    margin-right: 4px;
    background-color: rgb(226, 226, 226);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
}

.cost-cell--full { background-color: rgb(31, 111, 235); }
.cost-cell--part { background-color: rgb(150, 190, 245); }

.ex-button__cost {
    position: absolute;
    top: 6px;
    left: 8px;
    min-width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(31, 111, 235);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* charged, but the budget is not there yet */
.ex-button--poor { opacity: 0.55; }
.ex-button--poor .ex-button__cost { background-color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- icons */

/* Drawn, not typed. Unity's default font has no glyph for a search loupe or a window, so those
   characters rendered as missing-glyph boxes — the boss key looked like it was simply absent. */
.icon { -unity-background-scale-mode: scale-to-fit; }


/* The corner cell's select-all mark, drawn with a border rather than a glyph. */

/* ---------------------------------------------------------------- 위장 모드 시트 */

.xl-row--total { border-top-width: 2px; border-top-color: rgb(70, 70, 70); }
.xl-row--total .xl-cell { -unity-font-style: bold; }
.xl-cell--up { color: rgb(24, 92, 55); }
.xl-cell--down { color: rgb(196, 43, 28); }

/* The monster strips come out of the tileset already facing the party, so the blanket mirror that
   the hero-facing sprites need would turn them back around.

   They are also a different kind of frame: the web build composes each monster into a 64x64 box
   with the creature already scaled and standing on the bottom edge, whereas the hero strips are the
   raw 16x28 cells. Sizing both boxes the same made every monster look like a doll next to the
   party. 64 canvas pixels is 84 at this field's scale. */
.fighter--monster { width: 116px; }

.fighter--monster .fighter__body--creature {
    scale: 1 1;
    width: 110px;
    height: 110px;
}

.fighter--boss .fighter__body--creature { width: 216px; height: 196px; }
.fighter--boss.fighter--monster { width: 224px; }

/* Pixel HP bars: hard edges, a one-pixel dark border and no rounding, so they sit on the same grid
   as the sprites instead of looking like a web widget dropped onto a tileset. */
.fighter__hpbar {
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(27, 29, 37);
    background-color: rgb(58, 62, 74);
    overflow: hidden;
}

.fighter__hpfill { border-radius: 0; }
.fighter--hero .fighter__hpfill { background-color: rgb(74, 200, 108); }
.fighter--monster .fighter__hpfill { background-color: rgb(214, 62, 52); }

/* ---------------------------------------------------------------- shots */

/* Office supplies in flight. Small and hard-edged so they belong to the pixel layer rather than
   looking like UI drawn over it. */
.shot {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(27, 29, 37);
}

.shot--drop { background-color: rgb(214, 62, 52); border-radius: 7px; }
.shot--slash { width: 22px; height: 6px; background-color: rgb(255, 240, 200); }

/* ---------------------------------------------------------------- 프롤로그 */

/* Letterboxed, not full bleed: the illustration sits in a band with black above and below, which
   is how the web build frames it. Filling a 9:16 phone with a 16:9 picture means cropping most of
   it away, and the crop always takes the part with the character in it. */
.prologue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 9, 13);
    justify-content: center;
    padding-bottom: 180px;
}

/* The letterbox. Its height is set from the picture's aspect ratio in PrologueScreen, so the
   left and right edges of the illustration always reach the screen and the spare space ends up
   above and below it instead of being cropped off the sides. */
.prologue {
    align-items: center;
}

.prologue__stage {
    width: 100%;
    background-color: rgb(0, 0, 0);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.prologue__art {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.prologue__head {
    margin-left: 48px;
    margin-top: 56px;
    flex-direction: row;
    align-items: center;
}

.prologue__counter {
    width: 54px;
    height: 54px;
    -unity-text-align: middle-center;
    font-size: 28px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 27px;
    margin-right: 16px;
}

/* flex-shrink:0 because the letterbox squeezes its column, and a shrunk line box clips Korean
   descenders rather than wrapping. */
.prologue__title {
    font-size: 40px;
    height: 62px;
    flex-shrink: 0;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.prologue__body {
    margin-left: 48px;
    margin-right: 48px;
    margin-top: 32px;
    font-size: 40px;
    color: rgb(240, 242, 248);
    white-space: normal;
}

.prologue__foot {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 56px;
    flex-direction: row;
    align-items: center;
}

.prologue__skip {
    height: 88px;
    min-width: 180px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    border-radius: 8px;
    color: rgb(215, 220, 232);
    font-size: 32px;
}

.prologue__dots { flex-grow: 1; flex-direction: row; justify-content: center; }

.prologue__dot {
    width: 18px;
    height: 18px;
    margin-left: 7px;
    margin-right: 7px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.25);
}

.prologue__dot--on { background-color: rgb(33, 115, 70); }

.prologue__nav {
    height: 88px;
    min-width: 168px;
    margin-left: 14px;
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 0;
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 32px;
}

.prologue__nav:disabled { opacity: 0.35; }
.prologue__nav--primary { background-color: rgb(33, 115, 70); }

/* ---------------------------------------------------------------- battle log */

/* Rows in the sheet under the field, numbered like cells. In 위장 모드 the same rows carry
   recalculation progress, which is the whole reason the log is here and not in a floating panel. */
/* The run's own record, in the sheet's rows. It is also what carries the disguise: in 위장 모드
   these same lines become recalculation progress. */
.battle-log {
    position: absolute;
    left: var(--ex-space-3);
    top: var(--ex-space-2);
    width: 36%;
    height: 132px;
}

.log-row {
    margin-top: 3px;
}

.log-row__n {
    width: 74px;
    -unity-text-align: middle-center;
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    border-right-width: 1px;
    border-right-color: var(--ex-line);
}

.log-row__text {
    font-size: var(--ex-text-xs);
    color: rgba(255, 255, 255, 0.62);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------------------------------------------------------------- 필터 바 */

.filter-bar {
    flex-shrink: 0;
    padding: var(--ex-space-2) var(--ex-space-3) var(--ex-space-3) var(--ex-space-3);
    background-color: rgb(250, 250, 250);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.filter-bar__label { font-size: 24px; color: rgb(107, 107, 107); margin-bottom: 6px; }


/* Chips, not dropdowns: a select on a phone is two taps and a modal, and these lists are short. */
.filter-empty { padding: 60px; -unity-text-align: middle-center; font-size: 28px; }

/* Ash, and the odd sheet of office paper. Two pixels each — they are weather, not decoration. */
.mote {
    position: absolute;
    width: 4px;
    height: 4px;
    background-color: rgba(220, 220, 220, 0.42);
}

.mote--paper {
    width: 10px;
    height: 8px;
    background-color: rgba(236, 236, 226, 0.7);
}


/* ---------------------------------------------------------------- AUTO + office upgrades */

/* One toggle where the auto-skill and speed buttons used to be. Off is an outline, on is filled,
   so its state reads from across the room without anyone having to parse ON / OFF. */
.auto-toggle {
    flex-shrink: 0;
    min-width: 116px;
    height: 60px;
    font-size: var(--ex-text-xs);
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.7);
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 30px;
}

.auto-toggle--on {
    color: rgb(12, 16, 22);
    background-color: rgb(120, 214, 160);
    border-color: rgb(120, 214, 160);
}

/* 안전 진행 has nothing to gate while 자동 진행 is off, so it disables itself. Dimmed past the
   already-dim off state, or "disabled" and "off" look the same and the dependency is invisible. */
.auto-toggle:disabled {
    opacity: 0.4;
}

/* The gold sink, as a strip of four cells under the EX bar. Cells, deliberately: this is a
   spreadsheet, and a row of bordered boxes with a number in each is what one looks like. */
.upgrades {
    position: absolute;
    right: var(--ex-space-2);
    bottom: var(--ex-space-2);
    flex-direction: row;
    height: 146px;
}

.upgrade {
    width: 260px;
    margin-left: 8px;
    padding-left: var(--ex-space-1);
    padding-right: var(--ex-space-1);
    background-color: rgba(18, 24, 38, 0.86);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.2);
    border-bottom-width: 7px;
    border-bottom-color: rgba(0, 0, 0, 0.5);
    border-radius: var(--ex-rad-md);
    align-items: center;
    justify-content: center;
}

/* Affordable is the only state worth colouring: everything else is just a price you cannot pay. */
.upgrade--ready {
    background-color: rgba(56, 124, 214, 0.94);
    border-color: rgb(146, 196, 255);
    border-bottom-color: rgb(32, 86, 164);
}

.upgrade--ready .upgrade__name { color: rgba(255, 255, 255, 0.85); }

.upgrade__name {
    font-size: var(--ex-text-xs);
    color: rgba(255, 255, 255, 0.66);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.upgrade__level {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-top: 4px;
}

.upgrade__cost { font-size: 22px; color: var(--ex-gold); margin-top: 2px; }

.result__auto {
    font-size: 26px;
    color: rgb(150, 156, 170);
    margin-top: 14px;
}

/* ---------------------------------------------------------------- sheet list */

.sheet-list {
    width: 84%;
    max-height: 76%;
    background-color: rgb(255, 255, 255);
    border-radius: 10px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    padding-right: 18px;
}

.sheet-list__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
    margin-bottom: 12px;
    margin-left: 10px;
}

.sheet-list__row {
    height: 96px;
    font-size: 30px;
    color: rgb(40, 42, 48);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(232, 232, 232);
    -unity-text-align: middle-left;
    padding-left: 18px;
}

.sheet-list__row--active {
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    background-color: rgb(240, 248, 243);
}


/* ---------------------------------------------------------------- roster sections */

/* The sheet header is a title and a count, and the count is the whole of the codex readout:
   a number on the right, where a spreadsheet puts its numbers. */
.sheet-head--tight {
    flex-wrap: nowrap;
    padding-top: 12px;
    padding-bottom: 12px;
}

.sheet-head__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
}

.sheet-head__count {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    -unity-text-align: middle-right;
}

/* One band per grade. The coloured rule down the left is what makes the sections scannable while
   scrolling fast — the tag alone disappears at speed. */
.grade-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 74px;
    margin-top: 18px;
    margin-left: 10px;
    margin-right: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(246, 246, 246);
    border-bottom-width: 1px;
    border-bottom-color: rgb(216, 216, 216);
}

.grade-head__rule {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
}

.grade-head__tag {
    min-width: 52px;
    height: 52px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(255, 255, 255);
    border-radius: 4px;
    margin-right: 14px;
}

.grade-head__label {
    font-size: 28px;
    color: rgb(70, 72, 80);
}

.grade-head__count {
    font-size: 28px;
    color: rgb(120, 124, 134);
}


/* ---------------------------------------------------------------- Excel dialog */

/* The shape of an Office dialog: a grey caption bar, a body with the message and an icon, and a
   button row bottom-right. Used for anything that has to interrupt, so interruptions look like
   part of the spreadsheet rather than part of a game. */
.xl-dialog {
    width: 90%;
    max-height: 86%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(150, 150, 150);
    border-radius: 6px;
    overflow: hidden;
}

.xl-dialog__caption {
    flex-direction: row;
    align-items: center;
    height: 88px;
    flex-shrink: 0;
    background-color: rgb(242, 242, 242);
    border-bottom-width: 1px;
    border-bottom-color: rgb(214, 214, 214);
    padding-left: 24px;
}

.xl-dialog__caption-title {
    font-size: 28px;
    color: rgb(70, 72, 78);
}

.xl-dialog__close {
    width: 88px;
    height: 88px;
    font-size: 32px;
    color: rgb(90, 92, 98);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.xl-dialog__body {
    padding-top: 28px;
    padding-bottom: 20px;
    padding-left: 28px;
    padding-right: 28px;
}

.xl-dialog__head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 22px;
}

/* The round information glyph Office puts beside a message. Drawn rather than imported, because
   Unity's default font has no symbol for it. */
.xl-dialog__icon {
    width: 68px;
    height: 68px;
    flex-shrink: 0;
    margin-right: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold-and-italic;
    font-size: 36px;
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-radius: 34px;
}

.xl-dialog__head-text { flex-grow: 1; flex-shrink: 1; }

.xl-dialog__title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(30, 32, 38);
}

.xl-dialog__subtitle {
    font-size: 26px;
    color: rgb(120, 124, 134);
    margin-top: 6px;
}

/* A block of worksheet rows inside the dialog: row numbers, cell borders, the lot. */
.xl-dialog__sheet {
    border-width: 1px;
    border-color: rgb(214, 214, 214);
}

.xl-row {
    flex-direction: row;
    align-items: center;
    min-height: 82px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(228, 228, 228);
}

.xl-row__n {
    width: 62px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(130, 134, 142);
    background-color: rgb(243, 243, 243);
    border-right-width: 1px;
    border-right-color: rgb(214, 214, 214);
    height: 100%;
}

.xl-row__cell {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 28px;
    color: rgb(42, 44, 50);
    padding-left: 18px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.xl-row--grant { background-color: rgb(240, 248, 243); }

.xl-row__value {
    flex-shrink: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    -unity-text-align: middle-right;
    padding-right: 20px;
}

.xl-dialog__note {
    font-size: 25px;
    color: rgb(126, 130, 140);
    white-space: normal;
    margin-top: 18px;
}

.xl-dialog__foot {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 18px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgb(247, 247, 247);
    border-top-width: 1px;
    border-top-color: rgb(222, 222, 222);
}

/* The dialog button. Squarer than the game's, because an Office dialog's buttons are square —
   but the height, padding and type come from the same tokens as everything else. */
.xl-btn {
    min-width: 200px;
    height: var(--ex-tap);
    margin-left: var(--ex-space-2);
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-3);
    font-size: var(--ex-text-sm);
    color: var(--ex-ink);
    background-color: var(--ex-surface);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-sm);
}

/* The default button — the one Enter would press. */
.xl-btn--default {
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-color: rgb(24, 88, 54);
    -unity-font-style: bold;
}


/* ---------------------------------------------------------------- check-in stamp */

.stamp { flex-shrink: 0; }

.stamp__head { flex-direction: row; align-items: center; margin-bottom: 16px; }
.stamp__title { font-size: 34px; -unity-font-style: bold; color: rgb(38, 40, 46); }
.stamp__streak { font-size: 28px; color: rgb(33, 115, 70); -unity-font-style: bold; }

/* Eight day cells across, so a week plus "이후" fits one row without wrapping on a phone. */
.stamp__grid { flex-direction: row; }

.stamp-day {
    flex-grow: 1;
    flex-basis: 0;
    height: 116px;
    margin-left: 3px;
    margin-right: 3px;
    align-items: center;
    justify-content: center;
    background-color: rgb(246, 246, 246);
    border-width: 1px;
    border-color: rgb(216, 216, 216);
    border-radius: 4px;
}

.stamp-day--on { background-color: rgb(236, 246, 240); border-color: rgb(160, 200, 178); }

/* Today is an outline rather than a fill — a filled cell means "already stamped". */
.stamp-day--today {
    border-width: 3px;
    border-color: rgb(33, 115, 70);
    background-color: rgb(255, 255, 255);
}

.stamp-day__n { font-size: 24px; color: rgb(110, 114, 122); }
.stamp-day__gems { font-size: 24px; height: 44px; -unity-font-style: bold; color: rgb(60, 62, 70); }

/* The stamp itself: a red approval mark at an angle, the way an actual 도장 lands. */
.stamp-day__mark {
    position: absolute;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(199, 62, 62, 0.85);
    border-width: 2px;
    border-color: rgba(199, 62, 62, 0.7);
    border-radius: 6px;
    padding-left: 6px;
    padding-right: 6px;
    rotate: -14deg;
}

.stamp__go { margin-top: 18px; }
.stamp__done { margin-top: 16px; font-size: 27px; color: rgb(126, 130, 140); }

/* ---------------------------------------------------------------- summon banner

   Built from docs/design/pickup.md. Flat-only tricks throughout, because USS has no gradients
   and no box-shadow: thick bottom borders stand in for elevation and carry the rarity colour,
   one skewed tag breaks the spreadsheet grid, and an oversized low-opacity word fills the space
   the splash art leaves empty. */

.gacha { flex-grow: 1; background-color: rgba(0, 0, 0, 0); }
.gacha__scroll { flex-grow: 1; }

.banner {
    flex-grow: 1;
    justify-content: flex-end;
    padding-bottom: var(--ex-space-3);
    padding-left: var(--ex-space-3);
    background-color: rgb(26, 37, 48);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
    border-radius: var(--ex-rad-lg);
    overflow: hidden;
}

.banner__watermark {
    position: absolute;
    left: 20px;
    bottom: 150px;
    font-size: 200px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    opacity: 0.08;
}

/* The one geometric break in a screen made entirely of right angles. */
.banner__tag {
    position: absolute;
    left: 40px;
    top: 36px;
    height: 62px;
    padding-left: 30px;
    padding-right: 30px;
    justify-content: center;
    rotate: -2deg;
    scale: 1 1;
}

.banner__tag-text {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
}

.banner__plate {
    width: 78%;
    padding: 20px 26px 20px 26px;
    background-color: rgb(255, 255, 255);
    border-left-width: 12px;
}

.banner__kicker {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    letter-spacing: 4px;
}

.banner__title {
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(26, 37, 48);
}

/* ---- the two featured cards ---- */

.pickup {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: var(--ex-space-2);
}

.pcard {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 8px;
    margin-right: 8px;
    background-color: var(--ex-surface-raised);
    border-radius: var(--ex-rad-md);
    /* Rarity and elevation in one stroke — the colour is set per card from grades.json. */
    border-bottom-width: 12px;
    overflow: hidden;
}

.pcard__art {
    width: 42%;
    flex-shrink: 0;
    background-color: rgb(232, 234, 238);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
}

.pcard__grade {
    position: absolute;
    left: 0;
    top: 0;
    min-width: 64px;
    height: 64px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 32px;
    color: rgb(20, 22, 28);
    border-bottom-right-radius: 10px;
}

.pcard__foot {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
    padding: var(--ex-space-2);
}

.pcard__name {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pcard__track {
    height: 12px;
    margin-top: 14px;
    background-color: rgb(226, 229, 234);
    border-radius: 6px;
    overflow: hidden;
}

.pcard__fill { height: 100%; }

.pcard__line { flex-direction: row; align-items: center; margin-top: 12px; }

.pcard__points { font-size: 28px; color: rgb(110, 116, 128); }

.pcard__take {
    min-width: 150px;
    height: var(--ex-tap);
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-width: 2px;
    border-color: var(--ex-accent);
    border-bottom-width: 6px;
    border-bottom-color: var(--ex-accent-deep);
    border-radius: var(--ex-rad-md);
}

.pcard__take:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

/* ---- rates and the two pity floors ---- */

.rates {
    flex-shrink: 0;
    padding: var(--ex-space-2);
    background-color: var(--ex-surface-raised);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
}

.rates__row { flex-direction: row; margin-bottom: 18px; }

.rate-chip {
    flex-direction: row;
    align-items: center;
    height: 60px;
    margin-right: 10px;
    padding-right: 14px;
    background-color: rgb(243, 245, 247);
    border-radius: 6px;
}

.rate-chip__id {
    width: 56px;
    height: 60px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(20, 22, 28);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.rate-chip__rate { font-size: 26px; color: rgb(90, 96, 106); margin-left: 10px; }

.pity__row { flex-direction: row; align-items: center; height: 62px; }

.pity__tag {
    width: 56px;
    height: 56px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(20, 22, 28);
    border-radius: 6px;
    margin-right: 16px;
}

.pity__track {
    flex-grow: 1;
    height: 16px;
    background-color: rgb(230, 233, 238);
    border-radius: 8px;
    overflow: hidden;
}

.pity__fill { height: 100%; }

.pity__label {
    width: 140px;
    -unity-text-align: middle-right;
    font-size: 28px;
    color: rgb(90, 96, 106);
}

/* ---- the foot ---- */

.pull-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 20px 28px 26px 28px;
    background-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-top-color: rgb(222, 226, 232);
}

.pull-bar__points { width: 210px; flex-shrink: 0; }
.pull-bar__label { font-size: 26px; -unity-font-style: bold; color: rgb(130, 140, 150); }
.pull-bar__value { font-size: 52px; -unity-font-style: bold; color: rgb(26, 37, 48); }

.pull-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--ex-tap-lg);
    margin-left: var(--ex-space-2);
    font-size: 46px;
    white-space: nowrap;
}

.pull-btn--primary { flex-grow: 1.8; }


/* The first-run home screen, before anyone has been recruited. It replaces the battlefield rather
   than sitting inside it — a notice on a black band under an empty EX bar reads as a broken
   battle, which is exactly what it is not. */
.battle-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 60px;
    padding-right: 60px;
}

.battle-empty__title {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
}

.battle-empty__line {
    font-size: 30px;
    color: rgb(120, 124, 134);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 16px;
}

.battle-empty__go { margin-top: 40px; min-width: 460px; }


/* The run's result. Narrower than the onboarding dialog because it carries three numbers, and it
   never needs to be dismissed — the next run takes it down. */
.result-dialog { width: 84%; }


/* ---------------------------------------------------------------- hit effects */

/* The Painter2D canvas the arcs, bursts and sparks are drawn on. It covers the field and never
   takes a click; the fighters are added after it, so nothing is painted over a face. */

/* One frame of blowout on the thing that just got hit. The eye reads this as contact before it
   reads the number, which is most of why a hit lands at all. */
.fighter__body--flash {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    scale: 1.12 1.12;
}

.floater--crit {
    font-size: 58px;
    color: rgb(250, 204, 70);
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
}

/* 콤보. Only appears once a run of hits is worth noticing, so it means something when it does. */
.combo {
    position: absolute;
    left: 0;
    right: 0;
    top: 118px;
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(250, 204, 70);
    opacity: 0;
}

.combo--on { opacity: 1; }


/* ---------------------------------------------------------------- skill gauge */

/* The blue bar under a hero's health, filling towards their next skill. It replaces the row of EX
   cards and the shared budget bar that used to sit under the field: every skill fires itself, so a
   card you cannot press only tells you the game is thinking. */
.fighter__skillbar {
    width: 64px;
    height: 5px;
    margin-top: 2px;
    background-color: rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    overflow: hidden;
}

.fighter__skillfill {
    height: 100%;
    background-color: rgb(58, 132, 214);
}

/* Full: it is about to go off, so it says so. */
.fighter__skillfill--ready { background-color: rgb(120, 198, 255); }

/* ---------------------------------------------------------------- daily sheet */

/* Sections, the web's `qs-block`: a titled card per group so the sheet reads as a list of things
   rather than as one long column of panels. */
.qs-block {
    flex-shrink: 0;
    margin-bottom: var(--ex-space-2);
    padding: var(--ex-space-2);
    background-color: var(--ex-surface);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
}

/* The section header, the same one everywhere: a name, a muted note beside it, a rule under. */
.qs-title {
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 0;
    padding-bottom: var(--ex-space-1);
    margin-bottom: var(--ex-space-1);
    border-bottom-width: 2px;
    border-bottom-color: var(--ex-line);
}

.qs-title__name {
    font-size: var(--ex-text-lg);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-right: var(--ex-space-2);
}

.qs-title__note {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    flex-shrink: 1;
    white-space: normal;
}

.sheet-head__sub { font-size: 24px; color: rgb(140, 145, 155); }

.claim-all { min-width: 300px; height: 92px; font-size: 30px; }

/* One task per row: the text block grows, the button stays put on the right. */
.qrow {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 78px;
    overflow: hidden;
    border-bottom-width: 1px;
    border-bottom-color: rgb(234, 234, 234);
}

.qrow--done { opacity: 0.55; }

.qrow__name { font-size: 26px; -unity-font-style: bold; color: rgb(40, 42, 48); }
.qrow__desc { font-size: 21px; color: rgb(140, 145, 155); }

.qrow__track {
    height: 8px;
    margin-top: 5px;
    margin-right: 20px;
    background-color: rgb(228, 230, 234);
    border-radius: 4px;
    overflow: hidden;
}

.qrow__fill { height: 100%; background-color: rgb(33, 115, 70); }

/* The reward sits at the end of the name's line, so the bar can have the next one to itself. */
.qrow__head { flex-direction: row; align-items: center; }
.qrow__name { flex-grow: 1; flex-shrink: 1; }
.qrow__meta { font-size: 21px; color: rgb(110, 115, 125); flex-shrink: 0; margin-right: 20px; }

.qrow__claim {
    flex-shrink: 0;
    min-width: 140px;
    height: 58px;
    font-size: var(--ex-text-xs);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-width: 2px;
    border-color: var(--ex-accent);
    border-bottom-width: 6px;
    border-bottom-color: var(--ex-accent-deep);
    border-radius: var(--ex-rad-md);
}

.qrow__claim:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

.qrow__done { flex-shrink: 0; min-width: 128px; -unity-text-align: middle-center; font-size: 26px; color: rgb(150, 154, 162); }


/* ---------------------------------------------------------------- icons */



/* The street. Taller than the box it sits in and top-anchored from code so its drawn road meets
   the sprites' feet; the field's overflow crops the sky above it. */
.battle__backdrop {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

/* An empty cell on a short last page, so four cards do not spread across a row built for seven. */
.card--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* The filter bar carries the grade sections now: each chip is a section with its own count. */
.filter-bar {
    flex-shrink: 0;
    padding-top: var(--ex-space-1);
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
}

/* 60px, not 72. There are TWO of these rows (등급 and 역할) where the spec budgets 90 for one,
   and the arithmetic of the content band is unforgiving: 60x2 + (290+20)x2 + 70 = 810 of the
   820 available. At 72 the second row of cards lands 22px inside the pager. */
.filter-row {
    flex-direction: row;
    align-items: center;
    height: 60px;
}

.filter-row__label {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    margin-right: var(--ex-space-1);
}

.filter-row__count {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-left: var(--ex-space-2);
    margin-right: var(--ex-space-1);
}

.filter-chip {
    height: 56px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    background-color: var(--ex-surface-sunken);
    border-width: 2px;
    border-color: var(--ex-line);
    border-radius: 28px;
}

.filter-chip--on {
    background-color: var(--ex-accent);
    border-color: var(--ex-accent-deep);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* Page turning, wherever a list is longer than the screen. Held sideways nothing scrolls, so this
   is how a list gets read. */
.pager {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 70px;
}

/* The pager carried the same fault as .btn: a white fill behind a pale hairline, on a white
   sheet. These are the only way to reach pages 2 to 4 of the roster. */
.pager__btn {
    width: 104px;
    height: 78px;
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-navy);
    background-color: var(--ex-btn);
    border-width: 3px;
    border-color: var(--ex-btn-line);
    border-bottom-width: 5px;
    border-bottom-color: var(--ex-btn-edge);
    border-radius: var(--ex-rad-md);
}

.pager__btn:hover { background-color: var(--ex-btn-down); }

/* At the first or last page. Dimmed, but still a button with an edge — opacity 0.35 left a
   smudge where a control had been. */
.pager__btn:disabled {
    background-color: var(--ex-btn-off);
    border-color: var(--ex-btn-off-line);
    border-bottom-color: var(--ex-btn-off-line);
    color: var(--ex-btn-off-ink);
}

.pager__label {
    min-width: 260px;
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-ink);
}

/* ---------------------------------------------------------------- landscape column layouts

   Nothing in this build scrolls. A list that outgrows the frame turns pages (.pager); everything
   else is laid out in columns, because the frame is twice as wide as it is tall and stacking is
   what put content below the fold in the first place. */

.gacha__cols { flex-direction: row; flex-grow: 1; min-height: 0; }

.gacha__left {
    width: 44%;
    flex-shrink: 0;
    padding: var(--ex-space-2);
}

.gacha__right {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: var(--ex-space-2);
}

.qs-cols { flex-direction: row; flex-grow: 1; min-height: 0; }

.qs-col {
    width: 40%;
    flex-shrink: 0;
    padding: var(--ex-space-2);
}

.qs-col--wide { flex-grow: 1; flex-shrink: 1; width: auto; min-width: 0; }

.charts__cols {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: var(--ex-space-2);
}

/* Three episode cards across, two down. */
.ep-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    padding-left: 60px;
    padding-right: 60px;
}

/* 680 x 320, three across and two down: 2040 of card in the 2280 working width.
   The spec asks for 340 and the band does not hold it — 820 less the 66px caption and the 70px
   pager leaves 684, and two rows of 340 plus margins are 712. 320 fits with twelve to spare.

   Fixed pixels, not percentages: a percentage MARGIN resolves against the parent's WIDTH even
   when it applies vertically, and on a 2400-wide frame that is what pushed this grid's second
   row into its own pager once already. */
.ep {
    width: 680px;
    height: 320px;
    margin: 8px;
    padding: var(--ex-space-1) var(--ex-space-2) var(--ex-space-1) var(--ex-space-2);
    justify-content: space-between;
    overflow: hidden;
}

/* Inside an episode card the type steps down a size: the card is a third of the frame wide. */
.ep .section-title { font-size: 30px; margin-bottom: 2px; }
.ep .muted { font-size: 24px; }
/* 74px of button with 44px of vertical padding left 36px for a label that needs 51. The
   padding on .btn is there to clear the SLANT, which is horizontal — vertically it buys
   nothing, so it is dropped here rather than growing a card that already fits its row. */
.ep .btn {
    flex-shrink: 0;
    height: 74px;
    margin-top: 4px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: var(--ex-text-xs);
}

/* The screen's own heading is a line, not a panel taking a fifth of the frame. */
/* The caption bar spans the gutter now that it is one element rather than a title and a line
   beside it, so the row padding goes and the 60px gutter does the work. */
.ep-head {
    flex-shrink: 0;
    padding-left: 60px;
    padding-right: 60px;
    padding-top: var(--ex-space-1);
}

.ep-head .section-title { margin-bottom: 0; margin-right: var(--ex-space-2); }

/* The cards half of the 모집 column; the rates block sits under it and is not its child, so a
   rebuild of the cards cannot take the odds with it. */
.gacha__cards { flex-grow: 1; min-height: 0; }

/* The contact shadow under each fighter. Inset rather than sized, so it stays centred under a
   sprite whose box is a different width per kind, and flat rather than soft because USS has no
   blur — an ellipse at a third opacity reads as ground contact anyway. */
.fighter__shadow {
    position: absolute;
    left: 64px;
    right: 64px;
    top: 128px;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.3);
}

.fighter--monster .fighter__shadow { top: 174px; }
.fighter--elite .fighter__shadow { left: 56px; right: 56px; top: 206px; height: 16px; border-radius: 8px; }
.fighter--elite .fighter__shadow { left: 38px; right: 38px; top: 206px; }

.fighter--boss .fighter__shadow {
    left: 140px;
    right: 140px;
    top: 262px;
    height: 32px;
    border-radius: 16px;
}

/* ---------------------------------------------------------------- card sheet tabs

   The reference splits its own student sheet into 기본 정보 / 레벨 업 / 신비 해방 rather than
   running them down one scroll. Everything this modal knows is four screens of reading, and held
   sideways there is no scroll to put it in. */

/* The tab strip now starts at the very top of the right column, where the navy name bar used
   to be — and that is exactly where the close button floats. 106px of right padding is the
   button's 90px plus a gap, so the last tab ends before it rather than under it. LayoutAudit
   never saw this: the tab was inside its container and inside the screen, it was simply
   covered. Occlusion is a third thing the audit cannot measure. */
.dtabs {
    flex-direction: row;
    flex-shrink: 0;
    padding-left: var(--ex-space-2);
    padding-right: 106px;
    padding-top: var(--ex-space-1);
}

.dtab {
    flex-grow: 1;
    flex-basis: 0;
    height: 84px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 32px;
    color: rgb(22, 38, 63);
}

.detail__foot {
    flex-shrink: 0;
    padding: var(--ex-space-2);
    border-top-width: 2px;
    border-top-color: var(--ex-line);
}

/* The two answers to "what should happen to this card" sit side by side. Margin on both sides
   of each button keeps the outer gutters symmetric without a :first-child selector, which USS
   does not have. */
.detail__acts { flex-direction: row; }

.detail__acts > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: var(--ex-space-1);
    margin-right: var(--ex-space-1);
}

.detail__release { margin-bottom: var(--ex-space-2); }

/* The hairline and the + that close every currency pill in the reference. */
.chip__rule {
    width: 3px;
    height: 44px;
    background-color: var(--ex-line);
}

.chip__plus {
    width: 58px;
    font-size: 40px;        /* 48 needed a 60px line in a 52px pill (LayoutAudit) */
    -unity-font-style: bold;
    color: rgb(40, 190, 240);
    -unity-text-align: middle-center;
}

/* The star row on the plate, and the corner flag on a card the player did not already own —
   both straight off the reference's ten-pull. */
.reveal-grid__stars {
    height: 20%;
    font-size: 40px;
    -unity-text-align: middle-center;
    color: rgb(255, 210, 40);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(120, 76, 0);
}

/* Yellow italic "New" above the card's top-left, as on the reference. */
.reveal-grid__new {
    position: absolute;
    left: 10px;
    top: -46px;
    font-size: 40px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 214, 40);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(110, 70, 0);
}

.reveal-foot { align-items: center; margin-top: var(--ex-space-3); }
.reveal-foot__ok { min-width: 520px; }

/* The pity total, in the corner the reference keeps it in. */
.reveal-points {
    position: absolute;
    right: var(--ex-space-4);
    bottom: var(--ex-space-4);
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-3);
    background-color: var(--ex-navy);
    border-radius: var(--ex-rad-md);
}

.reveal-points__label { font-size: var(--ex-text-xs); color: rgba(255, 255, 255, 0.7); margin-right: var(--ex-space-2); }
.reveal-points__value { font-size: var(--ex-text-sm); -unity-font-style: bold; color: rgb(255, 255, 255); }

/* ---------------------------------------------------------------- 편성

   The line-up on the left at a size where a face reads, what it adds up to on the right — the
   arrangement the reference's own 부대 편성 uses. */

.party-cols {
    flex-direction: row;
    justify-content: center;
    flex-grow: 1;
    min-height: 0;
    padding-left: 60px;
    padding-right: 60px;
    padding-top: var(--ex-space-2);
    padding-bottom: var(--ex-space-2);
}

/* The layout spec's split: 1500 for the line-up, 700 for everything it adds up to. Together
   with the 60px gutters that is 2320 of the 2400, leaving 80 for the gap between them. */
.party-cols__left {
    width: 1500px;
    flex-shrink: 0;
    margin-right: var(--ex-space-5);
}

.party-cols__right { width: 700px; flex-shrink: 0; }

/* Four buttons no longer fit on one line, and a right-aligned row that does not wrap spills off
   the LEFT of the screen — which is how 자동 편성 ended up cut in half. Wrapping drops the overflow
   onto a second line instead. Labels are not shortened to force one line: 골드 소진까지 일괄 강화
   spends every coin the player has and the label is the only warning it gets. */
/* The action rail, on the far right and stacked, where the reference keeps 편성 · 대표 · 지원.
   These were a ROW under the line-up, and four of them did not fit on one line: the row wrapped
   and the last button hung below the others with nothing beside it. A column has no line to run
   out of, and the widest label stops being a layout problem. */
/* The actions, at the foot of the right column. They were a third column briefly, which does
   not fit: 1500 + 700 + 300 is 2500 in a 2280 working width.

   TWO BY TWO, not a stack. Four buttons at 104px each is 416 of a 788px column that also has to
   hold the power readout and two panels, and the audit measured the last one 233px below the
   screen. Two rows of two is 184.

   flex-shrink: 0 here and 1 on the panels above is the important half: whatever is short, the
   panels give it up and the buttons stay on screen. A panel that loses its last row is a panel
   you scroll — a button that leaves the screen is a feature you cannot reach. */
.party-rail {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: var(--ex-space-1);
}

/* nowrap, not normal. The plate is a parallelogram: a second line has nowhere to go but out
   through the slant at both ends, which is what a wrapped "대기 인원에서 채우기" did. The labels
   are short enough to fit on one line now, and the sentence they lost moved to the status bar. */
.party-rail .btn {
    width: 48%;
    height: 88px;
    margin-bottom: var(--ex-space-1);
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
    font-size: var(--ex-text-xs);
    white-space: nowrap;
}

/* A line-up slot: the portrait, then a plate UNDER it rather than over it. UiKit.Card's plate is
   an overlay, which is right for a grid of fourteen and wrong for five figures at full size —
   the reference captions each one and leaves the picture uncovered. */
/* 280 wide, as the spec asks: five of them plus gaps inside the 1500px column. */
/* pslot: reference sheet panel 6 — the same object as UiKit.Card, at full height. Grade plate,
   role badge, stars and the white frame are the card's own helpers; only the band differs, which
   sits under the portrait here rather than over it. */
.pslot {
    width: 280px;
    flex-shrink: 0;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgb(206, 222, 238);
    border-width: 0;
    border-radius: 16px;
    overflow: hidden;
}

.pslot__art {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(226, 236, 246);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top 8%;
}

.pslot__plate {
    flex-shrink: 0;
    padding: 8px 16px 12px 16px;
    background-color: rgb(28, 44, 80);
    border-top-width: 2px;
    border-top-color: rgba(120, 200, 245, 0.55);
}

.pslot__dept {
    flex-shrink: 0;
    font-size: 19px;
    color: rgba(200, 220, 240, 0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pslot__name { font-size: 25px; }

/* Above the band, not over the frame's foot. */
.pslot__stars { bottom: 104px; }

.slot__hint { font-size: var(--ex-text-xs); color: var(--ex-ink-muted); margin-top: 6px; }

.picker-grid { height: 620px; }

/* Inside the 편성 column everything steps down a size, so the composition's last row is on the
   screen rather than a pixel past the bottom of it. */
/* flex-shrink stays, as the last line of defence — if a synergy list ever grows past what the
   column holds, a clipped panel is still better than a button off the screen. It should not be
   reached now that 편성 구성 is two lines instead of four. */
.party-cols__right .panel {
    flex-shrink: 1;
    overflow: hidden;
    padding: var(--ex-space-2);
    margin-bottom: var(--ex-space-2);
}
.party-cols__right .section-title { font-size: var(--ex-text-sm); margin-bottom: var(--ex-space-1); }
/* 60, not 56. At 56 the row's content box is 41px and Korean at this size measures 43 — the
   audit named all eight labels. Two pixels, and every one of them was clipping its own glyphs. */
.party-cols__right .stat-row { height: 60px; flex-shrink: 0; }
.party-cols__right .synergy-line { font-size: var(--ex-text-xs); }

/* The text column has to be allowed to be narrow, or a long quest name pushes the 수령 button
   off the end of the row instead of ellipsing. */
.qrow__text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.qrow__name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---------------------------------------------------------------- 검토

   업적 on the left, 마일스톤 on the right: one has tiers and keeps paying, the other is a mark
   passed once, and reading them as a single list only ever made sense because the web build had
   a scroll to put them both in. */

.prog-cols { flex-direction: row; flex-grow: 1; min-height: 0; padding: var(--ex-space-2); }

.prog-cols__left {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--ex-space-2);
}

.prog-cols__right { width: 38%; flex-shrink: 0; }

.prog-head {
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 0;
    padding-left: var(--ex-space-1);
}

.prog-head .section-title { margin-bottom: var(--ex-space-1); }

/* A claim button that lives on the section's own title line. Anything that must stay reachable
   belongs here rather than at the end of a stack of panels, where it is the first thing the
   column runs out of room for. */
.head-btn {
    flex-shrink: 0;
    min-width: 170px;
    height: 56px;
    margin-left: var(--ex-space-2);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-width: 2px;
    border-color: var(--ex-accent);
    border-radius: var(--ex-rad-md);
}

.head-btn:hover { background-color: var(--ex-accent-deep); }

/* An action button that shares a row with filter chips. A filled accent button is the same
   shape and the same colour as a SELECTED chip, so on 인사 the sweep button read as "this
   filter is on" — an action has to be told apart from a state at a glance. Outlined: accent
   ink on the surface, so it is clearly pressable and clearly not a chip. */
.head-btn--quiet {
    color: var(--ex-accent-deep);
    background-color: var(--ex-btn);
    border-color: var(--ex-btn-line);
}

.head-btn--quiet:hover { background-color: var(--ex-btn-down); }

.head-btn--quiet:disabled { color: var(--ex-ink-muted); border-color: var(--ex-line); }

.prog-list { flex-grow: 1; min-height: 0; }

.arow {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 112px;
    overflow: hidden;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
    margin-bottom: var(--ex-space-1);
    background-color: var(--ex-surface-raised);
    border-width: 2px;
    border-color: var(--ex-line);
    border-bottom-width: 5px;
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
}

.arow__text { flex-grow: 1; flex-shrink: 1; min-width: 0; }

.arow__name {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.arow__track {
    height: 8px;
    margin-top: 6px;
    margin-right: var(--ex-space-3);
    background-color: var(--ex-surface-sunken);
    border-radius: 4px;
    overflow: hidden;
}

.arow__fill { height: 100%; background-color: var(--ex-accent); }

.arow__meta { font-size: 22px; color: var(--ex-ink-muted); margin-top: 4px; }

.arow__claim {
    flex-shrink: 0;
    min-width: 150px;
    height: 76px;
    font-size: var(--ex-text-xs);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-width: 2px;
    border-color: var(--ex-accent);
    border-bottom-width: 6px;
    border-bottom-color: var(--ex-accent-deep);
    border-radius: var(--ex-rad-md);
}

.arow__done {
    flex-shrink: 0;
    min-width: 150px;
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    -unity-text-align: middle-center;
}

.prog-cols__right .panel { padding: var(--ex-space-2); margin-bottom: var(--ex-space-2); }
.prog-cols__right .section-title { font-size: var(--ex-text-sm); margin-bottom: var(--ex-space-1); }
.prog-cols__right .stat-row { height: 68px; }

/* 백그라운드 정산 — one number and one button, which is all this dialog is for. */
.idle { width: 46%; min-width: 760px; align-items: center; }
.idle .power-readout { margin-top: var(--ex-space-2); margin-bottom: var(--ex-space-2); }
.idle .btn { min-width: 420px; margin-top: var(--ex-space-2); }

/* 광고 보상 — five rows and a rule, which is all it is. */
.ad-menu { width: 62%; min-width: 1100px; }
.ad-menu .arow { margin-bottom: var(--ex-space-1); }
.ad-menu .arow__claim { min-width: 230px; }
.ad-menu .btn { margin-top: var(--ex-space-2); }

/* 야근 sits beside AUTO and is the louder of the two — it is the one fight the player starts. */
.overtime-btn {
    margin-left: var(--ex-space-1);
    border-color: rgba(250, 204, 70, 0.7);
    color: rgb(250, 204, 70);
}

.overtime-btn:disabled { opacity: 0.45; }

/* 분해 sits beside 장착 and must not read as the same decision. */
.arow__claim--ghost {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    color: var(--ex-ink-muted);
    margin-left: var(--ex-space-1);
}

/* 승산, in the HUD pill beside the wave counter. Quiet until the fight is actually in doubt. */
.forecast {
    font-size: var(--ex-text-xs);
    color: rgba(255, 255, 255, 0.66);
    margin-right: var(--ex-space-2);
}

.forecast--hard { color: rgb(255, 150, 130); -unity-font-style: bold; }

/* The code field. Typed by hand, so it is as tall as a tap target and as wide as a code. */
.code-field {
    margin-top: 6px;
    margin-right: var(--ex-space-3);
}

.code-field > .unity-base-text-field__input {
    height: 68px;
    font-size: var(--ex-text-sm);
    color: var(--ex-ink);
    background-color: var(--ex-surface-raised);
    border-width: 3px;
    border-color: var(--ex-line);
    border-radius: var(--ex-rad-sm);
    padding-left: var(--ex-space-2);
}


/* ============================================================== 카드 시트 · 참고 레이아웃
   The reference's student page, copied in structure rather than only in colour: a name plate
   ON the portrait, and a right column of grouped blocks — a captioned two-column stat grid, a
   row of chips, skill cards, and the equipment as sockets. What was here was a vertical list of
   label/value rows, which carries the same numbers and is not the same screen. */

.dplate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--ex-space-2);
    background-color: rgba(16, 26, 46, 0.86);
    border-top-width: 3px;
    border-top-color: rgba(255, 255, 255, 0.22);
}

.dplate__top { flex-direction: row; align-items: center; }

.dplate__dept {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.72);
    margin-right: var(--ex-space-1);
}

.dplate__grade {
    padding: 2px 14px;
    border-radius: 12px;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.dplate__namerow { flex-direction: row; align-items: center; margin-top: 2px; }

.dplate__name {
    font-size: var(--ex-text-lg);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.dplate__heart { font-size: 28px; color: rgb(244, 114, 150); margin-left: var(--ex-space-1); }

.dplate__meta { flex-direction: row; align-items: center; margin-top: 4px; }

.dplate__lv {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-right: var(--ex-space-2);
}

.dplate__stars { font-size: var(--ex-text-sm); margin-right: var(--ex-space-2); }

.dplate__bond { font-size: 22px; color: rgba(255, 255, 255, 0.72); }

/* A captioned group. The caption is a filled bar, as it is in the reference, so the eye can
   find the edges of a block without counting rows. */
.block {
    flex-shrink: 0;
    margin-bottom: var(--ex-space-2);
    background-color: var(--ex-surface);
    border-width: 2px;
    border-color: var(--ex-btn-line);
    border-radius: var(--ex-rad-sm);
    overflow: hidden;
}

.block__title {
    height: 48px;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    padding-left: 24px;
    padding-right: 40px;
    background-image: url("project://database/Assets/ExcelHeroes/Art/UI/panel_head.png");
    -unity-slice-left: 30;
    -unity-slice-right: 38;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* Two columns, so four stats are two lines. That is what buys the room for the skill cards and
   the equipment sockets to be on the same page rather than behind another tab. */
.statgrid { flex-direction: row; flex-wrap: wrap; padding: var(--ex-space-1); }

.statcell {
    width: 50%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 3px var(--ex-space-1);
}

.statcell__key { font-size: 23px; color: var(--ex-ink-muted); }

.statcell__val { font-size: var(--ex-text-sm); -unity-font-style: bold; color: var(--ex-ink); }

/* 등급 · 역할 · 부문 · 승급. These had been DELETED from this screen for not fitting as rows;
   as chips they are one line. */
.chiprow { flex-direction: row; flex-wrap: wrap; margin-bottom: var(--ex-space-2); }

.ichip {
    padding: 3px 14px;
    margin-right: var(--ex-space-1);
    border-radius: 14px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--ex-ink);
    background-color: var(--ex-btn);
    border-width: 2px;
    border-color: var(--ex-btn-line);
}

.ichip--grade { color: rgb(255, 255, 255); border-color: rgba(0, 0, 0, 0.15); }

.minicards { flex-direction: row; margin-bottom: var(--ex-space-2); }

.minicard {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--ex-space-1);
    padding: var(--ex-space-1);
    background-color: var(--ex-surface-raised);
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ex-btn-line);
    border-bottom-color: var(--ex-btn-edge);
    border-radius: var(--ex-rad-sm);
}

.minicard__kind { font-size: 20px; color: var(--ex-ink-muted); }

.minicard__name {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--ex-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.minicard__lv { font-size: 21px; -unity-font-style: bold; color: var(--ex-accent-deep); }

/* Four sockets in a row. An empty one is drawn as an empty one — the reference shows locked
   equipment slots rather than hiding them, because the gap is the information. */
.kitstrip { flex-direction: row; padding: var(--ex-space-1); }

.kittile {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
    padding: 4px 8px;
    background-color: var(--ex-surface-raised);
    border-width: 2px;
    border-color: var(--ex-btn-line);
    border-radius: var(--ex-rad-sm);
}

.kittile--empty { background-color: var(--ex-btn-off); border-color: var(--ex-btn-off-line); }

.kittile__slot { font-size: 19px; color: var(--ex-ink-muted); }

.kittile__name {
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--ex-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.kittile--empty .kittile__name { color: var(--ex-btn-off-ink); }

.kittile__val { font-size: 20px; -unity-font-style: bold; color: var(--ex-accent-deep); }


/* 캐릭터 대사 — the speech bubble over a hero's head when a Phase falls. White plate, navy text,
   a cyan rim: the reference's own bubble, and deliberately not the disguise's grey. It is
   absolutely positioned over the field, so it needs its own width rather than the field's. */
.saybubble {
    position: absolute;
    max-width: 520px;
    padding: 8px 18px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: var(--ex-accent);
    border-radius: var(--ex-rad-md);
    color: var(--ex-navy);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}


/* 괄호 수식 — the one thing in this game a player does with their hands. Over the field, near
   the top so it does not sit on the line-up, and wide enough that the sum and the answer box are
   on one row: four seconds is not long enough to hunt for the field. */
.brace {
    position: absolute;
    left: 28%;
    right: 28%;
    top: 128px;
    padding: var(--ex-space-2);
    background-color: rgba(12, 20, 36, 0.92);
    border-width: 3px;
    border-color: var(--ex-accent);
    border-radius: var(--ex-rad-md);
    align-items: center;
}

.brace__title { font-size: 24px; -unity-font-style: bold; color: var(--ex-accent); }

.brace__row { flex-direction: row; align-items: center; margin-top: 8px; }

.brace__sum {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-right: var(--ex-space-2);
}

.brace__field { width: 190px; height: 76px; font-size: 38px; }

.brace__submit { height: 76px; padding-left: 34px; padding-right: 34px; font-size: 26px; }

.brace__clock { font-size: 22px; color: rgba(255, 255, 255, 0.7); margin-top: 6px; }


/* The composition grid sits in a narrower column than the card sheet's, so its cells carry a
   little less padding. */
.party-cols__right .statgrid { padding: 0; }

.party-cols__right .statcell { padding: 6px var(--ex-space-1); }


/* The synergy panel's bottom line: what the whole list adds up to. Bold and accent-coloured so
   it reads as the conclusion, without spending a second header bar on it. */
.synergy-total {
    margin-top: var(--ex-space-1);
    padding-top: 6px;
    border-top-width: 2px;
    border-top-color: var(--ex-btn-line);
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-accent-deep);
}

/* ---------------------------------------------------------------- landscape lobby (home)
   Laid out off the reference lobby screenshots: the character large and standing in the middle,
   a 2x2 grid of coloured glyphs top-left, a white speech bubble, and the 업무 folder bottom-right. */

.home {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.home__char-container {
    position: absolute;
    left: 20%;
    bottom: -14%;
    width: 46%;
    height: 128%;
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
    border-radius: 24px;
    transition-duration: 0.15s;
}

.home__icons {
    position: absolute;
    left: 40px;
    top: 150px;
    width: 370px;
    flex-direction: row;
    flex-wrap: wrap;
}

.home__icon {
    width: 176px;
    height: 196px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.home__icon:hover { scale: 1.06 1.06; }

.home__glyph {
    font-size: 88px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(255, 255, 255);
}

.home__glyph--pink { color: rgb(255, 110, 160); }
.home__glyph--blue { color: rgb(40, 130, 230); }
.home__glyph--cyan { color: rgb(30, 190, 240); }
.home__glyph--navy { color: rgb(40, 62, 108); }

/* Dark type with a white edge, legible on any backdrop — how the reference labels its desk. */
.home__icon-label {
    margin-top: -4px;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(30, 44, 70);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(255, 255, 255);
}

.home__bubble {
    position: absolute;
    left: 58%;
    top: 20%;
    width: 36%;
    padding: 30px 40px 34px 40px;
}

.home__who {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(40, 150, 220);
}

.home__speech {
    font-size: 38px;
    color: rgb(30, 40, 60);
    margin-top: 8px;
    white-space: normal;
}

.home__bond {
    margin-top: 16px;
    flex-direction: row;
    align-items: center;
}

.home__bond-level {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(232, 60, 120);
    margin-right: 12px;
}

.home__bond-track {
    flex-grow: 1;
    height: 10px;
    background-color: rgb(230, 236, 244);
    border-radius: 5px;
    overflow: hidden;
}

.home__bond-fill {
    height: 100%;
    background-color: rgb(255, 110, 160);
    width: 0%;
}

.home__campaign {
    position: absolute;
    right: 70px;
    bottom: 40px;
    width: 340px;
    height: 300px;
    align-items: center;
}

.home__campaign:hover { scale: 1.03 1.03; }

.home__folder {
    width: 230px;
    height: 170px;
    align-items: center;
    justify-content: center;
    padding-top: 22px;
}

.home__folder-glyph {
    font-size: 96px;
    color: rgb(255, 255, 255);
}

.home__campaign-plate {
    width: 320px;
    height: 96px;
    margin-top: -14px;
    align-items: center;
    justify-content: center;
}

.home__campaign-label {
    font-size: 52px;
    -unity-font-style: bold-and-italic;
    color: rgb(22, 38, 63);
}

.home__campaign-tag {
    position: absolute;
    left: 0;
    top: 118px;
    height: 48px;
    padding: 0 22px;
    align-items: center;
    justify-content: center;
}

.home__campaign-tag-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* ---------------------------------------------------------------- battle complete popup */

.battle-complete {
    position: absolute;
    left: 20%;
    top: 20%;
    width: 60%;
    height: 60%;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 28px;
    border-width: 4px;
    border-color: rgb(186, 214, 240);
    border-bottom-width: 10px;
    border-bottom-color: rgb(160, 190, 220);
    align-items: center;
    justify-content: space-between;
    padding: 32px;
}

.battle-complete__title {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(247, 181, 41);
}

.battle-complete__title--win {
    color: rgb(0, 110, 255);
}

.battle-complete__title--lose {
    color: rgb(226, 62, 74);
}

.battle-complete__body {
    align-items: center;
    justify-content: center;
    margin-top: 16px;
}

.battle-complete__reward-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.battle-complete__reward-icon {
    font-size: 44px;
    margin-right: 12px;
}

.battle-complete__reward-text {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(26, 46, 78);
}

.battle-complete__btn {
    width: 240px;
    height: 100px;
    font-size: 38px;
    -unity-font-style: bold;
}

/* ================================================================ modal (reference sheet panel 5)
   The frame, head, ribbon, inset and tiles are painted meshes (ModalFrame.cs); these rules only
   size and place them and set the type. Measured at the 2400x1080 reference resolution. */

.modal {
    width: 1320px;
    max-width: 90%;
    max-height: 94%;
    padding: 3px;
    flex-direction: column;
}

.modal--wide { width: 1900px; }

.modal__head {
    height: 104px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.modal__title {
    flex-grow: 1;
    font-size: 52px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(22, 38, 63);
}

.modal__close {
    position: absolute;
    right: 20px;
    top: 12px;
    width: 80px;
    height: 80px;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 64px;
    color: rgb(22, 38, 63);
}

.modal__close:hover { color: rgb(20, 150, 210); }

.modal__body {
    flex-shrink: 1;
    padding: 30px 56px 44px 56px;
}

.modal__lead {
    font-size: 46px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(22, 38, 63);
}

.modal__sub {
    margin-top: 6px;
    font-size: 30px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(62, 74, 96);
}

.modal__inset {
    margin-top: 58px;
    padding: 62px 32px 34px 32px;
    flex-direction: row;
    justify-content: center;
}

/* The section ribbon straddles the inset's top edge, as on the sheet. */
.modal__inset > .ribbon {
    position: absolute;
    top: -30px;
    left: 28%;
    right: 28%;
}

.ribbon {
    height: 60px;
    padding: 0 40px;
    align-items: center;
    justify-content: center;
}

.ribbon__label {
    font-size: 32px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.rtile {
    width: 172px;
    height: 172px;
    margin: 0 16px;
    align-items: center;
    justify-content: center;
}

.rtile__glyph {
    font-size: 84px;
    color: rgb(36, 150, 220);
}

.rtile__glyph--gold { color: rgb(240, 170, 20); }

.rtile__count {
    position: absolute;
    right: 14px;
    bottom: 6px;
    font-size: 38px;
    -unity-font-style: bold-and-italic;
    color: rgb(22, 38, 63);
}

.modal__acts {
    flex-direction: row;
    justify-content: center;
    margin-top: 48px;
}

.modal__acts > .btn {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 460px;
    height: 116px;
    margin: 0 24px;
    font-size: 44px;
}

/* The battle result's own dim layer, inside the battle screen so the fight shows behind. */
.battle-result {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 18, 32, 0.55);
    align-items: center;
    justify-content: center;
}

/* UiGallery — the reference sheet's layout, for side-by-side capture only. */
.kit {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    padding: 60px 80px;
    background-color: rgb(206, 232, 247);
}

.kit__col { flex-grow: 1; flex-basis: 0; padding: 0 30px; }

.kit__cap {
    font-size: 40px;
    color: rgb(30, 44, 70);
    margin-bottom: 30px;
}

.kit__grid { flex-direction: row; flex-wrap: wrap; }

.kit__btn {
    width: 440px;
    height: 120px;
    margin: 0 40px 44px 0;
    font-size: 54px;
}

.kit__modal { width: 100%; }


/* ================================================================ touch answers (Juice.cs)
   Sink to 0.94 on press, overshoot to 1.04 on release, settle. BA_REFERENCE.md §5. */
.juice { transition-property: scale; transition-duration: 0.09s; transition-timing-function: ease-out; }
.juice--down { scale: 0.94 0.94; transition-duration: 0.05s; }
.juice--up { scale: 1.04 1.04; transition-duration: 0.09s; }

.touch-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.touch-fx {
    position: absolute;
    width: 120px;
    height: 120px;
    scale: 0.35 0.35;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.36s;
    transition-timing-function: ease-out;
}

.touch-fx--go { scale: 1.25 1.25; opacity: 0; }

/* A new screen slides a short way in from the right while it fades up. */
.screen-enter { translate: 60px 0; opacity: 0; }
.screen-enter--go {
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

/* ================================================================ illustrated icons */
.art-icon {
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

/* The bottom bar: big drawn icons that rise above the strip, labels in dark ink with a white
   edge (BA_REFERENCE.md §3). */
.navtab__icon.art-icon {
    width: 124px;
    height: 124px;
    margin-top: -46px;
}

/* Read at arm's length on a phone held sideways: the labels were 24px (8dp) and vanished. */
.navtab__label {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(30, 44, 70);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(255, 255, 255);
}

.navtab--active { background-color: rgba(0, 0, 0, 0); }
.navtab--active .navtab__label { color: rgb(20, 150, 215); }

.navcta__icon.art-icon { width: 76px; height: 76px; margin-right: 10px; }

.chip__icon.art-icon { width: 52px; height: 52px; margin-right: 10px; }

.home__art-icon {
    width: 150px;
    height: 150px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ================================================================ top edge, inside a screen
   Numbers straight on the band, no pills; the disc hangs below the band. */
.topbar { align-items: flex-start; padding-top: 0; }
.topbar .chip { height: 66px; margin-left: 6px; padding-left: 24px; }
.shell--lobby .topbar { align-items: center; padding-top: 8px; }
.shell--lobby .topbar .chip { height: 64px; margin-left: 18px; }   /* 56 left the number 2px short of its line */
.topbar__btn { height: 66px; }
.shell--lobby .topbar__btn { height: 82px; }
.navback { align-items: flex-start; margin-top: 8px; }
.navback__btn { width: 96px; height: 96px; border-radius: 48px; font-size: 48px; }
.navback__title { margin-top: 10px; font-size: 40px; }
.chip__value { font-size: 36px; }

/* The drawn icons rise above the bottom strip; nothing on the way may clip them. */
.navbar, .navtab, .navcta { overflow: visible; }


/* ================================================================ roster toolbar
   One row: grade tabs left, 필터 / 회수 / count right. The bottom bar is gone inside screens, so
   the cards take the height back. */
.roster-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 104px;
    padding: 0 60px 0 70px;
}

.roster-bar__tabs { flex-direction: row; align-items: center; }

.roster-tab {
    width: 118px;
    height: 72px;
    margin-right: 8px;
    font-size: 34px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

.roster-bar__btn {
    width: 230px;
    height: 76px;
    margin-left: 14px;
    padding: 0 20px;
    font-size: 32px;
}

.roster-bar__count {
    margin-left: 26px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(30, 44, 70);
}

.roster .card { height: 336px; }

.filter-sheet__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 26px;
}


/* ================================================================ battle result (reference: 전투 완료)
   Over the field, not in a window. */
.bresult {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 20, 40, 0.55);
}

.bresult__title {
    position: absolute;
    left: 80px;
    top: 40px;
    font-size: 120px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 222, 60);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(120, 70, 0);
    rotate: -3deg;
}

.bresult__title--lose { color: rgb(200, 214, 232); -unity-text-outline-color: rgb(40, 54, 84); }

.bresult__info {
    position: absolute;
    right: 70px;
    top: 50px;
    width: 700px;
    padding: 20px 40px 22px 50px;
}

.bresult__line { flex-direction: row; align-items: center; justify-content: space-between; }
.bresult__phase { font-size: 40px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); }
.bresult__time { font-size: 30px; color: rgb(180, 220, 250); }
.bresult__gains { flex-direction: row; margin-top: 12px; }
.bresult__gain { flex-direction: row; align-items: center; margin-right: 40px; }
.bresult__gain-icon { width: 60px; height: 60px; -unity-background-scale-mode: scale-to-fit; margin-right: 10px; }
.bresult__gain-glyph { font-size: 50px; color: rgb(255, 214, 58); margin-right: 10px; }
.bresult__gain-text { font-size: 40px; -unity-font-style: bold; color: rgb(255, 255, 255); }

.bresult__squad {
    position: absolute;
    left: 80px;
    bottom: 60px;
}

.bresult__squad-label {
    font-size: 30px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 90, 110);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.bresult__strip { flex-direction: row; }
.bresult__mini { width: 150px; height: 150px; margin-right: 16px; }

.bresult__acts {
    position: absolute;
    right: 70px;
    bottom: 60px;
    flex-direction: row;
}

.bresult__btn { width: 380px; height: 116px; margin-left: 24px; font-size: 44px; }


/* 편성: FRONT / MIDDLE / BACK over a coloured role plate, above the name band. */
.pslot__tag {
    flex-shrink: 0;
    height: 40px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 44, 80);
}

.pslot__tag-pos {
    width: 52%;
    font-size: 22px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.pslot__tag-role {
    flex-grow: 1;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.pslot__stars { bottom: 144px; }


/* ================================================================ 등 뒤 시트 (BackSheet.cs)
   Behind the portrait, leaning out past one shoulder; top edge below the head. */
.backsheet { position: absolute; }

/* the halo sheet is square (BackSheet.Halo): beside the head, out past one shoulder */
.home__sheet { top: 4%; width: 22%; height: 46%; }
.home__sheet.backsheet--left { left: 18%; }
.home__sheet.backsheet--right { left: 44%; }

.kit__sheets { flex-direction: row; justify-content: space-between; margin-top: 30px; }
.kit__sheet-cell { width: 420px; height: 600px; align-items: center; }
.kit__sheet { left: 10px; right: 10px; top: 0; bottom: 70px; }
.kit__sheet-label { position: absolute; bottom: 10px; font-size: 32px; -unity-font-style: bold; color: rgb(30, 44, 70); }


/* ================================================================ battle HUD (reference: 전투)
   No white band: the skill cards float bottom-right over the field with the cost gauge under
   them; the toggles are glass plates on a glass strip top-right; the office upgrades go
   bottom-left as glass tiles. */
.battle__hud { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 8px 20px 8px 40px; height: 88px; }
.battle__wave { color: rgb(22, 38, 63); }
.battle__wave--enraged { color: rgb(220, 60, 60); }
.forecast { color: rgb(60, 80, 110); }
.auto-toggle { height: 60px; min-width: 120px; margin-left: 10px; padding: 0 18px; font-size: 26px; }
.auto-toggle--on.plate--glass { color: rgb(10, 120, 180); }

.ex-bar {
    position: absolute;
    right: 50px;
    bottom: 96px;
    height: 200px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ex-button {
    width: 170px;
    height: 196px;
    margin-left: 14px;
    margin-right: 0;
    border-width: 0;
    border-radius: 12px;
    background-color: rgb(206, 222, 238);
    overflow: visible;
}

.ex-button--ready { scale: 1.06 1.06; }

.ex-button__art { border-radius: 12px; overflow: hidden; background-position-y: top; }

.ex-button__cost {
    position: absolute;
    left: -14px;
    top: -14px;
    width: 58px;
    height: 58px;
    align-items: center;
    justify-content: center;
}

.ex-button__label {
    width: auto;
    font-size: 30px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.ex-cost-bar {
    position: absolute;
    right: 50px;
    bottom: 22px;
    width: 940px;
    height: 70px;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

.ex-cost-disc {
    position: absolute;
    left: 0;
    top: 0;
    width: 70px;
    height: 70px;
    align-items: center;
    justify-content: center;
}

.ex-cost-disc__word { font-size: 14px; -unity-font-style: bold; color: rgb(180, 220, 250); margin-bottom: -6px; }
.ex-cost-text {
    position: relative;
    left: 0;
    font-size: 34px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 255, 255);
}

.upgrades { left: 50px; right: auto; bottom: 22px; height: 130px; }
.upgrade {
    width: 230px;
    background-color: rgba(255, 255, 255, 0.82);
    border-width: 2px;
    border-color: rgb(186, 208, 228);
    border-bottom-width: 2px;
    border-radius: 12px;
}
.upgrade__name { color: rgb(60, 80, 110); }
.upgrade--ready { background-color: rgba(96, 226, 255, 0.95); border-color: rgb(20, 150, 210); }
.upgrade--ready .upgrade__name { color: rgb(22, 38, 63); }

/* Ink on the battle HUD: dark on the glass, everywhere. */
.battle__hud .auto-toggle { color: rgb(22, 38, 63); }
.battle__hud .auto-toggle--on { color: rgb(0, 130, 200); }
.upgrade .upgrade__level { color: rgb(22, 38, 63); }
.upgrade .upgrade__cost { color: rgb(190, 130, 0); }
.upgrade--ready .upgrade__cost { color: rgb(22, 38, 63); }


/* The transparent standing art: full height, no box, feet at the floor line. */
/* The reference's lobby shows the student large, from the thighs up: the cut-out is scaled to
   almost twice the screen's height and its lower half runs off the bottom edge. */
.home__char-container--standing {
    left: 14%;
    width: 54%;
    top: 3%;
    bottom: -92%;
    height: auto;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}


/* ================================================================ hero page (reference: 학생)
   A page under the top bar: figure and sheet on the left, name plate bottom-left, a white panel
   with folder tabs on the right. */
.overlay--page {
    top: 120px;
    background-color: rgba(0, 0, 0, 0);
    align-items: stretch;
    justify-content: flex-start;
}

.overlay--page .detail {
    width: 100%;
    max-width: none;
    height: 100%;
    padding: 0;
}

.overlay--page .detail__close { display: none; }

.overlay--page .detail__art {
    width: 46%;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    overflow: visible;
}

.detail__figure {
    position: absolute;
    left: 14%;
    right: 6%;
    top: 3%;
    bottom: 10%;
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 18px;
}

.detail__figure--standing {
    left: 6%;
    right: 0;
    top: -2%;
    bottom: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}

.detail__sheet { top: 2%; width: 42%; height: 44%; }
.detail__sheet.backsheet--left { left: 6%; }
.detail__sheet.backsheet--right { left: 50%; }

.overlay--page .dplate {
    left: 36px;
    right: auto;
    bottom: 36px;
    width: 680px;
    padding: 0 40px 18px 30px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
}

.overlay--page .dplate__top { height: 42px; padding-left: 24px; }
.overlay--page .dplate__dept { color: rgb(22, 38, 63); -unity-font-style: bold; font-size: 24px; }
.overlay--page .dplate__namerow { margin-top: 10px; padding-left: 20px; }
.overlay--page .dplate__name { font-size: 76px; -unity-font-style: bold-and-italic; }
.overlay--page .dplate__meta { padding-left: 20px; }
.overlay--page .dplate__lv { -unity-font-style: bold-and-italic; font-size: 34px; }

.overlay--page .detail__right {
    margin: 10px 50px 30px 10px;
    background-color: rgba(0, 0, 0, 0);
}

.overlay--page .dtabs { padding: 0 20px; height: 70px; }
.overlay--page .dtab { height: 70px; margin-right: 6px; font-size: 32px; -unity-font-style: bold; }
.overlay--page .detail__body { padding: 20px 30px; }
.overlay--page .detail__foot { border-top-width: 0; padding: 10px 30px 24px 30px; }

.dtab__label { font-size: 30px; -unity-font-style: bold; color: rgb(92, 112, 140); margin-right: 18px; }
.dtab--on .dtab__label { color: rgb(22, 38, 63); }


/* ================================================================ 편성: standing line-up
   Reference: 부대 편성 — members stand on the floor, a shadow under each, white plate below. */
.pslot--stand {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    overflow: visible;
}

.pslot--stand .pslot__art {
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

.pslot__figure {
    position: absolute;
    left: -24px;
    right: -24px;
    top: 0;
    bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}

.pslot--stand .pslot__tag { margin: 8px 6px 0 6px; background-color: rgba(0, 0, 0, 0); }

.pslot--stand .pslot__plate {
    margin: 6px 6px 0 6px;
    padding: 10px 14px 10px 10px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
}

.pslot__row { flex-direction: row; align-items: center; }

.pslot__grade {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.pslot__grade-text { font-size: 26px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); }
.pslot__lines { flex-grow: 1; min-width: 0; }
.pslot__lv { font-size: 20px; -unity-font-style: bold-and-italic; color: rgb(70, 90, 120); }

.pslot--stand .pslot__name {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(22, 38, 63);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pslot__stars-inline {
    position: absolute;
    right: 12px;
    top: 8px;
    font-size: 18px;
    color: rgb(255, 190, 40);
}


/* ================================================================ 3D field (World/BattleWorld)
   The stage's background is the 3D render; fighter views are only HP bars over each head. */
.battle__stage--3d {
    background-color: rgb(220, 236, 255);
    -unity-background-scale-mode: stretch-to-fill;
}

.battle__stage--3d .mote { display: none; }
.battle__stage--3d .shot { display: none; }

.fighter--3d {
    width: 120px;
    height: 30px;
    align-items: center;
}

.fighter--3d .fighter__body,
.fighter--3d .fighter__shadow,
.fighter--3d .fighter__name { display: none; }

.fighter--3d .fighter__hpbar {
    position: relative;
    left: 0;
    top: 0;
    width: 104px;
    height: 12px;
    border-radius: 3px;
    border-width: 2px;
    border-color: rgb(27, 29, 37);
    background-color: rgba(20, 24, 36, 0.7);
}

.fighter--3d.fighter--boss .fighter__hpbar { width: 180px; height: 16px; }
.fighter--3d.fighter--dead { opacity: 0; }


/* ================================================================ battle HUD (reference: 전투)
   Top right: a dark pill (phase · enemies · time) and square glass buttons (speed, AUTO, menu).
   Everything else about the run lives in the menu panel under it. */
.bhud {
    top: 24px;
    right: 40px;
    height: 84px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
}

.bhud__pill {
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding: 0 28px 0 28px;
    margin-right: 12px;
}

.bhud__wave { color: rgb(255, 255, 255); font-size: 26px; margin-right: 22px; }
.bhud .battle__wave--enraged { color: rgb(255, 140, 120); }
.bhud__icon { width: 34px; height: 34px; margin-right: 8px; }
.bhud__num { color: rgb(255, 255, 255); font-size: 30px; -unity-font-style: bold; margin-right: 22px; }
.bhud__time { margin-right: 0; min-width: 84px; }

.bhud__sq {
    width: 84px;
    height: 84px;
    margin: 0 0 0 10px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.bhud__sq-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.bhud__sq-icon { position: absolute; left: 14px; right: 14px; top: 10px; bottom: 26px; }
.bhud__sq-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.bhud__auto .bhud__sq-label { bottom: auto; top: 0; height: 84px; font-size: 22px; -unity-font-style: bold-and-italic; }
.bhud__sq--on .bhud__sq-label { color: rgb(60, 40, 0); }

/* 보스 HP 바, top centre between the kill chip and the phase pill (BattleScreen.DrawBossBar paints
   plate, bar and badge; these place the words on them). Height covers the badge, which stands
   proud of the bar: plate 48 + gap 6 + bar 42, badge 92 centred on the bar. */
.bboss {
    position: absolute;
    top: 20px;
    left: 380px;
    width: 1120px;
    height: 124px;
}
.bboss__plate {
    position: absolute;
    left: 0;
    top: 0;
    width: 600px;
    height: 48px;
    padding-left: 44px;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}
.bboss__lv { color: rgb(255, 210, 60); font-size: 26px; -unity-font-style: bold-and-italic; margin-right: 16px; height: 44px; -unity-text-align: middle-left; }
.bboss__name {
    height: 44px;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    font-size: 26px;        /* 28 needed a 38px line in the 36px the plate leaves */
    -unity-font-style: bold-and-italic;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.bboss__count {
    position: absolute;
    right: 0;
    top: 29px;
    width: 92px;
    height: 92px;
    font-size: 30px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

/* 처리 — the kill counter chip, top left, the same dark glass as the phase pill. */
.bkill {
    position: absolute;
    top: 24px;
    left: 40px;
    height: 64px;
    padding: 0 26px 0 18px;
    flex-direction: row;
    align-items: center;
}
.bkill__icon { width: 44px; height: 44px; margin-right: 10px; }
.bkill__num { color: rgb(255, 255, 255); font-size: 30px; -unity-font-style: bold; }

/* the combo line steps down under the boss bar while one is up */
.combo--low { top: 176px; }

.bmenu {
    position: absolute;
    top: 120px;
    right: 40px;
    width: 880px;
    padding: 0 28px 24px 28px;
}

.bmenu__title {
    height: 64px;
    -unity-text-align: middle-left;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 14px;
}

.bmenu__forecast { position: absolute; right: 28px; top: 16px; color: rgb(200, 220, 245); font-size: 24px; }
.bmenu__row { flex-direction: row; flex-wrap: wrap; }
.bmenu__row .auto-toggle { width: 196px; height: 76px; margin: 0 8px 10px 0; font-size: 24px; color: rgb(22, 38, 63); }
.bmenu__row .auto-toggle--on { color: rgb(0, 120, 200); }
.bmenu__sub { font-size: 24px; -unity-font-style: bold; color: rgb(22, 38, 63); margin: 10px 0 10px 0; }

.bmenu__upgrades {
    position: relative;
    left: 0;
    right: 0;
    bottom: 0;
    height: 130px;
}

.battle--3d .battle-log { display: none; }


/* 편성: the SD row (World/Lineup3D) is this box's background; empty slots match the others. */
.party-slots--sd { -unity-background-scale-mode: stretch-to-fill; }
.party-slots--sd .slot { flex-grow: 0; width: 280px; margin: 0 10px 0 10px; }


/* ================================================================ 모집 (reference: 모집)
   Full-bleed stage: pickup students large on the right, title block left, banner tabs down the
   left edge, 확률 정보 / 모집 포인트 bottom left, the two pulls bottom right. */
.gacha--ba { background-color: rgba(0, 0, 0, 0); }

.gstage { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; }

.gstage__fig {
    position: absolute;
    bottom: -40px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}

.gstage__fig--s { right: 6%; width: 38%; top: 2%; }
.gstage__fig--a { right: 34%; width: 30%; top: 12%; opacity: 0.96; }
.gstage__fig--card { -unity-background-scale-mode: scale-and-crop; border-radius: 24px; bottom: 170px; }

.gstage__block { position: absolute; left: 330px; top: 170px; width: 820px; }
.gstage__kicker { align-self: flex-start; height: 56px; padding: 0 34px; justify-content: center; }
.gstage__kicker-text { color: rgb(255, 255, 255); font-size: 28px; -unity-font-style: bold-and-italic; }
.gstage__title {
    margin-top: 18px;
    font-size: 110px;
    -unity-font-style: bold-and-italic;
    color: rgb(22, 38, 63);
    white-space: nowrap;
}
.gstage__sub { font-size: 40px; -unity-font-style: bold; color: rgb(60, 84, 120); margin-top: -4px; }
.gstage__days { align-self: flex-start; height: 50px; padding: 0 26px; margin-top: 22px; justify-content: center; }
.gstage__days-text { color: rgb(255, 255, 255); font-size: 26px; -unity-font-style: bold; }
.gstage__note { margin-top: 20px; font-size: 26px; color: rgb(70, 90, 120); white-space: normal; }

.gtabs { position: absolute; left: 40px; top: 150px; width: 250px; }
.gtab { height: 150px; margin-bottom: 14px; padding: 12px 18px 16px 12px; flex-direction: column; justify-content: flex-end; }
.gtab__thumb {
    position: absolute; left: 12px; right: 24px; top: 12px; bottom: 50px;
    -unity-background-scale-mode: scale-and-crop; background-position-y: top 12%; border-radius: 8px;
}
.gtab__label { font-size: 26px; -unity-font-style: bold; color: rgb(22, 38, 63); }

.gfoot { position: absolute; left: 330px; bottom: 44px; flex-direction: row; }
.gfoot__btn, .gfoot__points { height: 90px; min-width: 250px; margin-right: 18px; font-size: 28px; color: rgb(22, 38, 63); }
.gfoot__points-text { font-size: 28px; -unity-font-style: bold; color: rgb(22, 38, 63); }

.gpulls { position: absolute; right: 60px; bottom: 36px; left: auto; height: auto; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.gpulls .pull-btn { flex-grow: 0; flex-shrink: 0; flex-basis: auto; width: 470px; height: 130px; margin-left: 24px; font-size: 38px; }

.rates__caption { margin: 20px 0 10px 0; font-size: 24px; color: rgb(70, 90, 120); }


/* ================================================================ 사내 메신저 (reference: MomoTalk)
   One window: pink header, rooms on the left, the conversation in bubbles on the right. */
.mt-screen { padding: 24px 90px 30px 90px; }
.mt { flex-grow: 1; }
.mt__head { height: 92px; flex-direction: row; align-items: center; padding: 0 34px 0 28px; flex-shrink: 0; }
.mt__logo { width: 56px; height: 50px; margin-right: 16px; }
.mt__title { font-size: 38px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); }
.mt__count { font-size: 24px; color: rgb(255, 245, 247); -unity-font-style: bold; }
.mt__cols { flex-direction: row; flex-grow: 1; min-height: 0; }

.mt__list { width: 36%; flex-shrink: 0; border-right-width: 2px; border-right-color: rgb(232, 236, 242); }
.mt-room {
    flex-direction: row;
    align-items: center;
    height: 128px;
    padding: 0 26px 0 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(236, 239, 244);
}
.mt-room--on { background-color: rgb(255, 236, 240); }
.mt-room--locked { opacity: 0.45; }
.mt-room__face {
    width: 88px; height: 88px; border-radius: 44px; margin-right: 20px; flex-shrink: 0;
    background-color: rgb(226, 232, 240);
    -unity-background-scale-mode: scale-and-crop; background-position-y: top 10%;
    border-width: 3px; border-color: rgb(255, 255, 255);
}
.mt-room__text { flex-grow: 1; min-width: 0; }
.mt-room__title { font-size: 30px; -unity-font-style: bold; color: rgb(40, 52, 72); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mt-room__last { font-size: 23px; color: rgb(130, 142, 160); margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mt-room__badge { width: 46px; height: 46px; margin-left: 14px; align-items: center; justify-content: center; flex-shrink: 0; }
.mt-room__badge-text { font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); }

.mt__chat { flex-grow: 1; background-color: rgb(246, 248, 251); border-bottom-right-radius: 18px; }
.mt__chat .unity-scroll-view__content-container { padding: 20px 36px 30px 30px; }
.mt__empty { height: 600px; align-items: center; justify-content: center; }
.mt__empty-text { font-size: 30px; color: rgb(160, 170, 186); }

.mt-chat__head { flex-direction: row; align-items: flex-end; margin-bottom: 18px; }
.mt-chat__title { font-size: 32px; -unity-font-style: bold; color: rgb(40, 52, 72); margin-right: 16px; }
.mt-chat__room { font-size: 22px; color: rgb(140, 150, 168); }

.mt-line { flex-direction: row; align-items: flex-start; margin-bottom: 14px; }
.mt-line--mine { justify-content: flex-end; }
.mt-line--sys { justify-content: center; }
.mt-sys {
    font-size: 21px; color: rgb(110, 122, 140);
    background-color: rgb(228, 233, 240); border-radius: 20px; padding: 6px 22px;
}
.mt-avatar {
    width: 76px; height: 76px; border-radius: 38px; margin-right: 16px; flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop; background-position-y: top 10%;
    background-color: rgb(226, 232, 240);
}
.mt-avatar--blank { background-color: rgba(0, 0, 0, 0); }
.mt-column { max-width: 72%; }
.mt-line--mine .mt-column { align-items: flex-end; }
.mt-who { font-size: 22px; -unity-font-style: bold; color: rgb(60, 72, 92); margin: 2px 0 6px 4px; }
.mt-bubble {
    align-self: flex-start;
    background-color: rgb(76, 90, 110);
    border-radius: 14px;
    border-top-left-radius: 4px;
    padding: 12px 20px;
}
.mt-bubble--mine { align-self: flex-end; background-color: rgb(74, 144, 226); border-top-left-radius: 14px; border-top-right-radius: 4px; }
.mt-bubble__text { font-size: 26px; color: rgb(255, 255, 255); white-space: normal; }

/* EX cards, as the reference has them: always opaque; one you cannot afford yet is dimmed by a
   dark wash over the portrait (not faded into the field), one that is ready lifts and glows. */
.battle--3d .ex-button--spent,
.battle--3d .ex-button--poor { opacity: 1; }
.ex-button__dim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(16, 24, 44, 0.5); display: none; }
.battle--3d .ex-button--poor .ex-button__dim { display: flex; }
/* the part of the card still charging: a navy shutter, not a beige wash */
.battle--3d .ex-button__charge { background-color: rgba(16, 24, 44, 0.55); }
.battle--3d .ex-button--ready { border-color: rgb(255, 214, 70); scale: 1.08 1.08; translate: 0 -8px; }


/* ================================================================ 프롤로그 (reference: 스토리 화면)
   Full-bleed scene, narration box along the bottom, AUTO / 건너뛰기 pills top right. */
.prologue--ba { padding: 0; justify-content: flex-start; align-items: stretch; overflow: hidden; background-color: rgb(6, 8, 14); }
.prologue--ba .prologue__art {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.45s;
}
.prologue--ba .prologue__art--in { opacity: 1; }
.prologue__sheet { position: absolute; }

.pbox { position: absolute; left: 0; right: 0; bottom: 0; height: 36%; padding: 110px 260px 40px 200px; }
.pbox__name { flex-direction: row; align-items: flex-end; }
.pbox__title { font-size: 44px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-right: 22px; }
.pbox__sub { font-size: 28px; -unity-font-style: bold; color: rgb(120, 214, 255); margin-bottom: 4px; }
.pbox__rule { height: 2px; margin: 14px 0 20px 0; width: 70%; }
.pbox__text { font-size: 38px; color: rgb(255, 255, 255); white-space: normal; -unity-text-outline-width: 0; }
.pbox__more { position: absolute; right: 220px; bottom: 56px; width: 26px; height: 18px; }

.prologue__chapter {
    position: absolute; left: 60px; top: 40px;
    font-size: 26px; -unity-font-style: bold-and-italic; color: rgba(255, 255, 255, 0.85);
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}
.prologue__pills { position: absolute; right: 50px; top: 30px; flex-direction: row; }
.prologue__pill {
    height: 64px; min-width: 150px; margin-left: 16px; padding: 0 26px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; justify-content: center; align-items: center;
}
.prologue__pill-text { font-size: 26px; -unity-font-style: bold; color: rgb(30, 46, 76); }


/* ================================================================ speech bubbles (reference: 로비)
   Small, white, rounded, hairline border, a short tail at the speaker. No name, no gauge. */
.home__bubble {
    left: 47%;
    top: 13%;
    right: auto;
    bottom: auto;
    height: auto;
    min-height: 0;
    width: auto;
    max-width: 30%;
    padding: 22px 34px 24px 34px;
    opacity: 0;
    translate: 0 14px;
    transition-property: opacity, translate;
    transition-duration: 0.28s, 0.28s;
}
.home__bubble--in { opacity: 1; translate: 0 0; }
.home__who, .home__bond { display: none; }
.home__speech { font-size: 32px; color: rgb(36, 50, 78); margin-top: 0; -unity-font-style: bold; }

.saybubble {
    padding: 12px 22px;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(176, 200, 226);
    border-radius: 18px;
    color: rgb(36, 50, 78);
    font-size: 24px;
    -unity-font-style: bold;
    overflow: visible;
}
.saybubble__tail {
    position: absolute;
    left: 34px;
    bottom: -10px;
    width: 18px;
    height: 18px;
    background-color: rgb(255, 255, 255);
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(176, 200, 226);
    rotate: 45deg;
}

/* ================================================================ 입사 안내 (reference: 튜토리얼)
   The guide stands large at the left, speaks in the story box; the last step dims all but 모집. */
.guide { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.guide__dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.guide__figure {
    position: absolute; left: 2%; width: 34%; top: 6%; bottom: -80%;
    -unity-background-scale-mode: scale-to-fit; background-position-y: top;
}
.guide__box { padding-left: 38%; padding-right: 400px; }
.guide__rule { background-color: rgba(255, 255, 255, 0.6); width: 60%; }
.guide__skip { position: absolute; right: 50px; top: 130px; }
.overlay--clear { background-color: rgba(0, 0, 0, 0); }


/* BA pager arrows: round, painted (Pages.Round) */
.pager__btn, .pager__btn:hover, .pager__btn:disabled { width: 84px; height: 84px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.qrow__claim { font-size: 22px; }
.qrow__claim.plate--primary { color: rgb(30, 46, 76); }
.qrow__fill { background-color: rgb(78, 196, 247); }

/* COST: the disc was 70px with the word and the number stacked in it, and the word poked out of
   the top of the circle. A bigger disc, off the screen edge, the word tucked inside. */
.battle--3d .ex-cost-bar { height: 92px; bottom: 34px; }
.battle--3d .ex-cost-disc { width: 92px; height: 92px; padding-top: 6px; }
.battle--3d .ex-cost-disc__word { font-size: 15px; margin-bottom: -8px; color: rgb(170, 215, 250); }
.battle--3d .ex-cost-text { font-size: 38px; }
.battle--3d .ex-bar { bottom: 140px; }
/* the bubble is an absolute Label: without a floor on its width it shrank to one glyph per line */
.saybubble { min-width: 300px; max-width: 560px; }

/* EX cut-in (reference: EX 스킬): a slanted band in the character's colour, a big portrait, the
   skill name on a navy slanted plate, a white flash on the way in. */
.cutin__sweep { background-color: rgba(0, 0, 0, 0); top: 8%; bottom: 8%; }
.cutin__art { height: 100%; width: 30%; bottom: 0; top: 0; }
.cutin__flash {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(255, 255, 255, 0.85);
    transition-property: opacity; transition-duration: 0.3s;
}
.cutin__flash--out { opacity: 0; }
.cutin__plate { left: 34%; }
.cutin__nameplate { flex-direction: row; align-items: center; padding: 14px 60px 14px 40px; }
.cutin__ex {
    font-size: 40px; -unity-font-style: bold-and-italic; color: rgb(255, 214, 60); margin-right: 22px;
}
.cutin__skill { font-size: 72px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); }
.cutin__line { margin-top: 12px; margin-left: 30px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.5); }


/* 10연: 5 + 5, grade on every card, the show only for S, a heart sticker for new */
.reveal-grid { width: 80%; }
.reveal-grid__cell { width: 17%; height: 42%; margin: 1% 1.2%; }
.reveal-grid__stars, .reveal-grid__new { display: none; }
.reveal-grid__gtag {
    position: absolute; left: 10%; bottom: 3%; width: 50px; height: 50px;
    align-items: center; justify-content: center;
}
.reveal-grid__gtext { font-size: 30px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); }
.reveal-grid__glabel {
    position: absolute; left: 32%; right: 4%; bottom: 6%; height: 40px;
    font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-left;
    white-space: nowrap; overflow: hidden;
}
.reveal-grid__sfx { position: absolute; left: -12%; right: -12%; top: -8%; bottom: -8%; }
.reveal-grid__heart { position: absolute; left: -6%; top: -6%; width: 64px; height: 60px; }

/* ================================================================ 업무 완료 (reference: Battle Complete)
   No scrim: the squad stands large on the field in the close-up. A big yellow italic title
   top-left, the run's numbers in a thin navy pill top-right, STRIKER / SPECIAL card strips along
   the bottom, a chart pill and a cyan 확인 bottom-right. */
.bresult { background-color: rgba(0, 0, 0, 0); }
.bresult__title { left: 70px; top: 18px; font-size: 96px; rotate: 0deg; -unity-text-outline-width: 4px; }
.bresult__info { position: absolute; right: 60px; top: 24px; width: 760px; height: 62px; padding: 0 30px; flex-direction: row; align-items: center; }
.bresult__line { flex-grow: 1; }
.bresult__phase { font-size: 30px; }
.bresult__time { font-size: 26px; }
.bresult__gains { margin-top: 0; margin-left: 30px; }
.bresult__gain { margin-right: 26px; }
.bresult__gain-icon { width: 40px; height: 40px; }
.bresult__gain-text { font-size: 30px; }
.bresult__squad { left: 60px; bottom: 30px; }
.bresult__squad-label {
    align-self: flex-start;
    font-size: 22px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255);
    background-color: rgb(230, 60, 80);
    padding: 2px 16px; margin-bottom: 8px;
}
.bresult__strip { flex-direction: row; }
.bresult__mini { width: 104px; height: 104px; margin-right: 10px; }
.bresult__acts { right: 60px; bottom: 36px; }
.bresult__btn { width: 320px; height: 96px; margin-left: 20px; font-size: 38px; }   /* 320: "다음 Phase" needs 216px between the slanted caps */
.battle--result .bhud, .battle--result .ex-bar, .battle--result .ex-cost-bar, .battle--result .bmenu { display: none; }


/* ---- 편성: the reference's three bands (temp_images/208908) — 부대 tabs · line-up · icon rail ---- */
.party-tabs { width: 200px; flex-shrink: 0; margin-right: var(--ex-space-3); padding-top: 24px; }
.party-tab {
    height: 84px; margin-bottom: 14px; padding-left: 0; padding-right: 0;
    font-size: 30px; -unity-font-style: bold; color: rgb(52, 74, 110);
    background-color: rgb(238, 244, 250); border-width: 0; border-radius: 8px;
    -unity-text-align: middle-center;
}
.party-tab--on { background-color: rgb(24, 44, 88); color: rgb(255, 255, 255); }
.party-tab:disabled { opacity: 0.6; }
.party-cols__left { width: auto; flex-grow: 1; min-width: 0; min-height: 0; }
.party-cols__left .party-slots { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.party-cols__right { width: 180px; flex-shrink: 0; margin-left: var(--ex-space-3); padding-top: 24px; }
.party-rail--icons { flex-direction: column; flex-wrap: nowrap; justify-content: flex-start; margin-top: 0; }
.party-rail--icons .btn.party-icon {
    width: 150px; height: 150px; margin-bottom: 18px; padding: 0;
    font-size: 20px; white-space: normal; -unity-text-align: middle-center;
    background-color: rgb(246, 250, 254); color: rgb(40, 60, 100); border-radius: 12px;
}
.party-rail--icons .btn.party-icon.btn--primary { background-color: rgb(84, 190, 245); color: rgb(255, 255, 255); }
.party-strip { flex-direction: row; flex-shrink: 0; height: 220px; margin-top: 10px; align-items: stretch; }
.party-strip .section-title { margin-top: 0; height: 44px; padding-top: 0; padding-bottom: 0; }
.power-readout--strip { width: 300px; flex-shrink: 0; margin-right: var(--ex-space-2); justify-content: center; align-items: center; }
.party-strip__panel { flex-grow: 1; flex-basis: 0; margin-right: var(--ex-space-2); margin-bottom: 0; margin-top: 0; padding: 10px 20px; overflow: hidden; }
.party-strip__panel .stat-row { height: 44px; }
.party-strip .section-title { font-size: var(--ex-text-sm); margin-bottom: 4px; }
.party-strip .synergy-line, .party-strip .muted { font-size: var(--ex-text-xs); }

/* ================================================================ label fit (LayoutAudit)
   Unity's default label carries 2px padding and 1px margin top and bottom: 6px of a small box
   that the text then does not get. Every one of these was a glyph or tab label a few px short of
   its own line height — 30-odd audit hits across the roster, the detail page and the tabs. */
.card__grade-label, .card__role-glyph, .dtab__label, .dplate__dept, .plate__label,
.chip__value, .chip__plus, .bboss__name, .bboss__lv, .pslot__tag-pos, .pslot__tag-role, .reveal-grid__gtext {
    padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0;
}
/* the pager sits on the bottom edge: its 84px plates hung 8px off a 70px row */
.pager__btn, .pager__btn:hover, .pager__btn:disabled { height: 70px; }

/* ================================================================ UI round 1 (tools/ui_critique.py vs BA)
   Section headers: Blue Archive heads a block with a short accent bar and dark bold type on the
   glass, not a solid navy strip — the strips made every panel heavy (critique: 16-Detail #2,
   08-Party #1). The navy plate is still the look of titles OUTSIDE panels (modal heads). */
.section-title, .block__title {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(27, 47, 72);
    -unity-font-style: bold;
    border-left-width: 8px;
    border-left-color: rgb(40, 160, 246);
    padding-left: 18px;
    -unity-text-outline-width: 0;
}
.panel > .section-title { margin-left: -12px; margin-right: 0; margin-top: -8px; }
.block__title { height: 44px; font-size: 28px; margin-bottom: 4px; }
.section-title { height: 56px; font-size: 34px; }
.shell--battle #goldChip, .shell--battle #gemChip { display: none; }
.card__lock { position: absolute; left: 50%; width: 64px; margin-left: -32px; bottom: 98px; height: 64px; }   /* above the name band, clear of the face */
.block__title { height: 48px; }
/* the name band lets the art through a little (critique: an opaque block covered a third of it) */
.card__plate { background-color: rgba(20, 34, 62, 0.8); border-top-width: 0; }

/* ================================================================ UI round 2
   The page count as a navy capsule between the arrows (critique: 13-Album #3, 07-Roster #3) —
   the bare "1 / 6" sat on the backdrop and did not read as part of a control. */
.pager__label {
    min-width: 170px;
    height: 56px;
    margin: 0 18px;
    border-radius: 28px;
    background-color: rgb(27, 41, 64);
    color: rgb(255, 255, 255);
    font-size: 30px;
}
.mt__empty-mark { width: 220px; height: 220px; opacity: 0.35; -unity-background-scale-mode: scale-to-fit; margin-bottom: 24px; }
.mt__empty-text { font-size: 34px; -unity-font-style: bold; color: rgb(110, 128, 152); }
.mt__empty-sub { font-size: 24px; color: rgb(140, 156, 178); margin-top: 8px; }
/* the album as cards (critique: 13-Album #1): a white-rimmed card, the name on a navy band inside it */
.album__cell { border-radius: 12px; overflow: hidden; border-width: 3px; border-color: rgb(255, 255, 255); background-color: rgb(30, 44, 70); }
.album__art { border-width: 0; background-color: rgb(226, 236, 246); background-position-y: top 8%; }
.album__name { position: absolute; left: 0; right: 0; bottom: 0; height: 52px; background-color: rgb(24, 38, 66); color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 26px; }
.album__cell--locked .album__art { opacity: 1; }
.album__cell--locked .album__name { color: rgb(150, 166, 190); }
.album__scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.album__lock { position: absolute; left: 50%; width: 72px; margin-left: -36px; top: 38%; height: 72px; }
/* pull buttons: the title on top, the price with the drawn gem under it */
.gpulls .pull-btn { flex-direction: column; justify-content: center; align-items: center; height: 140px; padding-top: 6px; }
.gpulls .pull-btn .plate__label { font-size: 40px; -unity-font-style: bold; }
.pull-btn__cost { flex-direction: row; align-items: center; margin-top: 2px; }
.pull-btn__gem { width: 42px; height: 42px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.pull-btn__price { font-size: 32px; -unity-font-style: bold; color: rgb(43, 67, 92); padding: 0; margin: 0; }
.gpulls__ribbon {
    position: absolute; top: -26px; right: 40px; height: 40px; padding: 0 20px;
    background-color: rgb(21, 42, 66); color: rgb(0, 222, 255); font-size: 22px; -unity-font-style: bold;
    border-radius: 6px; -unity-text-align: middle-center;
}
/* equipment sockets (round 3): a square frame with the part's picture, words beside it */
.kittile { flex-direction: row; align-items: center; padding: 8px; border-radius: 10px; }
.kittile__sock { width: 84px; height: 84px; flex-shrink: 0; border-radius: 10px; border-width: 2px; border-color: rgb(205, 216, 229); background-color: rgb(237, 242, 247); align-items: center; justify-content: center; margin-right: 10px; }
.kittile__pic { width: 70px; height: 70px; -unity-background-scale-mode: scale-to-fit; }
.kittile--empty .kittile__pic { opacity: 0.35; }
.kittile__plus { position: absolute; right: -6px; bottom: -6px; width: 34px; height: 34px; border-radius: 17px; background-color: rgb(40, 160, 246); color: rgb(255, 255, 255); font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-center; padding: 0; margin: 0; }
.kittile__words { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.kittile--empty { background-color: rgba(255, 255, 255, 0.5); border-color: rgb(205, 216, 229); }
/* quest rewards as icon chips (round 3) */
.qrow__rewards { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 14px; }
.rchip { flex-direction: row; align-items: center; height: 48px; padding: 0 12px 0 6px; margin-left: 8px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.85); border-width: 2px; border-color: rgb(205, 218, 232); }
.rchip__icon { width: 38px; height: 38px; -unity-background-scale-mode: scale-to-fit; margin-right: 6px; }
.rchip__amount { font-size: 24px; -unity-font-style: bold; color: rgb(30, 46, 76); padding: 0; margin: 0; }
.qrow__meta { font-size: 22px; -unity-font-style: bold; color: rgb(90, 110, 140); }
/* ten-pull result (round 4): New in yellow italic; 확인 and "10회 더" side by side */
.reveal-grid__new.reveal-grid__new--on { display: flex; top: -40px; left: 6px; font-size: 38px; padding: 0; margin: 0; }
.reveal-foot { flex-direction: row; justify-content: center; }
.reveal-foot__ok { min-width: 420px; height: 110px; font-size: 38px; }
.reveal-foot__again { min-width: 420px; height: 110px; margin-left: 30px; flex-direction: column; justify-content: center; align-items: center; }
.reveal-foot__again .plate__label { font-size: 34px; -unity-font-style: bold; }
/* lobby CTA (round 6): a cyan plate, white italic 업무, the phase under it */
.home__campaign-plate { width: 360px; height: 118px; }
.home__campaign-label { color: rgb(255, 255, 255); font-size: 54px; -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgba(10, 60, 110, 0.6); padding: 0; margin: 0; }
.home__campaign-sub { color: rgb(224, 246, 255); font-size: 20px; -unity-font-style: bold-and-italic; letter-spacing: 2px; padding: 0; margin: -4px 0 0 0; }
/* round 7: the detail plate's stars in the reference's gold */
.dplate__stars { color: rgb(255, 199, 0); font-size: 34px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(120, 76, 0); }

/* ================================================================ battle vs target_3 (Gemini BA mock-up)
   Damage numbers: bold italic, white with a navy edge; crits gold with CRITICAL over them; the
   party's own hurt in a soft red. Combo: big italic on the right, the count under the word. */
.floater { font-size: 56px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(20, 40, 80); -unity-text-align: middle-center; white-space: normal; transform-origin: center; }
.floater--crit { font-size: 76px; color: rgb(255, 214, 60); -unity-text-outline-color: rgb(120, 60, 0); -unity-text-outline-width: 4px; }
.floater--taken { font-size: 46px; color: rgb(255, 150, 150); -unity-text-outline-color: rgb(90, 10, 20); }
.combo { left: auto; right: 70px; top: 230px; font-size: 80px; -unity-font-style: bold-and-italic; -unity-text-align: upper-right; color: rgb(255, 255, 255); -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(20, 40, 80); white-space: normal; }
.combo--low { top: 230px; }
.ex-button__cost { width: 66px; height: 70px; left: -16px; top: -18px; flex-direction: column; }
.ex-button__costword { font-size: 13px; -unity-font-style: bold; color: rgb(120, 220, 255); padding: 0; margin: 4px 0 -4px 0; -unity-text-align: middle-center; }
.ex-button__cost .ex-button__label { background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); font-size: 30px; -unity-font-style: bold-and-italic; padding: 0; margin: 0; }
.ex-cost-words { position: absolute; right: 22px; top: 17px; font-size: 26px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(20, 40, 80); padding: 0; margin: 0; }
/* boss bar vs target_3: the diamond at the left carries xN; the plate starts right of it */
.bboss { left: 340px; width: 1180px; height: 132px; }
.bboss__plate { left: 77px; padding-left: 70px; width: 640px; }
.bboss__count { left: 0; right: auto; top: 4px; width: 124px; height: 124px; font-size: 40px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(10, 30, 70); }

/* ================================================================ lobby vs target_1 (Gemini BA mock-up)
   Glass tiles everywhere: the left menu is a column of tiles with the icon beside a bold word;
   the bottom nav is a row of separate tiles standing on a navy band, the lit one cyan; the
   player plate is glass with the lead's face in a disc; 모집 is one big gold slab. */
.plate { height: 132px; padding-right: 70px; margin-left: 20px; margin-top: 14px; align-items: center; }
.plate__avatar { width: 108px; height: 108px; border-radius: 54px; margin-left: 18px; background-color: rgb(255, 255, 255); padding: 5px; border-width: 2px; border-color: rgb(180, 214, 236); }
.plate__face { flex-grow: 1; border-radius: 50px; overflow: hidden; }
.plate__body { padding-left: 22px; }
.plate__rank { flex-direction: row; align-items: flex-end; width: auto; height: auto; justify-content: flex-start; }
.plate__rank-word { font-size: 28px; color: rgb(30, 46, 76); -unity-font-style: bold; padding: 0; margin: 0 6px 4px 0; }
.plate__rank-num { font-size: 36px; color: rgb(30, 46, 76); -unity-font-style: bold; padding: 0; margin: 0; }
.plate__name { font-size: 44px; color: rgb(22, 36, 64); padding: 0; margin: -4px 0 0 0; }
.plate__sub { display: none; }

.home__icons { left: 60px; top: 190px; width: 300px; flex-direction: column; flex-wrap: nowrap; }
.home__icon { width: 280px; height: 104px; margin-bottom: 18px; flex-direction: row; justify-content: flex-start; padding-left: 26px; }
.home__icon:hover { scale: 1.04 1.04; }
.home__art-icon { width: 80px; height: 80px; }
.home__icon-label { margin: 0 0 0 16px; padding: 0; font-size: 40px; color: rgb(22, 36, 64); -unity-text-outline-width: 0; }

.navbar { height: 190px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; margin: 0; padding-left: 90px; padding-right: 50px; padding-bottom: 14px; align-items: flex-end; }
.navtab { width: 180px; height: 164px; margin-right: 14px; border-radius: 0; justify-content: center; padding-top: 4px; }
.navtab:hover { background-color: rgba(0, 0, 0, 0); scale: 1.04 1.04; }
.navtab--active { background-color: rgba(0, 0, 0, 0); border-bottom-width: 0; }
.navtab__icon.art-icon { width: 100px; height: 100px; margin-top: 0; }
.navtab__label { font-size: 38px; color: rgb(22, 36, 64); -unity-text-outline-width: 0; margin-top: 0; padding: 0; }
.navtab--active .navtab__label { color: rgb(255, 255, 255); -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgba(0, 90, 140, 0.6); }
.navtab__badge { top: 6px; right: 18px; }
.navcta { width: 400px; height: 176px; margin-bottom: 2px; }
.navcta__icon.art-icon { width: 96px; height: 96px; margin-right: 6px; }
.navcta__label { font-size: 78px; -unity-font-style: bold; color: rgb(92, 56, 0); padding: 0; margin: 0; }

.shell--lobby .topbar__btn { width: 104px; height: 96px; margin-left: 14px; font-size: 56px; color: rgb(30, 46, 76); }
.shell--lobby .topbar .chip { height: 80px; }
.chip__rule { display: none; }
.chip__plus { width: 54px; height: 54px; border-radius: 27px; background-color: rgb(46, 196, 240); color: rgb(255, 255, 255); font-size: 40px; margin-left: 6px; border-width: 2px; border-color: rgb(255, 255, 255); }
.topbar__glyph { flex-grow: 1; -unity-text-align: middle-center; padding: 0; margin: 0; }

/* ================================================================ detail vs target_2 (Gemini BA mock-up) */
.bigstats { flex-direction: row; flex-wrap: wrap; padding: 6px 10px 14px 10px; margin-bottom: 8px; border-bottom-width: 2px; border-color: rgba(170, 196, 222, 0.5); }
.bigstat { width: 50%; flex-direction: row; align-items: center; height: 104px; padding-left: 16px; }
.bigstat__icon { font-size: 60px; width: 72px; height: 72px; color: rgb(30, 48, 86); -unity-text-align: middle-center; padding: 0; margin: 0 16px 0 0; }
.bigstat__words { flex-direction: column; }
.bigstat__key { font-size: 22px; color: rgb(70, 88, 118); -unity-font-style: bold; padding: 0; margin: 0; }
.bigstat__val { font-size: 58px; -unity-font-style: bold; color: rgb(22, 36, 64); padding: 0; margin: -8px 0 0 0; }
.minicard--icon { flex-direction: row; flex-wrap: wrap; align-content: center; padding-left: 116px; min-height: 112px; justify-content: center; }
.minicard--icon > Label { width: 100%; }
.minicard__icon { position: absolute; left: 12px; top: 12px; width: 88px; height: 88px; align-items: center; justify-content: center; }
.minicard__glyph { font-size: 56px; color: rgb(120, 224, 255); -unity-text-align: middle-center; padding: 0; margin: 0; }
.minicard__name { font-size: 30px; }
.block--bare { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.kitstrip { justify-content: space-between; }
.kittile { flex-direction: column; align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 4px; width: 24%; }
.kittile--empty { background-color: rgba(0, 0, 0, 0); }
.kittile__sock { width: 132px; height: 132px; margin: 0 0 6px 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.kittile__pic { width: 100px; height: 100px; }
.kittile__plus { right: 0; bottom: 0; }
.kittile__words { align-items: center; flex-grow: 0; }
.kittile__slot { font-size: 22px; -unity-font-style: bold; color: rgb(40, 58, 92); }
.kittile--empty .kittile__name { display: none; }
.detail__acts > .btn--ivory { height: 118px; }
.btn--ivory .plate__label, .btn--ivory { font-size: 42px; -unity-font-style: bold; color: rgb(22, 36, 64); }
.btn--primary-ink .plate__label, .btn--primary-ink { color: rgb(16, 120, 190); }
.minicards { flex-shrink: 0; flex-grow: 0; }
.minicard--icon { flex-direction: column; flex-wrap: nowrap; align-content: flex-start; justify-content: center; height: 120px; min-height: 120px; max-height: 120px; padding: 6px 10px 6px 116px; }
.minicard--icon > Label { width: auto; padding: 0; margin: 0; }
.minicard--icon .minicard__kind { font-size: 20px; }
.minicard--icon .minicard__name { font-size: 30px; }
.minicard--icon .minicard__lv { font-size: 22px; }
.bigstats, .kitstrip, .block--bare { flex-shrink: 0; }

/* battle HUD vs target_3, round 2: bigger gold-rimmed squares with words, the 격파 glass plate, red enemy bars */
.bhud__sq { width: 104px; height: 104px; margin-left: 12px; }
.bhud__sq-icon { left: 20px; right: 20px; top: 12px; bottom: 34px; }
.bhud__sq-label { font-size: 22px; bottom: 8px; padding: 0; margin: 0; }
.bhud__auto .bhud__sq-label { height: 104px; font-size: 28px; }
.bkill { height: 84px; padding: 0 44px 0 30px; top: 22px; }
.bkill__glyph { font-size: 48px; color: rgb(30, 48, 86); margin-right: 12px; padding: 0; }
.bkill__num { color: rgb(22, 36, 64); font-size: 38px; padding: 0; margin: 0; }
.fighter--3d.fighter--monster .fighter__hpfill { background-color: rgb(238, 88, 62); }
.fighter--3d.fighter--hero .fighter__hpfill { background-color: rgb(118, 214, 72); }

.bboss { left: 430px; }
.bigstat__key { font-size: 26px; }
.kittile__sock { background-color: rgb(232, 240, 248); border-radius: 8px; }

/* ================================================================ UI round 9 (ui_critique vs BA) */
/* the fight: no top band, the HUD owns the top edge */
.shell--battle .topbar { display: none; }
.bmenu__leave { height: 76px; margin: 10px 0 6px 0; font-size: 28px; -unity-font-style: bold; }
/* tabs: white type on the lit one */
.dtab--on .dtab__label { color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 80, 130, 0.5); }
.dtab__label { color: rgb(70, 92, 124); }
/* party power on its plate */
.power-readout--strip { padding-left: 34px; align-items: flex-start; }
.power-readout__value { color: rgb(255, 255, 255); font-size: 58px; -unity-font-style: bold-and-italic; padding: 0; margin: 0; }
.power-readout__label { color: rgb(160, 186, 220); font-size: 22px; -unity-font-style: bold; padding: 0; margin: -4px 0 0 0; }
/* quests: each row its own card, a thicker bar */
.qrow { height: 84px; margin-bottom: 10px; padding: 0 14px; border-radius: 10px; border-width: 1.5px; border-color: rgb(214, 226, 238); border-bottom-width: 3px; border-bottom-color: rgb(196, 212, 228); background-color: rgba(255, 255, 255, 0.94); }
.qrow__track { height: 12px; border-radius: 6px; margin-top: 7px; background-color: rgb(226, 236, 245); }
.qrow__fill { border-radius: 6px; background-color: rgb(40, 190, 245); }
/* attendance: day cards */
.stamp-day { height: 150px; border-radius: 10px; border-width: 2px; border-color: rgb(210, 222, 236); background-color: rgb(244, 248, 252); align-items: center; justify-content: space-between; padding: 10px 0 10px 0; margin-right: 6px; }
.stamp-day--today { border-width: 4px; border-color: rgb(255, 204, 40); background-color: rgb(255, 255, 255); }
.stamp-day--on { background-color: rgb(232, 238, 245); }
.stamp-day__n { font-size: 22px; -unity-font-style: bold; color: rgb(98, 117, 138); padding: 0; margin: 0; }
.stamp-day__icon { width: 52px; height: 52px; -unity-background-scale-mode: scale-to-fit; }
.stamp-day__gems { font-size: 24px; -unity-font-style: bold; color: rgb(30, 40, 55); padding: 0; margin: 0; }
.stamp-day__today { position: absolute; top: -16px; left: 10px; right: 10px; height: 28px; border-radius: 6px; background-color: rgb(255, 204, 40); color: rgb(30, 40, 55); font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center; padding: 0; margin: 0; }
.stamp-day__mark { position: absolute; left: 6px; right: 6px; top: 44px; height: 50px; border-width: 3px; border-color: rgba(214, 48, 48, 0.85); border-radius: 25px; color: rgba(214, 48, 48, 0.9); font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; rotate: -14deg; background-color: rgba(255, 255, 255, 0.4); padding: 0; margin: 0; }
.power-readout--strip { justify-content: center; height: auto; overflow: visible; }
.power-readout--strip .power-readout__value { -unity-text-align: middle-left; }
.power-readout--strip { flex-direction: column; justify-content: center; align-items: flex-start; }

/* ================================================================ UI round 10 */
/* growth rows: icon, words, cost slot, button (17-Enhance #1) */
.skin-row { align-items: center; }
.skin-row__icon { width: 76px; height: 76px; flex-shrink: 0; margin-right: 16px; -unity-background-scale-mode: scale-to-fit; }
.cost-slot { flex-direction: column; align-items: center; flex-shrink: 0; margin: 0 14px; }
.cost-slot__box { width: 64px; height: 64px; border-radius: 10px; border-width: 2px; border-color: rgb(192, 211, 229); background-color: rgb(238, 244, 250); align-items: center; justify-content: center; }
.cost-slot__icon { width: 48px; height: 48px; -unity-background-scale-mode: scale-to-fit; }
.cost-slot__n { font-size: 18px; -unity-font-style: bold; color: rgb(45, 62, 86); padding: 0; margin: 4px 0 0 0; }
.cost-slot__n--short { color: rgb(236, 64, 64); }
.skin-row__btn.plate--primary, .skin-row__btn.plate--gold, .skin-row__btn.plate--light { background-color: rgba(0, 0, 0, 0); border-width: 0; min-width: 150px; height: 64px; font-size: 24px; -unity-font-style: bold; color: rgb(22, 38, 63); }
.skin-row__btn.plate--off { background-color: rgba(0, 0, 0, 0); border-width: 0; color: rgb(150, 162, 178); }
/* 10-pull: the S-floor count as a navy bubble above the button, not tucked behind it (09-Gacha #1) */
.gpulls .pull-btn { overflow: visible; }
.gpulls__ribbon { top: -54px; right: 30px; height: 44px; padding: 0 22px; border-radius: 22px; border-width: 2px; border-color: rgb(40, 80, 130); font-size: 22px; }

/* roster: one vertical scroll instead of pages (07-Roster #2) */
.roster-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.roster-scroll > .unity-scroll-view__content-viewport { flex-grow: 1; }
.roster-scroll .roster-grid { flex-grow: 0; padding-bottom: 40px; }
.roster-scroll .unity-scroller--vertical { width: 12px; }
.roster-scroll .unity-scroller__low-button, .roster-scroll .unity-scroller__high-button { display: none; }
.roster-scroll .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.25); border-width: 0; border-radius: 6px; }
.roster-scroll .unity-base-slider__dragger { background-color: rgb(43, 91, 136); border-width: 0; border-radius: 6px; }
.roster-empty { -unity-text-align: middle-center; font-size: 30px; color: rgb(90, 110, 140); height: 80px; }
.qs-title__note { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; }

/* messenger (12-Story): header sub-label and reward pill, room rows with a chapter label, ring, lock */
.mt__title-en { font-size: 18px; -unity-font-style: bold; color: rgb(255, 196, 208); letter-spacing: 2px; margin-left: 16px; padding: 0; }
.mt__pill { flex-direction: row; align-items: center; height: 50px; padding: 0 20px; border-radius: 25px; background-color: rgba(0, 0, 0, 0.22); }
.mt__pill-text { font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); padding: 0; margin: 0; }
.mt__pill-rule { width: 2px; height: 26px; background-color: rgba(255, 255, 255, 0.4); margin: 0 14px; }
.mt__pill-icon { width: 34px; height: 34px; -unity-background-scale-mode: scale-to-fit; margin-right: 6px; }
.mt__pill-gems { font-size: 24px; -unity-font-style: bold; color: rgb(255, 230, 0); padding: 0; margin: 0; }
.mt__count { display: none; }
.mt-room__face { border-width: 3px; border-color: rgb(226, 232, 240); }
.mt-room__lock { position: absolute; left: 22%; top: 22%; width: 56%; height: 56%; }
.mt-room__chapter { font-size: 18px; -unity-font-style: bold; color: rgb(0, 163, 255); padding: 0; margin: 0 0 2px 0; }
.mt-room__title { font-size: 28px; color: rgb(40, 48, 63); }
.mt-room__cond { align-self: flex-start; font-size: 18px; color: rgb(113, 128, 150); background-color: rgb(241, 244, 247); border-radius: 6px; padding: 2px 10px; margin-top: 4px; }
.mt-room--locked { opacity: 0.75; }
.mt-room--locked .mt-room__title { color: rgb(150, 160, 176); }

.mt-room { height: 132px; padding-top: 6px; padding-bottom: 6px; }
/* gacha banner tab docked to the left edge (09-Gacha #2) */
.gtabs { left: 0; top: 150px; width: 330px; }
.gtab { height: 124px; padding: 0 30px 0 26px; flex-direction: row; align-items: center; justify-content: flex-start; }
.gtab__thumb { width: 92px; height: 92px; border-radius: 46px; border-width: 3px; border-color: rgb(255, 255, 255); flex-shrink: 0; margin-right: 14px; position: relative; left: 0; top: 0; }
.gtab__words { flex-direction: column; }
.gtab__en { font-size: 16px; -unity-font-style: bold; color: rgb(46, 135, 246); letter-spacing: 2px; padding: 0; margin: 0; }
.gtab__label { font-size: 28px; color: rgb(28, 41, 56); padding: 0; margin: 0; }
.gtab__thumb { right: auto; bottom: auto; }
.gtabs { width: 290px; }

/* party slot: tag and plate one card (08-Party #3) */
.pslot--stand .pslot__plate { margin: 0; }
.pslot__tag { margin: 0; }
.pslot--stand .pslot__name { font-size: 26px; -unity-font-style: bold; color: rgb(30, 43, 55); }

.arow__claim { flex-direction: row; align-items: center; justify-content: center; }
.arow__gem { width: 36px; height: 36px; -unity-background-scale-mode: scale-to-fit; margin-right: 6px; }
.arow__amount { font-size: 26px; -unity-font-style: bold; padding: 0; margin: 0; }
.arow__claim:disabled .arow__gem { opacity: 0.4; }

/* ================================================================ UI round 13 */
/* ten-pull: the name inside the card's band beside the grade, the grade word small above it,
   New as a ribbon locked to the top-left corner (21-Pull10 #1, #2) */
.reveal-grid__name { bottom: 5%; left: 34%; right: 5%; height: 36px; color: rgb(255, 255, 255); font-size: 24px; -unity-text-align: middle-left; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(10, 20, 40, 0.5); padding: 0; margin: 0; }
.reveal-grid__glabel { bottom: 13%; height: 24px; font-size: 15px; color: rgba(255, 255, 255, 0.8); letter-spacing: 1px; }
.reveal-grid__new.reveal-grid__new--on { top: 4%; left: -3%; width: 92px; height: 34px; font-size: 20px; -unity-font-style: bold-and-italic; color: rgb(30, 30, 40); background-color: rgb(255, 222, 40); border-width: 2px; border-color: rgb(255, 255, 255); -unity-text-align: middle-center; rotate: -8deg; letter-spacing: 1px; }
/* battle numbers: heavier — a thick navy edge and a hard drop under it (07-Fight1 #3) */
.floater { -unity-text-outline-width: 5px; text-shadow: 0 5px 0 rgba(10, 28, 64, 0.85); font-size: 60px; }
.floater--crit { -unity-text-outline-width: 6px; text-shadow: 0 6px 0 rgba(110, 50, 0, 0.9); font-size: 82px; }
.floater--taken { -unity-text-outline-width: 4px; text-shadow: 0 4px 0 rgba(80, 10, 20, 0.85); }
.combo { -unity-text-outline-width: 5px; text-shadow: 0 6px 0 rgba(10, 28, 64, 0.8); font-size: 90px; }
