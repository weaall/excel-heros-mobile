/* Excel Heroes — runtime styling for a portrait phone.

   The layout is Excel for Android, not desktop Excel scaled down. The phone app has no ribbon
   above the grid: a slim green app bar, then column letters, then the sheet, and every control
   along the bottom where a thumb reaches. Sizes are in the 1080x1920 reference the PanelSettings
   uses, so 40px here is roughly 15dp on a real 1080-wide phone — body text sits at 40-44px and
   anything tappable is at least 130px tall (~48dp). */

/* ---------------------------------------------------------------- shell */

.root {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    color: rgb(34, 34, 34);
    font-size: 40px;
}

.spacer { flex-grow: 1; }
.hidden { display: none; }

/* ---------------------------------------------------------------- app bar */

.appbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 112px;
    padding-left: 24px;
    padding-right: 12px;
    background-color: rgb(33, 115, 70);
}

.app-icon {
    width: 56px;
    height: 56px;
    -unity-text-align: middle-center;
    background-color: rgb(255, 255, 255);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 6px;
    margin-right: 18px;
}

.appbar__title {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 38px;
    -unity-text-align: middle-center;
}
.appbar__save { color: rgba(255, 255, 255, 0.85); font-size: 30px; margin-right: 10px; }

.appbar__btn {
    width: 84px;
    height: 84px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 40px;
}

.appbar__btn:hover { background-color: rgba(255, 255, 255, 0.18); }

/* ---------------------------------------------------------------- worksheet frame */

/* Column letters and row numbers are the whole disguise once the ribbon is gone — they are what a
   passer-by reads before anything else, so they stay visible on every sheet. */
.ws-cols {
    flex-direction: row;
    flex-shrink: 0;
    height: 62px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(191, 191, 191);
}

.ws-corner {
    width: 74px;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(140, 140, 140);
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.ws-col {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 30px;
    color: rgb(70, 70, 70);
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.sheet-row { flex-direction: row; flex-grow: 1; min-height: 0; }

.ws-rows {
    width: 74px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.ws-row-num {
    height: 96px;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(120, 120, 120);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.sheet {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/UI/cell_rule.png");
    background-repeat: repeat;
    background-size: 96px 96px;
}

.screen { flex-grow: 1; overflow: hidden; }

.screen-body {
    flex-grow: 1;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 28px;
    padding-right: 28px;
}

/* ---------------------------------------------------------------- ribbon (bottom sheet) */

/* Tapping 홈 ▲ slides this up over the grid, the way the phone app does. It is not resident
   chrome — on a phone the ribbon is a thing you summon, not a thing you look past. */
.ribbon {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    flex-wrap: wrap;
    min-height: 168px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-top-color: rgb(191, 191, 191);
}

.rb-btn {
    height: 136px;
    min-width: 200px;
    margin-right: 12px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    border-radius: 6px;
    color: rgb(34, 34, 34);
    font-size: 34px;
}

.rb-btn:hover { background-color: rgb(226, 239, 218); }
.rb-btn:disabled { opacity: 0.45; }
.rb-btn__icon { font-size: 44px; color: rgb(33, 115, 70); }
.rb-btn__sub { font-size: 28px; color: rgb(107, 107, 107); }

.rb-sep {
    width: 1px;
    height: 104px;
    margin-left: 8px;
    margin-right: 14px;
    background-color: rgb(212, 212, 212);
}

/* ---------------------------------------------------------------- formula bar */

.formula-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 96px;
    background-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-top-color: rgb(212, 212, 212);
}

.name-box {
    -unity-text-align: middle-right;
    font-size: 26px;
    color: rgb(150, 150, 150);
    margin-right: 10px;
}

.formula-expand {
    width: 70px;
    -unity-text-align: middle-center;
    font-size: 30px;
    color: rgb(107, 107, 107);
}

.fx {
    width: 84px;
    -unity-text-align: middle-center;
    font-size: 32px;
    color: rgb(107, 107, 107);
    -unity-font-style: italic;
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.formula {
    flex-grow: 1;
    padding-left: 20px;
    font-size: 30px;
    color: rgb(34, 34, 34);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------------------------------------------------------------- sheet tabs */

/* The sheet tabs are the game's navigation, so unlike the real app they stay put rather than
   hiding behind a sheet icon — and they sit low, inside thumb reach. */
.sheet-tabs-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 118px;
    background-color: rgb(247, 247, 247);
    border-top-width: 1px;
    border-top-color: rgb(212, 212, 212);
}

.sheet-tabs-scroll { flex-grow: 1; height: 118px; }

.sheet-list-btn, .sheet-add-btn {
    width: 92px;
    height: 118px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(107, 107, 107);
    font-size: 36px;
}

.sheet-tabs { flex-direction: row; align-items: center; height: 118px; }

.sheet-tab {
    height: 118px;
    flex-shrink: 0;
    white-space: nowrap;
    padding-left: 30px;
    padding-right: 30px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(107, 107, 107);
    font-size: 33px;
}

.sheet-tab--active {
    background-color: rgb(255, 255, 255);
    color: rgb(24, 92, 55);
    -unity-font-style: bold;
    border-bottom-width: 5px;
    border-bottom-color: rgb(24, 92, 55);
}

.sheet-tab__badge {
    position: absolute;
    top: 14px;
    right: 10px;
    min-width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(196, 43, 28);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- command bar */

.commandbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 92px;
    padding-left: 12px;
    padding-right: 20px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-top-color: rgb(191, 191, 191);
}

.cmd-tab {
    height: 84px;
    min-width: 168px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    font-size: 34px;
}

.status-text { font-size: 26px; color: rgb(107, 107, 107); margin-left: 18px; }

.cell-stat { flex-direction: row; align-items: center; margin-left: 28px; }
.cell-stat__icon { font-size: 27px; margin-right: 10px; color: rgb(128, 128, 128); }
.cell-stat__value { font-size: 29px; color: rgb(70, 70, 70); }

#gemChip .cell-stat__value { color: rgb(70, 70, 70); }
#goldChip .cell-stat__value { color: rgb(70, 70, 70); }

/* ---------------------------------------------------------------- overlay */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
}

/* ---------------------------------------------------------------- sheet furniture */

.sheet-head {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 28px;
    padding-right: 28px;
    background-color: rgb(243, 243, 243);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.sheet-head__stat { font-size: 36px; -unity-font-style: bold; margin-right: 28px; }
.sheet-head .muted { font-size: 28px; white-space: normal; }

/* ---------------------------------------------------------------- generic pieces */

.panel {
    flex-shrink: 0;
    background-color: rgb(250, 250, 250);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    padding: 32px;
    margin-bottom: 26px;
}

.section-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(107, 107, 107);
    margin-bottom: 16px;
}

.muted { color: rgb(128, 128, 128); white-space: normal; }
.hidden { display: none; }

.btn {
    height: 141px;
    background-color: rgb(238, 238, 238);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(34, 34, 34);
    font-size: 45px;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.btn:hover { background-color: rgb(226, 239, 218); }
.btn:disabled { opacity: 0.4; }

.btn--primary {
    background-color: rgb(150, 112, 8);
    border-color: rgb(176, 132, 10);
    color: rgb(253, 246, 227);
}

.btn--primary:hover { background-color: rgb(24, 92, 55); }

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(191, 191, 191);
}

/* ---------------------------------------------------------------- home */

.home { flex-grow: 1; }

.home__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* stacked on the base art so a motion frame can cross-fade in */
.home__art-motion {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 0.9s;
}

.home__art-motion--on { opacity: 1; }

.home__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 992px;
    background-color: rgba(255, 255, 255, 0.62);
}

.home__strip {
    position: absolute;
    left: 32px;
    right: 32px;
    top: 26px;
    flex-direction: row;
    justify-content: space-between;
}

.home__stat {
    flex-grow: 1;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.72);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.6);
}

.home__stat-value { font-size: 48px; -unity-font-style: bold; color: rgb(176, 132, 10); }
.home__stat-key { font-size: 30px; color: rgb(107, 107, 107); }

.home__bubble {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 384px;
    padding: 32px;
    background-color: rgba(255, 255, 255, 0.82);
    border-radius: 29px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.7);
}

.home__who { font-size: 38px; color: rgb(33, 115, 70); -unity-font-style: bold; }

.home__speech {
    font-size: 43px;
    white-space: normal;
    margin-top: 13px;
    color: rgb(34, 34, 34);
}

.home__bond { margin-top: 26px; }
.home__bond-level { font-size: 32px; color: rgb(200, 60, 110); }

.home__bond-track {
    height: 16px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    overflow: hidden;
}

.home__bond-fill { height: 100%; background-color: rgb(200, 60, 110); }

.home__actions {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
    flex-direction: row;
}

.home__actions .btn { flex-grow: 1; margin-left: 8px; margin-right: 8px; }

/* ---------------------------------------------------------------- pickup banner */

.pickup {
    flex-direction: row;
    width: 100%;
    margin-bottom: 22px;
}

.pickup__card {
    flex-grow: 1;
    height: 480px;
    margin-left: 10px;
    margin-right: 10px;
    border-radius: 26px;
    border-width: 3px;
    overflow: hidden;
    justify-content: flex-end;
}

.pickup__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.pickup__plate {
    background-color: rgba(255, 255, 255, 0.86);
    padding: 13px;
    align-items: center;
}

.pickup__tag {
    position: absolute;
    left: 13px;
    top: 13px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 19px;
    font-size: 29px;
    -unity-font-style: bold;
    background-color: rgb(196, 43, 28);
    color: rgb(120, 40, 70);
}

.pickup__name { font-size: 34px; -unity-font-style: bold; }
.pickup__spark { font-size: 29px; color: rgb(31, 111, 235); }

.pickup__timer {
    font-size: 34px;
    color: rgb(200, 60, 110);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

/* ---------------------------------------------------------------- gacha */

.gacha {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(255, 255, 255);
}

.gacha__banner {
    align-items: center;
    max-width: 100%;
    margin-top: 64px;
    margin-bottom: 32px;
}

.gacha__banner-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(196, 152, 20);
}

.gacha__banner-sub {
    font-size: 35px;
    color: rgb(107, 107, 107);
    margin-top: 10px;
}

.gacha__pity {
    flex-wrap: wrap;
    max-width: 100%;
    flex-direction: row;
    margin-top: 26px;
}

.pity-chip {
    height: 72px;
    flex-direction: row;
    align-items: center;
    margin-left: 13px;
    margin-right: 13px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 26px;
    padding-right: 26px;
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 26px;
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    font-size: 35px;
}

.gacha__actions {
    width: 100%;
    margin-bottom: 38px;
}

.gacha__actions .btn { margin-top: 19px; }

/* ---------------------------------------------------------------- reveal */

.reveal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.94);
    align-items: center;
    justify-content: center;
}

.reveal__card {
    width: 896px;
    height: 1248px;
    border-radius: 32px;
    border-width: 4px;
    overflow: hidden;
    align-items: center;
    justify-content: flex-end;
}

.reveal__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal__plate {
    width: 100%;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.86);
    align-items: center;
}

.reveal__grade {
    font-size: 86px;
    -unity-font-style: bold;
}

.reveal__name {
    font-size: 54px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.reveal__nick { font-size: 35px; color: rgb(107, 107, 107); }

.reveal__line {
    font-size: 35px;
    color: rgb(70, 70, 70);
    margin-top: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.reveal__badge {
    margin-top: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 22px;
    font-size: 32px;
    background-color: rgb(150, 112, 8);
    color: rgb(253, 246, 227);
}

.reveal__hint {
    margin-top: 45px;
    font-size: 38px;
    color: rgb(107, 107, 107);
}

/* --- the tell -------------------------------------------------------------
   A column of light rises before the card resolves, in the rarity's colour.
   This is where the tension of a pull actually lives: by the time the art is
   on screen the player already knows, and the card is the confirmation. */

.tell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.tell__beam {
    width: 144px;
    height: 0;
    opacity: 0;
    transition-duration: 0.45s;
}

.tell__beam--up { height: 1760px; opacity: 0.9; }

.tell__ring {
    position: absolute;
    width: 256px;
    height: 256px;
    border-radius: 128px;
    border-width: 4px;
    opacity: 0;
    scale: 0.3 0.3;
    transition-duration: 0.5s;
}

.tell__ring--out { opacity: 0; scale: 3.4 3.4; }
.tell__ring--in { opacity: 0.95; scale: 1 1; }

.tell__label {
    position: absolute;
    bottom: 480px;
    font-size: 54px;
    -unity-font-style: bold;
    opacity: 0;
    transition-duration: 0.3s;
}

.tell__label--on { opacity: 1; }

/* the card landing */
.reveal__card {
    transition-duration: 0.28s;
}

/* ten-pull summary grid */

.reveal-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.reveal-grid__cell {
    width: 304px;
    height: 422px;
    margin: 10px;
    border-radius: 19px;
    border-width: 3px;
    overflow: hidden;
    justify-content: flex-end;
}

.reveal-grid__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-grid__plate {
    background-color: rgba(255, 255, 255, 0.86);
    padding-top: 6px;
    padding-bottom: 6px;
    align-items: center;
}

.reveal-grid__name { font-size: 29px; }
.reveal-grid__grade { font-size: 32px; -unity-font-style: bold; }

/* ---------------------------------------------------------------- roster */

.roster-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.card {
    width: 32%;
    margin: 0.66%;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: 10px;
    overflow: hidden;
}

/* Portrait proportions, cropped from the TOP — the face identifies the card, and a centred crop
   on a 2:3 illustration lands on the chest. */
.card__art {
    height: 340px;
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top 0;
}

.card__grade {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 46px;
    height: 46px;
    border-radius: 23px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 26px;
    -unity-text-align: middle-center;
}

.card__role {
    position: absolute;
    right: 8px;
    top: 8px;
    padding: 4px 12px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.85);
    color: rgb(70, 70, 70);
    font-size: 21px;
}

.card__stars {
    position: absolute;
    left: 8px;
    bottom: 6px;
    font-size: 22px;
    -unity-font-style: bold;
}

.card__level {
    position: absolute;
    right: 8px;
    bottom: 6px;
    padding: 2px 10px;
    border-radius: 10px;
    background-color: rgba(20, 22, 28, 0.72);
    color: rgb(255, 255, 255);
    font-size: 20px;
}

.card__plate {
    padding: 8px 10px;
    background-color: rgb(248, 248, 248);
    border-top-width: 1px;
    border-top-color: rgb(226, 226, 226);
}

.card__name { font-size: 25px; -unity-font-style: bold; overflow: hidden; }
.card__sub { font-size: 20px; color: rgb(31, 111, 235); }
.card--locked .card__art { opacity: 0.25; }
.card--locked .card__name { color: rgb(150, 150, 150); }

.detail {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
}

.detail__art {
    height: 1152px;
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-to-fit;
}

.detail__scrim { display: none; }

.detail__head {
    padding: 22px 38px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(212, 212, 212);
    border-bottom-color: rgb(212, 212, 212);
}

.detail__name { font-size: 64px; -unity-font-style: bold; }
.detail__nick { font-size: 38px; color: rgb(107, 107, 107); }

.detail__body {
    flex-grow: 1;
    padding: 38px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(238, 238, 238);
}

.stat-row__key { color: rgb(107, 107, 107); font-size: 38px; }
.stat-row__value { font-size: 38px; -unity-font-style: bold; }

.detail__close {
    position: absolute;
    right: 32px;
    top: 32px;
    width: 115px;
    height: 115px;
    border-radius: 58px;
    background-color: rgba(255, 255, 255, 0.8);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(34, 34, 34);
    font-size: 51px;
}

/* ---------------------------------------------------------------- party */

.party-slots {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 26px;
}

.slot {
    width: 304px;
    height: 419px;
    border-radius: 19px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(250, 250, 250);
    overflow: hidden;
    justify-content: flex-end;
}

.slot--empty {
    align-items: center;
    justify-content: center;
    border-color: rgb(226, 239, 218);
}

.slot__plus { font-size: 70px; color: rgb(160, 160, 160); }

.synergy-line {
    font-size: 35px;
    color: rgb(24, 92, 55);
    margin-bottom: 6px;
}

.power-readout {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 13px;
}

.power-readout__value {
    font-size: 83px;
    -unity-font-style: bold;
    color: rgb(176, 132, 10);
}

.power-readout__label {
    font-size: 35px;
    color: rgb(107, 107, 107);
    margin-left: 16px;
    margin-bottom: 16px;
}

/* ---------------------------------------------------------------- battle */

.battle {
    flex-grow: 1;
}

/* The battlefield is the worksheet. A painted landscape was both off-premise and unreadable behind
   16x28 pixel sprites; a tiled cell grid gives them a surface to stand on and survives the disguise,
   because what a passer-by sees is cells. */
/* The battlefield keeps the web build's 2:1 shape — a side-view street band across the top of
   the sheet, with the party's EX buttons below it. The backdrop texture is set from code because
   it is generated per phase. */
.battle__stage {
    flex-shrink: 0;
    height: 540px;
    background-color: rgb(30, 34, 44);
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.fighter {
    position: absolute;
    width: 72px;
    align-items: center;
}

/* Pixel sprites want whole-number scale and no crop. 16x28 at 6x is 96x168, which reads clearly at
   arm's length on a phone and still lines the cast up on one baseline. */
.fighter__body {
    width: 40px;
    height: 70px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.fighter__body--chibi {
    width: 40px;
    height: 70px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Monsters face the party: the tileset draws everything facing right. */
.fighter--monster .fighter__body { scale: -1 1; }

/* Integer multiples only, and the web build's ratio: wave enemies 2x, bosses 3x. */
.fighter--boss { width: 100px; }
.fighter--boss .fighter__body { width: 60px; height: 105px; }
.fighter--boss .fighter__hpbar { width: 84px; }
.fighter--elite .fighter__body { width: 48px; height: 84px; }

.fighter--dead { opacity: 0.25; }

.fighter__hpbar {
    width: 56px;
    height: 8px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 8px;
    overflow: hidden;
}

.fighter__hpfill {
    height: 100%;
    background-color: rgb(33, 115, 70);
}

.fighter--monster .fighter__hpfill { background-color: rgb(196, 43, 28); }

.fighter__name { display: none; }

.floater {
    position: absolute;
    font-size: 45px;
    -unity-font-style: bold;
    color: rgb(150, 112, 8);
}

.floater--heal { color: rgb(24, 92, 55); }
.floater--skill { color: rgb(31, 111, 235); font-size: 38px; }

.battle__hud {
    height: 144px;
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    background-color: rgb(243, 243, 243);
}

.battle__wave {
    flex-grow: 1;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(34, 34, 34);
    transition-duration: 0.3s;
}

/* 야근: overtime has started and the errors are hitting harder every second */
.battle__wave--enraged { color: rgb(196, 43, 28); }

.ex-bar {
    flex-direction: row;
    height: 256px;
    align-items: center;
    justify-content: center;
    background-color: rgb(250, 250, 250);
    padding-top: 16px;
    padding-bottom: 16px;
}

.ex-button {
    width: 211px;
    height: 211px;
    margin-left: 11px;
    margin-right: 11px;
    border-radius: 29px;
    border-width: 3px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(243, 243, 243);
    overflow: hidden;
    justify-content: flex-end;
    align-items: center;
    transition-duration: 0.15s;
}

.ex-button--ready {
    border-color: rgb(176, 132, 10);
    scale: 1.05 1.05;
}

.ex-button--spent { opacity: 0.45; }

.ex-button__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.ex-button__charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(240, 196, 70, 0.28);
}

.ex-button__label {
    width: 100%;
    font-size: 27px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.85);
    padding-top: 5px;
    padding-bottom: 5px;
}

.result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.92);
    align-items: center;
    justify-content: center;
}

.result__title {
    font-size: 115px;
    -unity-font-style: bold;
    margin-bottom: 26px;
}

.result__title--win { color: rgb(176, 132, 10); }
.result__title--lose { color: rgb(196, 43, 28); }

/* ---------------------------------------------------------------- daily */

.stamp__row { flex-direction: row; margin-top: 13px; margin-bottom: 13px; }

.stamp__dot {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    margin-right: 13px;
    background-color: rgb(238, 238, 238);
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    transition-duration: 0.2s;
}

.stamp__dot--on {
    background-color: rgb(33, 115, 70);
    border-color: rgb(196, 152, 20);
}

.quest--done { opacity: 0.5; }

.quest__track {
    height: 19px;
    margin-top: 16px;
    background-color: rgb(238, 238, 238);
    border-radius: 10px;
    overflow: hidden;
}

.quest__fill { height: 100%; background-color: rgb(31, 111, 235); }

.quest__meta { font-size: 34px; color: rgb(107, 107, 107); margin-top: 13px; }

/* a count of claimable rewards, parked on the nav button */
.nav-badge {
    position: absolute;
    right: 29px;
    top: 22px;
    min-width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgb(196, 43, 28);
    color: rgb(120, 40, 70);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 13px;
    padding-right: 13px;
}

/* ---------------------------------------------------------------- onboarding */

.onboard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 45px;
    padding-right: 45px;
}

.onboard__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(243, 243, 243);
}

.onboard__card {
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 32px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.8);
    padding: 48px;
}

.onboard__title {
    font-size: 70px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    margin-bottom: 29px;
}

.onboard__line {
    font-size: 43px;
    white-space: normal;
    margin-bottom: 13px;
    color: rgb(34, 34, 34);
}

.onboard__tip {
    margin-top: 35px;
    margin-bottom: 35px;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 22px;
    border-left-width: 4px;
    border-left-color: rgb(31, 111, 235);
}

.onboard__tip-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
    margin-bottom: 6px;
}

.onboard__card .btn { margin-top: 16px; }

/* ---------------------------------------------------------------- EX cut-in */

/* The signature moment: firing a skill throws the character's own illustration across the
   screen shouting their line. It is the one time the art is at full size during play, and
   it is what makes a skill feel like a person acting rather than a number resolving. */

.cutin {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    overflow: hidden;
}

.cutin__sweep {
    position: absolute;
    left: -120%;
    right: 120%;
    height: 672px;
    background-color: rgba(240, 196, 70, 0.22);
    transition-duration: 0.28s;
}

.cutin__sweep--in { left: -10%; right: -10%; }

.cutin__art {
    position: absolute;
    left: -60%;
    width: 70%;
    height: 672px;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__art--in { left: -4%; opacity: 1; }

.cutin__plate {
    position: absolute;
    right: 38px;
    align-items: flex-end;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__plate--in { opacity: 1; }

.cutin__skill {
    font-size: 74px;
    -unity-font-style: bold;
    color: rgb(150, 112, 8);
}

.cutin__line {
    font-size: 42px;
    color: rgb(34, 34, 34);
    max-width: 896px;
    white-space: normal;
    -unity-text-align: upper-right;
    margin-top: 10px;
}

/* --- hit feedback ------------------------------------------------------- */

.fighter__body { transition-duration: 0.09s; }

/* a lunge towards the enemy on the swing, so an attack has a body behind it */
.fighter--hero .fighter__body--swing { translate: 22px 0; }
.fighter--monster .fighter__body--swing { translate: -22px 0; }

.fighter__body--hurt { scale: 1.18 1.18; }

.fighter--dead {
    opacity: 0.25;
    transition-duration: 0.35s;
    scale: 0.82 0.82;
}

/* ---------------------------------------------------------------- story */

/* episode list */

.ep--locked { opacity: 0.45; }

.ep__cast { flex-direction: row; margin-bottom: 16px; }

.ep__face {
    width: 102px;
    height: 102px;
    border-radius: 51px;
    margin-right: -14px;
    border-width: 2px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
}

/* the log itself */

.chat__header {
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.chat__title { font-size: 54px; -unity-font-style: bold; }

.chat-room {
    font-size: 35px;
    color: rgb(31, 111, 235);
    margin-top: 6px;
}

.chat-line {
    flex-direction: row;
    margin-bottom: 26px;
    align-items: flex-start;
}

.chat-line--mine { justify-content: flex-end; }

.chat-line--sys {
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 29px;
}

.chat-avatar {
    width: 122px;
    height: 122px;
    border-radius: 61px;
    margin-right: 19px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(243, 243, 243);
    -unity-background-scale-mode: scale-and-crop;
}

/* a repeated speaker keeps the indent but drops the face */
.chat-avatar--blank {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.chat-column { flex-shrink: 1; }

.chat-who {
    font-size: 32px;
    color: rgb(107, 107, 107);
    margin-bottom: 8px;
}

.chat-bubble {
    max-width: 1056px;
    padding: 24px;
    border-radius: 26px;
    background-color: rgb(240, 240, 240);
    font-size: 38px;
    white-space: normal;
}

.chat-line--mine .chat-bubble {
    background-color: rgb(226, 239, 218);
    color: rgb(253, 246, 227);
}

.chat-line--sys .chat-bubble {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(107, 107, 107);
    font-size: 34px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- sheet furniture */

/* Every sheet opens with a summary strip, the way a real one opens with a header row. */


.xl-row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.xl-row--head {
    background-color: rgb(243, 243, 243);
    border-bottom-color: rgb(191, 191, 191);
}

.xl-row--head .xl-cell { -unity-font-style: bold; color: rgb(70, 70, 70); }
.xl-row--boss .xl-cell { color: rgb(150, 112, 8); -unity-font-style: bold; }
.xl-row--locked .xl-cell { color: rgb(170, 170, 170); }

.xl-cell {
    flex-shrink: 1;
    width: 230px;
    padding-left: 26px;
    font-size: 35px;
    border-right-width: 1px;
    border-right-color: rgb(226, 226, 226);
}

.xl-cell--wide { flex-grow: 1; flex-basis: 0; min-width: 0; }
.xl-cell--num { -unity-text-align: middle-right; padding-right: 26px; }
.xl-body { flex-grow: 1; }

/* ---------------------------------------------------------------- album */

.album { flex-grow: 1; }
.album__scroll { flex-grow: 1; }

.album__grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 19px;
}

/* Three across on a 1080-wide phone, at the art's own 2:3 — cropping a card to a square is what
   made the thumbnails look mismatched. */
.album__cell {
    width: 33%;
    padding: 10px;
}

.album__art {
    height: 752px;
    background-color: rgb(238, 238, 238);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    -unity-background-scale-mode: scale-and-crop;
}

.album__name {
    font-size: 32px;
    -unity-text-align: middle-center;
    padding-top: 10px;
}

.album__cell--locked .album__art { opacity: 0.18; }
.album__cell--locked .album__name { color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- full-size viewer */

.viewer {
    width: 96%;
    height: 94%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    align-items: center;
}

/* scale-to-fit, not scale-and-crop: the whole point of the viewer is that nothing is cut off. */
.viewer__art {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.viewer__caption { align-items: center; padding: 16px; }
.viewer__name { font-size: 54px; -unity-font-style: bold; color: rgb(33, 115, 70); }
.viewer__nick { font-size: 35px; color: rgb(107, 107, 107); }

.viewer__skins { flex-direction: row; justify-content: center; padding-bottom: 16px; }

.viewer__skin {
    height: 102px;
    min-width: 224px;
    margin: 0 10px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 35px;
}

.viewer__skin--active {
    background-color: rgb(226, 239, 218);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
}

.viewer__close { margin-bottom: 22px; min-width: 320px; }

.detail__skins { flex-direction: row; justify-content: center; padding: 13px; }

.detail__skin {
    height: 90px;
    min-width: 192px;
    margin: 0 8px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 32px;
}

/* ---------------------------------------------------------------- picker */

.picker {
    width: 86%;
    max-height: 80%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: 29px;
}

.picker__list { flex-grow: 1; }

.picker__row {
    flex-direction: row;
    align-items: center;
    min-height: 141px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.picker__face {
    width: 102px;
    height: 102px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
}

.picker__name { font-size: 38px; }

/* ---------------------------------------------------------------- charts */

.charts { flex-grow: 1; }
.charts__scroll { flex-grow: 1; padding: 22px; }

/* A chart object dropped on a sheet: a plain white box with a border and a shadowless edge. */
.chart-obj {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: 22px;
    margin-bottom: 26px;
}

.chart-obj__title {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 16px;
}

.chart-row { flex-direction: row; align-items: center; height: 77px; }
.chart-row__label { width: 320px; font-size: 34px; }
.chart-row__track { flex-grow: 1; height: 42px; background-color: rgb(243, 243, 243); }
.chart-row__fill { height: 42px; background-color: rgb(33, 115, 70); }
.chart-row__value { width: 192px; -unity-text-align: middle-right; font-size: 34px; }

/* Excel's 작업 창: a panel docked over the sheet rather than a centred dialog. */
.task-pane {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 86%;
    background-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-left-color: rgb(191, 191, 191);
    padding: 26px;
}

/* ---------------------------------------------------------------- cost pool */

.cost-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.cost-row__value {
    width: 70px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
}

.cost-row__track { flex-direction: row; flex-grow: 1; }

.cost-cell {
    flex-grow: 1;
    height: 24px;
    margin-right: 4px;
    background-color: rgb(226, 226, 226);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
}

.cost-cell--full { background-color: rgb(31, 111, 235); }
.cost-cell--part { background-color: rgb(150, 190, 245); }

.ex-button__cost {
    position: absolute;
    top: 6px;
    left: 8px;
    min-width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(31, 111, 235);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* charged, but the budget is not there yet */
.ex-button--poor { opacity: 0.55; }
.ex-button--poor .ex-button__cost { background-color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- icons */

/* Drawn, not typed. Unity's default font has no glyph for a search loupe or a window, so those
   characters rendered as missing-glyph boxes — the boss key looked like it was simply absent. */
.icon { -unity-background-scale-mode: scale-to-fit; }
.icon--back { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/back.png"); }
.icon--search { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/search.png"); }
.icon--undo { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/undo.png"); }
.icon--bosskey { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/bosskey.png"); }
.icon--bosskey-on { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/bosskey_on.png"); }
.icon--overflow { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/overflow.png"); }
.icon--sheets { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/sheets.png"); }
.icon--add { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/add.png"); }

/* The corner cell's select-all mark, drawn with a border rather than a glyph. */
.ws-corner {
    border-bottom-width: 14px;
    border-bottom-color: rgb(170, 170, 170);
    border-left-width: 14px;
    border-left-color: rgba(0, 0, 0, 0);
}

/* ---------------------------------------------------------------- 위장 모드 시트 */

.stealth-sheet { flex-grow: 1; }
.xl-row--total { border-top-width: 2px; border-top-color: rgb(70, 70, 70); }
.xl-row--total .xl-cell { -unity-font-style: bold; }
.xl-cell--up { color: rgb(24, 92, 55); }
.xl-cell--down { color: rgb(196, 43, 28); }

/* The monster strips come out of the tileset already facing the party, so the blanket mirror that
   the hero-facing sprites need would turn them back around.

   They are also a different kind of frame: the web build composes each monster into a 64x64 box
   with the creature already scaled and standing on the bottom edge, whereas the hero strips are the
   raw 16x28 cells. Sizing both boxes the same made every monster look like a doll next to the
   party. 64 canvas pixels is 84 at this field's scale. */
.fighter--monster .fighter__body--creature {
    scale: 1 1;
    width: 84px;
    height: 84px;
}

.fighter--boss .fighter__body--creature { width: 168px; height: 152px; }

/* Pixel HP bars: hard edges, a one-pixel dark border and no rounding, so they sit on the same grid
   as the sprites instead of looking like a web widget dropped onto a tileset. */
.fighter__hpbar {
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(27, 29, 37);
    background-color: rgb(58, 62, 74);
    overflow: hidden;
}

.fighter__hpfill { border-radius: 0; }
.fighter--hero .fighter__hpfill { background-color: rgb(74, 200, 108); }
.fighter--monster .fighter__hpfill { background-color: rgb(214, 62, 52); }

/* ---------------------------------------------------------------- shots */

/* Office supplies in flight. Small and hard-edged so they belong to the pixel layer rather than
   looking like UI drawn over it. */
.shot {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(27, 29, 37);
}

.shot--drop { background-color: rgb(214, 62, 52); border-radius: 7px; }
.shot--slash { width: 22px; height: 6px; background-color: rgb(255, 240, 200); }

/* ---------------------------------------------------------------- 프롤로그 */

/* Letterboxed, not full bleed: the illustration sits in a band with black above and below, which
   is how the web build frames it. Filling a 9:16 phone with a 16:9 picture means cropping most of
   it away, and the crop always takes the part with the character in it. */
.prologue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(12, 14, 20);
}

.prologue__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 14%;
    height: 56%;
    -unity-background-scale-mode: scale-and-crop;
}

/* The narration sits over the lower third, so that part is darkened and the art is not — in four
   bands, because one box of flat alpha cuts a visible line across the picture. */
.prologue__scrim { position: absolute; left: 0; right: 0; }
.prologue__scrim--0 { top: 52%; height: 6%; background-color: rgba(8, 10, 16, 0.22); }
.prologue__scrim--1 { top: 58%; height: 6%; background-color: rgba(8, 10, 16, 0.48); }
.prologue__scrim--2 { top: 64%; height: 6%; background-color: rgba(8, 10, 16, 0.72); }
.prologue__scrim--3 { top: 70%; bottom: 0; background-color: rgb(8, 10, 16); }

.prologue__head {
    position: absolute;
    left: 48px;
    top: 15%;
    flex-direction: row;
    align-items: center;
}

.prologue__counter {
    width: 54px;
    height: 54px;
    -unity-text-align: middle-center;
    font-size: 28px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 27px;
    margin-right: 16px;
}

.prologue__title { font-size: 40px; color: rgb(255, 255, 255); -unity-font-style: bold; }

.prologue__body {
    position: absolute;
    left: 48px;
    right: 48px;
    top: 73%;
    font-size: 40px;
    color: rgb(240, 242, 248);
    white-space: normal;
}

.prologue__foot {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 56px;
    flex-direction: row;
    align-items: center;
}

.prologue__skip {
    height: 88px;
    min-width: 180px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    border-radius: 8px;
    color: rgb(215, 220, 232);
    font-size: 32px;
}

.prologue__dots { flex-grow: 1; flex-direction: row; justify-content: center; }

.prologue__dot {
    width: 18px;
    height: 18px;
    margin-left: 7px;
    margin-right: 7px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.25);
}

.prologue__dot--on { background-color: rgb(33, 115, 70); }

.prologue__nav {
    height: 88px;
    min-width: 168px;
    margin-left: 14px;
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 0;
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 32px;
}

.prologue__nav:disabled { opacity: 0.35; }
.prologue__nav--primary { background-color: rgb(33, 115, 70); }
