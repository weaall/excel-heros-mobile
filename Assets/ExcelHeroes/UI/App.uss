/* Excel Heroes — runtime styling for a portrait phone.

   The layout is Excel for Android, not desktop Excel scaled down. The phone app has no ribbon
   above the grid: a slim green app bar, then column letters, then the sheet, and every control
   along the bottom where a thumb reaches. Sizes are in the 1080x1920 reference the PanelSettings
   uses, so 40px here is roughly 15dp on a real 1080-wide phone — body text sits at 40-44px and
   anything tappable is at least 130px tall (~48dp). */

/* ---------------------------------------------------------------- shell */

/* ---------------------------------------------------------------- tokens

   Every colour, gap, radius and text size in this file comes from here.

   It did not before, and that was the problem: each screen was styled the day it was written, so
   the game had five button treatments, four card treatments and twenty-four distinct font sizes,
   none of which agreed. A player reads that as five different people having built five screens,
   which is exactly what happened.

   The scale is the 1080x2400 reference PanelSettings uses. On a 1080-wide phone at 3x density one
   dp is three of these units, so 42px is 14dp — the standard body size, and considerably larger
   than the 28px this build was using, which was 9dp and simply too small to read comfortably. */

.root {
    flex-grow: 1;
    background-color: var(--ex-surface);

    --ex-surface: rgb(238, 244, 250);
    --ex-surface-raised: rgb(255, 255, 255);
    --ex-surface-sunken: rgb(224, 234, 244);

    --ex-ink: rgb(34, 44, 62);
    --ex-ink-muted: rgb(126, 140, 162);

    --ex-line: rgb(208, 220, 234);
    --ex-line-strong: rgb(176, 192, 212);

    --ex-navy: rgb(30, 46, 74);
    --ex-navy-deep: rgb(20, 32, 54);
    --ex-navy-line: rgb(58, 82, 122);

    --ex-accent: rgb(77, 166, 232);
    --ex-accent-deep: rgb(42, 118, 186);
    --ex-accent-ink: rgb(255, 255, 255);
    --ex-accent-wash: rgb(226, 240, 253);

    --ex-danger: rgb(226, 62, 74);
    --ex-gold: rgb(247, 181, 41);

    --ex-space-1: 8px;
    --ex-space-2: 16px;
    --ex-space-3: 24px;
    --ex-space-4: 32px;
    --ex-space-5: 48px;
    --ex-space-6: 64px;

    --ex-rad-sm: 8px;
    --ex-rad-md: 16px;
    --ex-rad-lg: 24px;

    --ex-tap: 120px;
    --ex-tap-lg: 136px;

    --ex-text-xs: 26px;
    --ex-text-sm: 32px;
    --ex-text-base: 38px;
    --ex-text-lg: 48px;
    --ex-text-xl: 64px;
}

/* ---------------------------------------------------------------- components

   One button, one card, one section header. Anything that wants to look like a button uses these;
   a screen does not get to invent its own. */

.ex-btn {
    height: var(--ex-tap);
    padding-left: var(--ex-space-4);
    padding-right: var(--ex-space-4);
    border-radius: var(--ex-rad-md);
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;

    /* Elevation is a thicker bottom border — USS has no shadow, and a flat fill on a flat sheet
       reads as a label rather than as something to press. */
    border-width: 2px;
    border-bottom-width: 8px;
}

.ex-btn--primary {
    background-color: var(--ex-accent);
    border-color: var(--ex-accent);
    border-bottom-color: var(--ex-accent-deep);
    color: var(--ex-accent-ink);
}

.ex-btn--secondary {
    background-color: var(--ex-surface);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    color: var(--ex-ink);
}

.ex-btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ex-ink-muted);
}

.ex-btn:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

.ex-card {
    background-color: var(--ex-surface);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
    padding: var(--ex-space-4);
}

.ex-section-head {
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 0;
    padding-bottom: var(--ex-space-2);
    margin-bottom: var(--ex-space-3);
    border-bottom-width: 2px;
    border-bottom-color: var(--ex-line);
}

.ex-section-head__name {
    font-size: var(--ex-text-lg);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-right: var(--ex-space-2);
}

.ex-section-head__note {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    flex-shrink: 1;
    white-space: normal;
}

.spacer { flex-grow: 1; }
.hidden { display: none; }

/* ---------------------------------------------------------------- app bar */

/* Material Symbols, drawn as text. One variable font covers four thousand icons, scales without a
   second asset and takes its colour from `color` like any other label — so an icon that is white on
   the app bar and grey in the tab strip is one glyph rather than two PNGs. */
.icon {
    -unity-font-definition: url("project://database/Assets/ExcelHeroes/Fonts/MaterialSymbolsOutlined%20SDF.asset");
    -unity-text-align: middle-center;
    font-size: 46px;
}

/* The back arrow and the screen's name. A round dark button at the far left is how the reference
   marks "you are inside something" on 부대 편성 and 현상수배 alike.
   ---------------------------------------------------------------------------------- */
.navback { flex-direction: row; align-items: center; }

.navback__btn {
    width: 84px;
    height: 84px;
    background-color: var(--ex-navy);
    border-width: 3px;
    border-color: var(--ex-navy-line);
    border-radius: 42px;
    color: rgb(255, 255, 255);
    font-size: 42px;
}

.navback__btn:hover { background-color: var(--ex-navy-line); }

.navback__title {
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-left: var(--ex-space-2);
}

/* The player plate: a dark badge with the phase on a coloured tab, top left, where the reference
   puts the sensei's level. It is the one place on the chrome that says who is playing.
   ---------------------------------------------------------------------------------- */
.plate {
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding-right: var(--ex-space-3);
    background-color: var(--ex-navy-deep);
    border-width: 3px;
    border-color: var(--ex-navy-line);
    border-radius: var(--ex-rad-sm);
}

.plate__rank {
    align-items: center;
    justify-content: center;
    width: 86px;
    height: 100%;
    background-color: var(--ex-accent);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.plate__rank-word { font-size: 18px; color: rgba(255, 255, 255, 0.75); }
.plate__rank-num { font-size: 34px; -unity-font-style: bold; color: rgb(255, 255, 255); }

.plate__body { justify-content: center; padding-left: var(--ex-space-2); }
.plate__name { font-size: 30px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.plate__sub { font-size: 22px; color: rgba(255, 255, 255, 0.6); }

/* The top bar: what you have, and nothing else. It used to be an Excel app bar with a file name
   and a row of document actions, none of which did anything. */
.topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 116px;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
    background-color: var(--ex-surface-raised);
    border-bottom-width: 3px;
    border-bottom-color: var(--ex-line);
}

.topbar__title {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.72);
}

.topbar__btn {
    width: 82px;
    height: 82px;
    margin-left: var(--ex-space-1);
    background-color: var(--ex-surface-sunken);
    border-width: 3px;
    border-color: var(--ex-line);
    border-radius: var(--ex-rad-sm);
    color: var(--ex-navy);
    font-size: 38px;
}

.topbar__btn:hover { background-color: var(--ex-accent-wash); }

/* A currency reads as a coin and a number, not as a spreadsheet cell called 합계. */
.chip {
    flex-direction: row;
    align-items: center;
    height: 74px;
    margin-left: var(--ex-space-2);
    padding-left: var(--ex-space-1);
    background-color: var(--ex-surface-sunken);
    border-width: 3px;
    border-color: var(--ex-line);
    border-radius: 37px;
}

.chip__icon { font-size: 40px; height: 64px; width: 64px; color: var(--ex-gold); margin-right: var(--ex-space-1); }
.chip__icon--gem { color: rgb(64, 156, 236); }
.chip__value {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-right: var(--ex-space-2);
}

/* ---------------------------------------------------------------- navigation rail

   Held sideways, the thumbs rest at the left and right edges and the bottom is the hardest place
   to reach — so navigation runs down the side, not along the bottom where a portrait phone puts
   it. Each tab is an icon over a word, which survives being glanced at. */





/* The active tab is lit and marked on the edge it is attached to. */





/* ---------------------------------------------------------------- navigation

   A row of icon-over-label buttons along the bottom, every screen on it, exactly as the reference
   arranges its lobby. What was here was four tabs down a rail with the other four behind a 더보기
   menu — and a screen behind a menu is a screen nobody opens. */

.navbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 158px;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
    background-color: var(--ex-surface-raised);
    border-top-width: 3px;
    border-top-color: var(--ex-line);
}

.navtab {
    width: 168px;
    height: 132px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--ex-rad-md);
    align-items: center;
    justify-content: center;
}

.navtab:hover { background-color: var(--ex-accent-wash); }

/* The lit tab, the way the reference lights one: a filled plate, not a hairline. */
.navtab--active {
    background-color: var(--ex-accent);
    border-bottom-width: 6px;
    border-bottom-color: var(--ex-accent-deep);
}

.navtab__icon { font-size: 54px; height: 68px; color: var(--ex-ink-muted); }
.navtab--active .navtab__icon { color: rgb(255, 255, 255); }

.navtab__label {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    margin-top: 2px;
}

.navtab--active .navtab__label { color: rgb(255, 255, 255); -unity-font-style: bold; }

.navtab__badge {
    position: absolute;
    top: 12px;
    right: 30px;
    min-width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: var(--ex-danger);
    color: rgb(255, 255, 255);
    font-size: var(--ex-text-xs);
    -unity-text-align: middle-center;
}

/* One loud button in the corner the thumb rests on, carrying the thing the game sells. */
.navcta {
    width: 300px;
    height: 132px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--ex-gold);
    border-width: 3px;
    border-color: rgb(255, 214, 122);
    border-bottom-width: 8px;
    border-bottom-color: rgb(196, 136, 18);
    border-radius: var(--ex-rad-md);
}

.navcta:hover { background-color: rgb(255, 199, 74); }

.navcta__icon { font-size: 52px; height: 68px; color: rgb(72, 44, 0); margin-right: var(--ex-space-1); }

.navcta__label {
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    color: rgb(72, 44, 0);
}

/* ---------------------------------------------------------------- content */

.sheet {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: var(--ex-surface);
    overflow: hidden;
}

.screen-body { flex-grow: 1; min-height: 0; }

/* A thin line along the bottom for whatever just happened — a reward collected, a run finished. */
.statusbar {
    flex-shrink: 0;
    height: 44px;
    padding-left: var(--ex-space-3);
    font-size: 24px;
    color: var(--ex-ink-muted);
    background-color: var(--ex-surface-sunken);
    -unity-text-align: middle-left;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

/* ---------------------------------------------------------------- sheet furniture */

.sheet-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: var(--ex-space-3);
    padding-bottom: var(--ex-space-3);
    padding-left: var(--ex-space-4);
    padding-right: var(--ex-space-4);
    background-color: var(--ex-surface);
    border-bottom-width: 2px;
    border-bottom-color: var(--ex-line);
}

.sheet-head__stat { font-size: 36px; -unity-font-style: bold; margin-right: 28px; }
.sheet-head .muted { font-size: 28px; white-space: normal; }

/* ---------------------------------------------------------------- generic pieces */

/* The panel is the card. Same borders, same radius, same padding as .ex-card and .qs-block —
   before this there were four different panel treatments depending on which screen you were on. */
.panel {
    flex-shrink: 0;
    background-color: var(--ex-surface);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
    padding: var(--ex-space-4);
    margin-bottom: var(--ex-space-3);
}

.section-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(107, 107, 107);
    margin-bottom: 16px;
}

.muted { color: rgb(128, 128, 128); white-space: normal; }
.hidden { display: none; }

/* The game's button. It is .ex-btn with a different name — every call site already says
   `btn`, and renaming three hundred of them buys nothing that keeping the values in one place
   does not. Anything that wants to look like a button gets these values, not its own. */
.btn {
    height: var(--ex-tap);
    padding-left: var(--ex-space-4);
    padding-right: var(--ex-space-4);
    background-color: var(--ex-surface-raised);
    border-radius: var(--ex-rad-lg);
    border-width: 3px;
    border-bottom-width: 9px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    color: var(--ex-ink);
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.btn:hover { background-color: var(--ex-accent-wash); }

.btn:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

/* Primary is the Excel green, not the old mustard. The disguise is the premise, so the thing the
   player is meant to press and the chrome it hides behind are deliberately the same colour. */
.btn--primary {
    background-color: var(--ex-accent);
    border-color: rgb(146, 200, 244);
    border-bottom-color: var(--ex-accent-deep);
    color: var(--ex-accent-ink);
}

.btn--primary:hover { background-color: var(--ex-accent-deep); }

.btn--primary:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

.btn--ghost {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    color: var(--ex-ink-muted);
}

/* ---------------------------------------------------------------- home */

.home { flex-grow: 1; }

.home__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* stacked on the base art so a motion frame can cross-fade in */
.home__art-motion {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 0.9s;
}

.home__art-motion--on { opacity: 1; }

.home__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 992px;
    background-color: rgba(255, 255, 255, 0.62);
}

.home__strip {
    position: absolute;
    left: 32px;
    right: 32px;
    top: 26px;
    flex-direction: row;
    justify-content: space-between;
}

.home__stat {
    flex-grow: 1;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.72);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.6);
}

.home__stat-value { font-size: 48px; -unity-font-style: bold; color: rgb(176, 132, 10); }
.home__stat-key { font-size: 30px; color: rgb(107, 107, 107); }

.home__bubble {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 384px;
    padding: 32px;
    background-color: rgba(255, 255, 255, 0.82);
    border-radius: 29px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.7);
}

.home__who { font-size: 38px; color: rgb(33, 115, 70); -unity-font-style: bold; }

.home__speech {
    font-size: 43px;
    white-space: normal;
    margin-top: 13px;
    color: rgb(34, 34, 34);
}

.home__bond { margin-top: 26px; }
.home__bond-level { font-size: 32px; color: rgb(200, 60, 110); }

.home__bond-track {
    height: 16px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    overflow: hidden;
}

.home__bond-fill { height: 100%; background-color: rgb(200, 60, 110); }

.home__actions {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
    flex-direction: row;
}

.home__actions .btn { flex-grow: 1; margin-left: 8px; margin-right: 8px; }

/* ---------------------------------------------------------------- reveal */

.reveal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(228, 241, 253, 0.97);
    align-items: center;
    justify-content: center;
}

.reveal__card {
    width: 896px;
    height: 1248px;
    border-radius: 32px;
    border-width: 4px;
    overflow: hidden;
    align-items: center;
    justify-content: flex-end;
}

.reveal__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal__plate {
    width: 100%;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.86);
    align-items: center;
}

.reveal__grade { flex-shrink: 0; font-size: 46px; -unity-text-align: middle-left; }

.reveal__name {
    font-size: 54px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.reveal__nick { font-size: 35px; color: rgb(107, 107, 107); }

.reveal__line {
    font-size: 35px;
    color: rgb(70, 70, 70);
    margin-top: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.reveal__badge {
    margin-top: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 22px;
    font-size: 32px;
    background-color: rgb(150, 112, 8);
    color: rgb(253, 246, 227);
}

.reveal__hint {
    margin-top: 45px;
    font-size: 38px;
    color: rgb(107, 107, 107);
}

/* --- the tell -------------------------------------------------------------
   A column of light rises before the card resolves, in the rarity's colour.
   This is where the tension of a pull actually lives: by the time the art is
   on screen the player already knows, and the card is the confirmation. */

.tell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.tell__beam {
    width: 144px;
    height: 0;
    opacity: 0;
    transition-duration: 0.45s;
}

.tell__beam--up { height: 1760px; opacity: 0.9; }

.tell__ring {
    position: absolute;
    width: 256px;
    height: 256px;
    border-radius: 128px;
    border-width: 4px;
    opacity: 0;
    scale: 0.3 0.3;
    transition-duration: 0.5s;
}

.tell__ring--out { opacity: 0; scale: 3.4 3.4; }
.tell__ring--in { opacity: 0.95; scale: 1 1; }

.tell__label {
    position: absolute;
    bottom: 480px;
    font-size: 54px;
    -unity-font-style: bold;
    opacity: 0;
    transition-duration: 0.3s;
}

.tell__label--on { opacity: 1; }

/* the card landing */
.reveal__card {
    transition-duration: 0.28s;
}

/* ten-pull summary grid */

.reveal-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    width: 86%;
    height: 72%;
}

.reveal-grid__cell {
    width: 17.5%;
    height: 46%;
    margin: 0.6%;
    border-radius: var(--ex-rad-md);
    border-width: 4px;
    background-color: var(--ex-surface-raised);
    overflow: hidden;
    justify-content: flex-end;
}

.reveal-grid__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-grid__plate {
    flex-shrink: 0;
    padding-top: 6px;
    padding-bottom: 8px;
    background-color: var(--ex-navy);
    align-items: center;
}

.reveal-grid__name {
    font-size: 24px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.reveal-grid__grade { font-size: 32px; -unity-font-style: bold; }

/* ---------------------------------------------------------------- roster */

.roster-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-left: 10px;
    padding-right: 10px;
}

.card {
    width: 13.4%;
    height: 48%;
    margin: 0.5%;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: var(--ex-rad-md);
    overflow: hidden;
}

/* Portrait proportions, cropped from the TOP — the face identifies the card, and a centred crop
   on a 2:3 illustration lands on the chest. */
.card__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
    /* A tenth of the way down rather than flush with the top edge: these illustrations carry a
       halo above the head, so a crop pinned to the very top spends its first rows on empty ring. */
    background-position-y: top 8%;
}

.card__grade {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 26px;
    -unity-text-align: middle-center;
}

.card__role {
    position: absolute;
    right: 8px;
    top: 8px;
    padding: 4px 12px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.85);
    color: rgb(70, 70, 70);
    font-size: 21px;
}

.card__stars {
    position: absolute;
    left: 8px;
    bottom: 6px;
    font-size: 22px;
    -unity-font-style: bold;
}

.card__level {
    position: absolute;
    right: 8px;
    bottom: 6px;
    padding: 2px 10px;
    border-radius: 10px;
    background-color: rgba(20, 22, 28, 0.72);
    color: rgb(255, 255, 255);
    font-size: 20px;
}

.card__plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 4px 10px 6px 10px;
    background-color: rgba(30, 46, 74, 0.92);
}

.card__name {
    font-size: var(--ex-text-xs);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.card__sub { font-size: 21px; color: rgba(255, 255, 255, 0.6); }
/* Dimmed, not erased. At 0.25 an unowned card was a white rectangle, which defeats the point of
   listing it — the shelf is there so a player sees who they do not have yet. */
.card--locked .card__art { opacity: 0.55; }
.card--locked .card__name { color: var(--ex-ink-muted); }

/* A modal, not a second full screen. Tapping a card is a look at one card — taking over the whole
   display for it loses where you were in a list of fifty-five, and on the way back the scroll
   position went with it. The dim behind it is the overlay's own.

   Held sideways it is two columns: the illustration is a tall 2:3 and the stats are a list, so
   stacking them meant a modal three times the height of the screen. Side by side, each gets the
   axis it actually wants. */
.detail {
    flex-direction: row;
    width: 88%;
    max-width: 1700px;
    height: 88%;
    background-color: var(--ex-surface-raised);
    border-radius: var(--ex-rad-lg);
    border-width: 3px;
    border-color: var(--ex-navy-line);
    overflow: hidden;
}

/* The left column: the whole illustration, fitted inside it rather than sized from the modal's
   width, so nothing is cropped and nothing overflows. */
.detail__art {
    width: 38%;
    flex-shrink: 0;
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-to-fit;
}

.detail__scrim { display: none; }

.detail__right {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.detail__head {
    flex-shrink: 0;
    padding: var(--ex-space-2) var(--ex-space-3) var(--ex-space-2) var(--ex-space-3);
    background-color: var(--ex-navy);
    border-bottom-width: 5px;
    border-bottom-color: var(--ex-gold);
}

.detail__name { font-size: var(--ex-text-lg); -unity-font-style: bold; }
.detail__nick { font-size: var(--ex-text-xs); color: rgba(255, 255, 255, 0.66); }

/* flex-shrink is what makes this scroll. With only flex-grow the body kept its content height
   inside a modal capped at 88%, so anything past the fold simply could not be reached. */
.detail__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: var(--ex-space-4);
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    height: 66px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ex-line);
}

.stat-row__key { color: var(--ex-ink-muted); font-size: var(--ex-text-sm); }
.stat-row__value { font-size: var(--ex-text-sm); -unity-font-style: bold; color: var(--ex-ink); }

.detail__close {
    position: absolute;
    right: var(--ex-space-2);
    top: var(--ex-space-2);
    width: 90px;
    height: 90px;
    border-radius: 45px;
    background-color: var(--ex-surface-raised);
    border-width: 3px;
    border-color: var(--ex-navy-line);
    color: var(--ex-navy);
    font-size: 44px;
}

/* ---------------------------------------------------------------- party */

.party-slots {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.slot {
    flex-grow: 1;
    flex-basis: 0;
    width: auto;
    height: auto;
    margin: 6px;
}

.slot--empty {
    background-color: var(--ex-surface-sunken);
    border-width: 4px;
    border-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
    align-items: center;
    justify-content: center;
}

.slot__plus { font-size: 70px; color: rgb(160, 160, 160); }

.synergy-line {
    font-size: 35px;
    color: rgb(24, 92, 55);
    margin-bottom: 6px;
}

.power-readout {
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 0;
    margin-bottom: var(--ex-space-2);
    padding-left: var(--ex-space-2);
}

.power-readout__value {
    font-size: 58px;
    -unity-font-style: bold;
    color: var(--ex-gold);
}

.power-readout__label {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    margin-left: var(--ex-space-2);
}

/* ---------------------------------------------------------------- battle */

.battle {
    flex-grow: 1;
}

/* The battlefield is the worksheet. A painted landscape was both off-premise and unreadable behind
   16x28 pixel sprites; a tiled cell grid gives them a surface to stand on and survives the disguise,
   because what a passer-by sees is cells. */
/* The battlefield keeps the web build's 2:1 shape — a side-view street band across the top of
   the sheet, with the party's EX buttons below it. The backdrop texture is set from code because
   it is generated per phase. */
/* The field takes most of the sheet and the log takes the rest — between them there is no dead
   space. With the EX card row and the cost bar gone this screen had a fifth of its height doing
   nothing, which on the sheet the player looks at most is the worst place to leave it. */
/* The field takes the sheet. Its contents are placed from code against a scale taken from this
   box's width, so the street always spans it and the sky is cropped rather than stretched. */
.battle__stage {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgb(30, 34, 44);
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.fighter {
    position: absolute;
    width: 190px;
    align-items: center;
}

/* Pixel sprites want whole-number scale and no crop. 16x28 at 6x is 96x168, which reads clearly at
   arm's length on a phone and still lines the cast up on one baseline. */
.fighter__body {
    width: 104px;
    height: 184px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.fighter__body--chibi {
    width: 104px;
    height: 140px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Monsters face the party: the tileset draws everything facing right. */
.fighter--monster .fighter__body { scale: -1 1; }

/* Integer multiples only, and the web build's ratio: wave enemies 2x, bosses 3x. */
.fighter--boss { width: 440px; }
.fighter--boss .fighter__body { width: 156px; height: 276px; }
.fighter--boss .fighter__hpbar { width: 220px; }
.fighter--elite .fighter__body { width: 124px; height: 220px; }

.fighter--dead { opacity: 0.25; }

.fighter__hpbar {
    width: 96px;
    height: 14px;
    margin-top: 2px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 7px;
    overflow: hidden;
}

.fighter__hpfill {
    height: 100%;
    background-color: rgb(33, 115, 70);
}

.fighter--monster .fighter__hpfill { background-color: rgb(196, 43, 28); }

.fighter__name { display: none; }

/* Damage numbers. White on the dark field rather than the old mustard, which was invisible over
   the road, and with a dark outline so they stay readable over a lit window or a sprite. */
.floater {
    position: absolute;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 12, 18, 0.9);
}

.floater--heal { color: rgb(24, 92, 55); }
.floater--skill { color: rgb(31, 111, 235); font-size: 38px; }

.battle__hud {
    position: absolute;
    right: var(--ex-space-2);
    top: var(--ex-space-2);
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-1);
    background-color: rgba(12, 18, 32, 0.72);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 40px;
}

.battle__wave {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-right: var(--ex-space-2);
    transition-duration: 0.3s;
}

/* 야근: overtime has started and the errors are hitting harder every second */
.battle__wave--enraged { color: rgb(255, 120, 104); }

.ex-bar {
    flex-direction: row;
    height: 256px;
    align-items: center;
    justify-content: center;
    background-color: rgb(250, 250, 250);
    padding-top: 16px;
    padding-bottom: 16px;
}

.ex-button {
    width: 211px;
    height: 211px;
    margin-left: 11px;
    margin-right: 11px;
    border-radius: 29px;
    border-width: 3px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(243, 243, 243);
    overflow: hidden;
    justify-content: flex-end;
    align-items: center;
    transition-duration: 0.15s;
}

.ex-button--ready {
    border-color: rgb(176, 132, 10);
    scale: 1.05 1.05;
}

.ex-button--spent { opacity: 0.45; }

.ex-button__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.ex-button__charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(240, 196, 70, 0.28);
}

.ex-button__label {
    width: 100%;
    font-size: 27px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.85);
    padding-top: 5px;
    padding-bottom: 5px;
}

.result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.92);
    align-items: center;
    justify-content: center;
}

.result__title {
    font-size: 115px;
    -unity-font-style: bold;
    margin-bottom: 26px;
}

.result__title--win { color: rgb(176, 132, 10); }
.result__title--lose { color: rgb(196, 43, 28); }

/* ---------------------------------------------------------------- daily */

.stamp__row { flex-direction: row; margin-top: 13px; margin-bottom: 13px; }

.stamp__dot {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    margin-right: 13px;
    background-color: rgb(238, 238, 238);
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    transition-duration: 0.2s;
}

.stamp__dot--on {
    background-color: rgb(33, 115, 70);
    border-color: rgb(196, 152, 20);
}

.quest--done { opacity: 0.5; }

.quest__track {
    height: 19px;
    margin-top: 16px;
    background-color: rgb(238, 238, 238);
    border-radius: 10px;
    overflow: hidden;
}

.quest__fill { height: 100%; background-color: rgb(31, 111, 235); }

.quest__meta { font-size: 34px; color: rgb(107, 107, 107); margin-top: 13px; }

/* a count of claimable rewards, parked on the nav button */
.nav-badge {
    position: absolute;
    right: 29px;
    top: 22px;
    min-width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgb(196, 43, 28);
    color: rgb(120, 40, 70);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 13px;
    padding-right: 13px;
}

/* ---------------------------------------------------------------- onboarding */

.onboard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 45px;
    padding-right: 45px;
}

.onboard__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(243, 243, 243);
}

.onboard__card {
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 32px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.8);
    padding: 48px;
}

.onboard__title {
    font-size: 70px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    margin-bottom: 29px;
}

.onboard__line {
    font-size: 43px;
    white-space: normal;
    margin-bottom: 13px;
    color: rgb(34, 34, 34);
}

.onboard__tip {
    margin-top: 35px;
    margin-bottom: 35px;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 22px;
    border-left-width: 4px;
    border-left-color: rgb(31, 111, 235);
}

.onboard__tip-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
    margin-bottom: 6px;
}

.onboard__card .btn { margin-top: 16px; }

/* ---------------------------------------------------------------- EX cut-in */

/* The signature moment: firing a skill throws the character's own illustration across the
   screen shouting their line. It is the one time the art is at full size during play, and
   it is what makes a skill feel like a person acting rather than a number resolving. */

/* `clips` tells LayoutAudit that children overrunning this box are deliberate. */
/* The EX cut-in: a band across the bottom of the battlefield, not a takeover of it.

   It used to cover the whole field, so firing a skill hid the fight the skill was part of — the
   party, the monsters and the effects all disappeared for a second and a quarter behind a portrait.
   Blue Archive puts its EX portrait in the lower corner for exactly this reason: the moment is
   worth announcing, but not worth blinding the player through.

   `clips` tells LayoutAudit that children overrunning this box are deliberate. */
.cutin {
    position: absolute;
    left: 0;
    right: 0;
    top: 108px;
    height: 46%;
    justify-content: center;
    overflow: hidden;
}

.cutin__sweep {
    position: absolute;
    left: -120%;
    right: 120%;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 20, 28, 0.62);
    border-top-width: 3px;
    border-top-color: rgba(240, 196, 70, 0.9);
    border-bottom-width: 3px;
    border-bottom-color: rgba(240, 196, 70, 0.9);
    transition-duration: 0.28s;
}

.cutin__sweep--in { left: -10%; right: -10%; }

/* A bust crop anchored to the left of the band, sliding in from off-screen. */
.cutin__art {
    position: absolute;
    left: -30%;
    bottom: 0;
    width: 26%;
    height: 150%;
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__art--in { left: 1%; opacity: 1; }

.cutin__plate {
    position: absolute;
    left: 30%;
    align-items: flex-start;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__plate--in { opacity: 1; }

.cutin__skill {
    font-size: 74px;
    -unity-font-style: bold;
    color: rgb(250, 210, 90);
}

.cutin__line {
    font-size: 38px;
    color: rgba(255, 255, 255, 0.86);
    max-width: 1100px;
    white-space: normal;
}

/* --- hit feedback ------------------------------------------------------- */

.fighter__body { transition-duration: 0.09s; }

/* a lunge towards the enemy on the swing, so an attack has a body behind it */
.fighter--hero .fighter__body--swing { translate: 22px 0; }
.fighter--monster .fighter__body--swing { translate: -22px 0; }

.fighter__body--hurt { scale: 1.18 1.18; }

.fighter--dead {
    opacity: 0.25;
    transition-duration: 0.35s;
    scale: 0.82 0.82;
}

/* ---------------------------------------------------------------- story */

/* episode list */

.ep--locked { opacity: 0.45; }

.ep__cast {
    flex-direction: row;
    flex-shrink: 0;
    height: 86px;
    margin-bottom: var(--ex-space-1);
    overflow: hidden;
}

.ep__face {
    width: 86px;
    height: 86px;
    flex-shrink: 0;
    border-radius: 43px;
    margin-right: -12px;
    border-width: 2px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
}

/* the log itself */

.chat__header {
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.chat__title { font-size: 54px; -unity-font-style: bold; }

.chat-room {
    font-size: 35px;
    color: rgb(31, 111, 235);
    margin-top: 6px;
}

.chat-line {
    flex-direction: row;
    margin-bottom: 26px;
    align-items: flex-start;
}

.chat-line--mine { justify-content: flex-end; }

.chat-line--sys {
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 29px;
}

.chat-avatar {
    width: 122px;
    height: 122px;
    border-radius: 61px;
    margin-right: 19px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(243, 243, 243);
    -unity-background-scale-mode: scale-and-crop;
}

/* a repeated speaker keeps the indent but drops the face */
.chat-avatar--blank {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.chat-column { flex-shrink: 1; }

.chat-who {
    font-size: 32px;
    color: rgb(107, 107, 107);
    margin-bottom: 8px;
}

.chat-bubble {
    max-width: 1056px;
    padding: 24px;
    border-radius: 26px;
    background-color: rgb(240, 240, 240);
    font-size: 38px;
    white-space: normal;
}

.chat-line--mine .chat-bubble {
    background-color: rgb(226, 239, 218);
    color: rgb(253, 246, 227);
}

.chat-line--sys .chat-bubble {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(107, 107, 107);
    font-size: 34px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- sheet furniture */

/* Every sheet opens with a summary strip, the way a real one opens with a header row. */


.xl-row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.xl-row--head {
    background-color: rgb(243, 243, 243);
    border-bottom-color: rgb(191, 191, 191);
}

.xl-row--head .xl-cell { -unity-font-style: bold; color: rgb(70, 70, 70); }
.xl-row--boss .xl-cell { color: rgb(150, 112, 8); -unity-font-style: bold; }
.xl-row--locked .xl-cell { color: rgb(170, 170, 170); }

.xl-cell {
    flex-shrink: 1;
    width: 230px;
    padding-left: 26px;
    font-size: 35px;
    border-right-width: 1px;
    border-right-color: rgb(226, 226, 226);
}

.xl-cell--wide { flex-grow: 1; flex-basis: 0; min-width: 0; }
.xl-cell--num { -unity-text-align: middle-right; padding-right: 26px; }
.xl-body { flex-grow: 1; }

/* ---------------------------------------------------------------- album */

.album { flex-grow: 1; }
.album__scroll { flex-grow: 1; }

.album__grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
}

/* Three across on a 1080-wide phone, at the art's own 2:3 — cropping a card to a square is what
   made the thumbnails look mismatched. */
.album__cell {
    width: 15.6%;
    height: 48%;
    margin: 0.4%;
}

.album__art {
    flex-grow: 1;
    background-color: rgb(238, 238, 238);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    -unity-background-scale-mode: scale-and-crop;
}

.album__name {
    font-size: var(--ex-text-xs);
    height: 40px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.album__cell--locked .album__art { opacity: 0.18; }
.album__cell--locked .album__name { color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- full-size viewer */

.viewer {
    width: 96%;
    height: 94%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    align-items: center;
}

/* scale-to-fit, not scale-and-crop: the whole point of the viewer is that nothing is cut off. */
.viewer__art {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.viewer__caption { align-items: center; padding: 16px; }
.viewer__name { font-size: 54px; -unity-font-style: bold; color: rgb(33, 115, 70); }
.viewer__nick { font-size: 35px; color: rgb(107, 107, 107); }

.viewer__skins { flex-direction: row; justify-content: center; padding-bottom: 16px; }

.viewer__skin {
    height: 102px;
    min-width: 224px;
    margin: 0 10px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 35px;
}

.viewer__skin--active {
    background-color: rgb(226, 239, 218);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
}

.viewer__close { margin-bottom: 22px; min-width: 320px; }

.detail__skins { flex-direction: row; justify-content: center; padding: 13px; }

.detail__skin {
    height: 90px;
    min-width: 192px;
    margin: 0 8px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 32px;
}

/* ---------------------------------------------------------------- picker */

.picker {
    width: 72%;
    max-height: 84%;
    background-color: var(--ex-surface-raised);
    border-width: 3px;
    border-color: var(--ex-navy-line);
    border-radius: var(--ex-rad-lg);
    padding: var(--ex-space-3);
}

.picker__list { flex-grow: 1; }

.picker__row {
    flex-direction: row;
    align-items: center;
    min-height: 141px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.picker__face {
    width: 102px;
    height: 102px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
}

.picker__name { font-size: 38px; }

/* ---------------------------------------------------------------- charts */

.charts { flex-grow: 1; }
.charts__scroll { flex-grow: 1; padding: 22px; }

/* A chart object dropped on a sheet: a plain white box with a border and a shadowless edge. */
.chart-obj {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: var(--ex-space-2);
    margin-left: 6px;
    margin-right: 6px;
}

.chart-obj__title {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 16px;
}

.chart-row { flex-direction: row; align-items: center; height: 77px; }
.chart-row__label { width: 320px; font-size: 34px; }
.chart-row__track { flex-grow: 1; height: 42px; background-color: rgb(243, 243, 243); }
.chart-row__fill { height: 42px; background-color: rgb(33, 115, 70); }
.chart-row__value { width: 192px; -unity-text-align: middle-right; font-size: 34px; }

/* Excel's 작업 창: a panel docked over the sheet rather than a centred dialog. */
.task-pane {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 76%;
    background-color: var(--ex-surface-raised);
    border-left-width: 3px;
    border-left-color: var(--ex-navy-line);
    padding: var(--ex-space-3);
}

/* ---------------------------------------------------------------- cost pool */

.cost-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.cost-row__value {
    width: 70px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
}

.cost-row__track { flex-direction: row; flex-grow: 1; }

.cost-cell {
    flex-grow: 1;
    height: 24px;
    margin-right: 4px;
    background-color: rgb(226, 226, 226);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
}

.cost-cell--full { background-color: rgb(31, 111, 235); }
.cost-cell--part { background-color: rgb(150, 190, 245); }

.ex-button__cost {
    position: absolute;
    top: 6px;
    left: 8px;
    min-width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(31, 111, 235);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* charged, but the budget is not there yet */
.ex-button--poor { opacity: 0.55; }
.ex-button--poor .ex-button__cost { background-color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- icons */

/* Drawn, not typed. Unity's default font has no glyph for a search loupe or a window, so those
   characters rendered as missing-glyph boxes — the boss key looked like it was simply absent. */
.icon { -unity-background-scale-mode: scale-to-fit; }


/* The corner cell's select-all mark, drawn with a border rather than a glyph. */

/* ---------------------------------------------------------------- 위장 모드 시트 */

.xl-row--total { border-top-width: 2px; border-top-color: rgb(70, 70, 70); }
.xl-row--total .xl-cell { -unity-font-style: bold; }
.xl-cell--up { color: rgb(24, 92, 55); }
.xl-cell--down { color: rgb(196, 43, 28); }

/* The monster strips come out of the tileset already facing the party, so the blanket mirror that
   the hero-facing sprites need would turn them back around.

   They are also a different kind of frame: the web build composes each monster into a 64x64 box
   with the creature already scaled and standing on the bottom edge, whereas the hero strips are the
   raw 16x28 cells. Sizing both boxes the same made every monster look like a doll next to the
   party. 64 canvas pixels is 84 at this field's scale. */
.fighter--monster { width: 116px; }

.fighter--monster .fighter__body--creature {
    scale: 1 1;
    width: 110px;
    height: 110px;
}

.fighter--boss .fighter__body--creature { width: 216px; height: 196px; }
.fighter--boss.fighter--monster { width: 224px; }

/* Pixel HP bars: hard edges, a one-pixel dark border and no rounding, so they sit on the same grid
   as the sprites instead of looking like a web widget dropped onto a tileset. */
.fighter__hpbar {
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(27, 29, 37);
    background-color: rgb(58, 62, 74);
    overflow: hidden;
}

.fighter__hpfill { border-radius: 0; }
.fighter--hero .fighter__hpfill { background-color: rgb(74, 200, 108); }
.fighter--monster .fighter__hpfill { background-color: rgb(214, 62, 52); }

/* ---------------------------------------------------------------- shots */

/* Office supplies in flight. Small and hard-edged so they belong to the pixel layer rather than
   looking like UI drawn over it. */
.shot {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(27, 29, 37);
}

.shot--drop { background-color: rgb(214, 62, 52); border-radius: 7px; }
.shot--slash { width: 22px; height: 6px; background-color: rgb(255, 240, 200); }

/* ---------------------------------------------------------------- 프롤로그 */

/* Letterboxed, not full bleed: the illustration sits in a band with black above and below, which
   is how the web build frames it. Filling a 9:16 phone with a 16:9 picture means cropping most of
   it away, and the crop always takes the part with the character in it. */
.prologue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 9, 13);
    justify-content: center;
    padding-bottom: 180px;
}

/* The letterbox. Its height is set from the picture's aspect ratio in PrologueScreen, so the
   left and right edges of the illustration always reach the screen and the spare space ends up
   above and below it instead of being cropped off the sides. */
.prologue {
    align-items: center;
}

.prologue__stage {
    width: 100%;
    background-color: rgb(0, 0, 0);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.prologue__art {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.prologue__head {
    margin-left: 48px;
    margin-top: 56px;
    flex-direction: row;
    align-items: center;
}

.prologue__counter {
    width: 54px;
    height: 54px;
    -unity-text-align: middle-center;
    font-size: 28px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 27px;
    margin-right: 16px;
}

/* flex-shrink:0 because the letterbox squeezes its column, and a shrunk line box clips Korean
   descenders rather than wrapping. */
.prologue__title {
    font-size: 40px;
    height: 56px;
    flex-shrink: 0;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.prologue__body {
    margin-left: 48px;
    margin-right: 48px;
    margin-top: 32px;
    font-size: 40px;
    color: rgb(240, 242, 248);
    white-space: normal;
}

.prologue__foot {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 56px;
    flex-direction: row;
    align-items: center;
}

.prologue__skip {
    height: 88px;
    min-width: 180px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    border-radius: 8px;
    color: rgb(215, 220, 232);
    font-size: 32px;
}

.prologue__dots { flex-grow: 1; flex-direction: row; justify-content: center; }

.prologue__dot {
    width: 18px;
    height: 18px;
    margin-left: 7px;
    margin-right: 7px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.25);
}

.prologue__dot--on { background-color: rgb(33, 115, 70); }

.prologue__nav {
    height: 88px;
    min-width: 168px;
    margin-left: 14px;
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 0;
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 32px;
}

.prologue__nav:disabled { opacity: 0.35; }
.prologue__nav--primary { background-color: rgb(33, 115, 70); }

/* ---------------------------------------------------------------- battle log */

/* Rows in the sheet under the field, numbered like cells. In 위장 모드 the same rows carry
   recalculation progress, which is the whole reason the log is here and not in a floating panel. */
/* The run's own record, in the sheet's rows. It is also what carries the disguise: in 위장 모드
   these same lines become recalculation progress. */
.battle-log {
    position: absolute;
    left: var(--ex-space-3);
    top: var(--ex-space-2);
    width: 36%;
    height: 132px;
}

.log-row {
    margin-top: 3px;
}

.log-row__n {
    width: 74px;
    -unity-text-align: middle-center;
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    border-right-width: 1px;
    border-right-color: var(--ex-line);
}

.log-row__text {
    font-size: var(--ex-text-xs);
    color: rgba(255, 255, 255, 0.62);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------------------------------------------------------------- 필터 바 */

.filter-bar {
    flex-shrink: 0;
    padding: var(--ex-space-2) var(--ex-space-3) var(--ex-space-3) var(--ex-space-3);
    background-color: rgb(250, 250, 250);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.filter-bar__label { font-size: 24px; color: rgb(107, 107, 107); margin-bottom: 6px; }

.filter-row { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 6px; }
.filter-row__label { width: 76px; font-size: 24px; color: rgb(107, 107, 107); }

/* Chips, not dropdowns: a select on a phone is two taps and a modal, and these lists are short. */
.filter-chip {
    height: 56px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    background-color: var(--ex-surface-raised);
    border-width: 3px;
    border-color: var(--ex-line);
    border-radius: 28px;
}

.filter-chip--on {
    background-color: var(--ex-accent);
    border-color: var(--ex-accent-deep);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.filter-empty { padding: 60px; -unity-text-align: middle-center; font-size: 28px; }

/* Ash, and the odd sheet of office paper. Two pixels each — they are weather, not decoration. */
.mote {
    position: absolute;
    width: 4px;
    height: 4px;
    background-color: rgba(220, 220, 220, 0.42);
}

.mote--paper {
    width: 10px;
    height: 8px;
    background-color: rgba(236, 236, 226, 0.7);
}


/* ---------------------------------------------------------------- AUTO + office upgrades */

/* One toggle where the auto-skill and speed buttons used to be. Off is an outline, on is filled,
   so its state reads from across the room without anyone having to parse ON / OFF. */
.auto-toggle {
    flex-shrink: 0;
    min-width: 116px;
    height: 60px;
    font-size: var(--ex-text-xs);
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.7);
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 30px;
}

.auto-toggle--on {
    color: rgb(12, 16, 22);
    background-color: rgb(120, 214, 160);
    border-color: rgb(120, 214, 160);
}

/* The gold sink, as a strip of four cells under the EX bar. Cells, deliberately: this is a
   spreadsheet, and a row of bordered boxes with a number in each is what one looks like. */
.upgrades {
    position: absolute;
    right: var(--ex-space-2);
    bottom: var(--ex-space-2);
    flex-direction: row;
    height: 146px;
}

.upgrade {
    width: 260px;
    margin-left: 8px;
    padding-left: var(--ex-space-1);
    padding-right: var(--ex-space-1);
    background-color: rgba(18, 24, 38, 0.86);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.2);
    border-bottom-width: 7px;
    border-bottom-color: rgba(0, 0, 0, 0.5);
    border-radius: var(--ex-rad-md);
    align-items: center;
    justify-content: center;
}

/* Affordable is the only state worth colouring: everything else is just a price you cannot pay. */
.upgrade--ready {
    background-color: rgba(56, 124, 214, 0.94);
    border-color: rgb(146, 196, 255);
    border-bottom-color: rgb(32, 86, 164);
}

.upgrade--ready .upgrade__name { color: rgba(255, 255, 255, 0.85); }

.upgrade__name {
    font-size: var(--ex-text-xs);
    color: rgba(255, 255, 255, 0.66);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.upgrade__level {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-top: 4px;
}

.upgrade__cost { font-size: 22px; color: var(--ex-gold); margin-top: 2px; }

.result__auto {
    font-size: 26px;
    color: rgb(150, 156, 170);
    margin-top: 14px;
}

/* ---------------------------------------------------------------- sheet list */

.sheet-list {
    width: 84%;
    max-height: 76%;
    background-color: rgb(255, 255, 255);
    border-radius: 10px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    padding-right: 18px;
}

.sheet-list__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
    margin-bottom: 12px;
    margin-left: 10px;
}

.sheet-list__row {
    height: 96px;
    font-size: 30px;
    color: rgb(40, 42, 48);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(232, 232, 232);
    -unity-text-align: middle-left;
    padding-left: 18px;
}

.sheet-list__row--active {
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    background-color: rgb(240, 248, 243);
}


/* ---------------------------------------------------------------- roster sections */

/* The sheet header is a title and a count, and the count is the whole of the codex readout:
   a number on the right, where a spreadsheet puts its numbers. */
.sheet-head--tight {
    flex-wrap: nowrap;
    padding-top: 12px;
    padding-bottom: 12px;
}

.sheet-head__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
}

.sheet-head__count {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    -unity-text-align: middle-right;
}

/* One band per grade. The coloured rule down the left is what makes the sections scannable while
   scrolling fast — the tag alone disappears at speed. */
.grade-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 74px;
    margin-top: 18px;
    margin-left: 10px;
    margin-right: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(246, 246, 246);
    border-bottom-width: 1px;
    border-bottom-color: rgb(216, 216, 216);
}

.grade-head__rule {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
}

.grade-head__tag {
    min-width: 52px;
    height: 52px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(255, 255, 255);
    border-radius: 4px;
    margin-right: 14px;
}

.grade-head__label {
    font-size: 28px;
    color: rgb(70, 72, 80);
}

.grade-head__count {
    font-size: 28px;
    color: rgb(120, 124, 134);
}


/* ---------------------------------------------------------------- Excel dialog */

/* The shape of an Office dialog: a grey caption bar, a body with the message and an icon, and a
   button row bottom-right. Used for anything that has to interrupt, so interruptions look like
   part of the spreadsheet rather than part of a game. */
.xl-dialog {
    width: 90%;
    max-height: 86%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(150, 150, 150);
    border-radius: 6px;
    overflow: hidden;
}

.xl-dialog__caption {
    flex-direction: row;
    align-items: center;
    height: 88px;
    flex-shrink: 0;
    background-color: rgb(242, 242, 242);
    border-bottom-width: 1px;
    border-bottom-color: rgb(214, 214, 214);
    padding-left: 24px;
}

.xl-dialog__caption-title {
    font-size: 28px;
    color: rgb(70, 72, 78);
}

.xl-dialog__close {
    width: 88px;
    height: 88px;
    font-size: 32px;
    color: rgb(90, 92, 98);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.xl-dialog__body {
    padding-top: 28px;
    padding-bottom: 20px;
    padding-left: 28px;
    padding-right: 28px;
}

.xl-dialog__head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 22px;
}

/* The round information glyph Office puts beside a message. Drawn rather than imported, because
   Unity's default font has no symbol for it. */
.xl-dialog__icon {
    width: 68px;
    height: 68px;
    flex-shrink: 0;
    margin-right: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold-and-italic;
    font-size: 36px;
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-radius: 34px;
}

.xl-dialog__head-text { flex-grow: 1; flex-shrink: 1; }

.xl-dialog__title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(30, 32, 38);
}

.xl-dialog__subtitle {
    font-size: 26px;
    color: rgb(120, 124, 134);
    margin-top: 6px;
}

/* A block of worksheet rows inside the dialog: row numbers, cell borders, the lot. */
.xl-dialog__sheet {
    border-width: 1px;
    border-color: rgb(214, 214, 214);
}

.xl-row {
    flex-direction: row;
    align-items: center;
    min-height: 82px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(228, 228, 228);
}

.xl-row__n {
    width: 62px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(130, 134, 142);
    background-color: rgb(243, 243, 243);
    border-right-width: 1px;
    border-right-color: rgb(214, 214, 214);
    height: 100%;
}

.xl-row__cell {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 28px;
    color: rgb(42, 44, 50);
    padding-left: 18px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.xl-row--grant { background-color: rgb(240, 248, 243); }

.xl-row__value {
    flex-shrink: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    -unity-text-align: middle-right;
    padding-right: 20px;
}

.xl-dialog__note {
    font-size: 25px;
    color: rgb(126, 130, 140);
    white-space: normal;
    margin-top: 18px;
}

.xl-dialog__foot {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 18px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgb(247, 247, 247);
    border-top-width: 1px;
    border-top-color: rgb(222, 222, 222);
}

/* The dialog button. Squarer than the game's, because an Office dialog's buttons are square —
   but the height, padding and type come from the same tokens as everything else. */
.xl-btn {
    min-width: 200px;
    height: var(--ex-tap);
    margin-left: var(--ex-space-2);
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-3);
    font-size: var(--ex-text-sm);
    color: var(--ex-ink);
    background-color: var(--ex-surface);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-sm);
}

/* The default button — the one Enter would press. */
.xl-btn--default {
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-color: rgb(24, 88, 54);
    -unity-font-style: bold;
}


/* ---------------------------------------------------------------- check-in stamp */

.stamp { flex-shrink: 0; }

.stamp__head { flex-direction: row; align-items: center; margin-bottom: 16px; }
.stamp__title { font-size: 34px; -unity-font-style: bold; color: rgb(38, 40, 46); }
.stamp__streak { font-size: 28px; color: rgb(33, 115, 70); -unity-font-style: bold; }

/* Eight day cells across, so a week plus "이후" fits one row without wrapping on a phone. */
.stamp__grid { flex-direction: row; }

.stamp-day {
    flex-grow: 1;
    flex-basis: 0;
    height: 116px;
    margin-left: 3px;
    margin-right: 3px;
    align-items: center;
    justify-content: center;
    background-color: rgb(246, 246, 246);
    border-width: 1px;
    border-color: rgb(216, 216, 216);
    border-radius: 4px;
}

.stamp-day--on { background-color: rgb(236, 246, 240); border-color: rgb(160, 200, 178); }

/* Today is an outline rather than a fill — a filled cell means "already stamped". */
.stamp-day--today {
    border-width: 3px;
    border-color: rgb(33, 115, 70);
    background-color: rgb(255, 255, 255);
}

.stamp-day__n { font-size: 24px; color: rgb(110, 114, 122); }
.stamp-day__gems { font-size: 24px; height: 34px; -unity-font-style: bold; color: rgb(60, 62, 70); }

/* The stamp itself: a red approval mark at an angle, the way an actual 도장 lands. */
.stamp-day__mark {
    position: absolute;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(199, 62, 62, 0.85);
    border-width: 2px;
    border-color: rgba(199, 62, 62, 0.7);
    border-radius: 6px;
    padding-left: 6px;
    padding-right: 6px;
    rotate: -14deg;
}

.stamp__go { margin-top: 18px; }
.stamp__done { margin-top: 16px; font-size: 27px; color: rgb(126, 130, 140); }

/* ---------------------------------------------------------------- summon banner

   Built from docs/design/pickup.md. Flat-only tricks throughout, because USS has no gradients
   and no box-shadow: thick bottom borders stand in for elevation and carry the rarity colour,
   one skewed tag breaks the spreadsheet grid, and an oversized low-opacity word fills the space
   the splash art leaves empty. */

.gacha { flex-grow: 1; background-color: rgb(243, 245, 247); }
.gacha__scroll { flex-grow: 1; }

.banner {
    flex-grow: 1;
    justify-content: flex-end;
    padding-bottom: var(--ex-space-3);
    padding-left: var(--ex-space-3);
    background-color: rgb(26, 37, 48);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
    border-radius: var(--ex-rad-lg);
    overflow: hidden;
}

.banner__watermark {
    position: absolute;
    left: 20px;
    bottom: 150px;
    font-size: 200px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    opacity: 0.08;
}

/* The one geometric break in a screen made entirely of right angles. */
.banner__tag {
    position: absolute;
    left: 40px;
    top: 36px;
    height: 62px;
    padding-left: 30px;
    padding-right: 30px;
    justify-content: center;
    rotate: -2deg;
    scale: 1 1;
}

.banner__tag-text {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
}

.banner__plate {
    width: 78%;
    padding: 20px 26px 20px 26px;
    background-color: rgb(255, 255, 255);
    border-left-width: 12px;
}

.banner__kicker {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    letter-spacing: 4px;
}

.banner__title {
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(26, 37, 48);
}

/* ---- the two featured cards ---- */

.pickup {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: var(--ex-space-2);
}

.pcard {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 8px;
    margin-right: 8px;
    background-color: var(--ex-surface-raised);
    border-radius: var(--ex-rad-md);
    /* Rarity and elevation in one stroke — the colour is set per card from grades.json. */
    border-bottom-width: 12px;
    overflow: hidden;
}

.pcard__art {
    width: 42%;
    flex-shrink: 0;
    background-color: rgb(232, 234, 238);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
}

.pcard__grade {
    position: absolute;
    left: 0;
    top: 0;
    min-width: 64px;
    height: 64px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 32px;
    color: rgb(20, 22, 28);
    border-bottom-right-radius: 10px;
}

.pcard__foot {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
    padding: var(--ex-space-2);
}

.pcard__name {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pcard__track {
    height: 12px;
    margin-top: 14px;
    background-color: rgb(226, 229, 234);
    border-radius: 6px;
    overflow: hidden;
}

.pcard__fill { height: 100%; }

.pcard__line { flex-direction: row; align-items: center; margin-top: 12px; }

.pcard__points { font-size: 28px; color: rgb(110, 116, 128); }

.pcard__take {
    min-width: 150px;
    height: var(--ex-tap);
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-width: 2px;
    border-color: var(--ex-accent);
    border-bottom-width: 6px;
    border-bottom-color: var(--ex-accent-deep);
    border-radius: var(--ex-rad-md);
}

.pcard__take:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

/* ---- rates and the two pity floors ---- */

.rates {
    flex-shrink: 0;
    padding: var(--ex-space-2);
    background-color: var(--ex-surface-raised);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
}

.rates__row { flex-direction: row; margin-bottom: 18px; }

.rate-chip {
    flex-direction: row;
    align-items: center;
    height: 60px;
    margin-right: 10px;
    padding-right: 14px;
    background-color: rgb(243, 245, 247);
    border-radius: 6px;
}

.rate-chip__id {
    width: 56px;
    height: 60px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(20, 22, 28);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.rate-chip__rate { font-size: 26px; color: rgb(90, 96, 106); margin-left: 10px; }

.pity__row { flex-direction: row; align-items: center; height: 62px; }

.pity__tag {
    width: 56px;
    height: 56px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(20, 22, 28);
    border-radius: 6px;
    margin-right: 16px;
}

.pity__track {
    flex-grow: 1;
    height: 16px;
    background-color: rgb(230, 233, 238);
    border-radius: 8px;
    overflow: hidden;
}

.pity__fill { height: 100%; }

.pity__label {
    width: 140px;
    -unity-text-align: middle-right;
    font-size: 28px;
    color: rgb(90, 96, 106);
}

/* ---- the foot ---- */

.pull-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 20px 28px 26px 28px;
    background-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-top-color: rgb(222, 226, 232);
}

.pull-bar__points { width: 210px; flex-shrink: 0; }
.pull-bar__label { font-size: 26px; -unity-font-style: bold; color: rgb(130, 140, 150); }
.pull-bar__value { font-size: 52px; -unity-font-style: bold; color: rgb(26, 37, 48); }

.pull-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--ex-tap-lg);
    margin-left: var(--ex-space-2);
    font-size: var(--ex-text-base);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-ink);
    background-color: var(--ex-surface);
    border-width: 2px;
    border-color: var(--ex-line);
    border-bottom-width: 8px;
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
    white-space: nowrap;
}

.pull-btn--primary {
    flex-grow: 1.8;
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-color: var(--ex-accent);
    border-bottom-color: var(--ex-accent-deep);
}

.pull-btn:disabled {
    color: rgb(160, 165, 174);
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
}


/* The first-run home screen, before anyone has been recruited. It replaces the battlefield rather
   than sitting inside it — a notice on a black band under an empty EX bar reads as a broken
   battle, which is exactly what it is not. */
.battle-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 60px;
    padding-right: 60px;
}

.battle-empty__title {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
}

.battle-empty__line {
    font-size: 30px;
    color: rgb(120, 124, 134);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 16px;
}

.battle-empty__go { margin-top: 40px; min-width: 460px; }


/* The run's result. Narrower than the onboarding dialog because it carries three numbers, and it
   never needs to be dismissed — the next run takes it down. */
.result-dialog { width: 84%; }


/* ---------------------------------------------------------------- hit effects */

/* The Painter2D canvas the arcs, bursts and sparks are drawn on. It covers the field and never
   takes a click; the fighters are added after it, so nothing is painted over a face. */

/* One frame of blowout on the thing that just got hit. The eye reads this as contact before it
   reads the number, which is most of why a hit lands at all. */
.fighter__body--flash {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    scale: 1.12 1.12;
}

.floater--crit {
    font-size: 58px;
    color: rgb(250, 204, 70);
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
}

/* 콤보. Only appears once a run of hits is worth noticing, so it means something when it does. */
.combo {
    position: absolute;
    left: 0;
    right: 0;
    top: 118px;
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(250, 204, 70);
    opacity: 0;
}

.combo--on { opacity: 1; }


/* ---------------------------------------------------------------- skill gauge */

/* The blue bar under a hero's health, filling towards their next skill. It replaces the row of EX
   cards and the shared budget bar that used to sit under the field: every skill fires itself, so a
   card you cannot press only tells you the game is thinking. */
.fighter__skillbar {
    width: 96px;
    height: 8px;
    margin-top: 2px;
    background-color: rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    overflow: hidden;
}

.fighter__skillfill {
    height: 100%;
    background-color: rgb(58, 132, 214);
}

/* Full: it is about to go off, so it says so. */
.fighter__skillfill--ready { background-color: rgb(120, 198, 255); }

/* ---------------------------------------------------------------- daily sheet */

/* Sections, the web's `qs-block`: a titled card per group so the sheet reads as a list of things
   rather than as one long column of panels. */
.qs-block {
    flex-shrink: 0;
    margin-bottom: var(--ex-space-2);
    padding: var(--ex-space-2);
    background-color: var(--ex-surface);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
}

/* The section header, the same one everywhere: a name, a muted note beside it, a rule under. */
.qs-title {
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 0;
    padding-bottom: var(--ex-space-1);
    margin-bottom: var(--ex-space-1);
    border-bottom-width: 2px;
    border-bottom-color: var(--ex-line);
}

.qs-title__name {
    font-size: var(--ex-text-lg);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-right: var(--ex-space-2);
}

.qs-title__note {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    flex-shrink: 1;
    white-space: normal;
}

.sheet-head__sub { font-size: 24px; color: rgb(140, 145, 155); }

.claim-all { min-width: 300px; height: 92px; font-size: 30px; }

/* One task per row: the text block grows, the button stays put on the right. */
.qrow {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 112px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(234, 234, 234);
}

.qrow--done { opacity: 0.55; }

.qrow__text { flex-grow: 1; flex-shrink: 1; }
.qrow__name { font-size: 26px; -unity-font-style: bold; color: rgb(40, 42, 48); }
.qrow__desc { font-size: 21px; color: rgb(140, 145, 155); }

.qrow__track {
    height: 8px;
    margin-top: 5px;
    margin-right: 20px;
    background-color: rgb(228, 230, 234);
    border-radius: 4px;
    overflow: hidden;
}

.qrow__fill { height: 100%; background-color: rgb(33, 115, 70); }

.qrow__meta { font-size: 21px; color: rgb(110, 115, 125); margin-top: 2px; }

.qrow__claim {
    flex-shrink: 0;
    min-width: 140px;
    height: 68px;
    font-size: var(--ex-text-xs);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ex-accent-ink);
    background-color: var(--ex-accent);
    border-width: 2px;
    border-color: var(--ex-accent);
    border-bottom-width: 6px;
    border-bottom-color: var(--ex-accent-deep);
    border-radius: var(--ex-rad-md);
}

.qrow__claim:disabled {
    background-color: var(--ex-surface-sunken);
    border-color: var(--ex-line);
    border-bottom-color: var(--ex-line);
    color: rgb(160, 165, 174);
}

.qrow__done { flex-shrink: 0; min-width: 128px; -unity-text-align: middle-center; font-size: 26px; color: rgb(150, 154, 162); }


/* ---------------------------------------------------------------- icons */



/* The street. Taller than the box it sits in and top-anchored from code so its drawn road meets
   the sprites' feet; the field's overflow crops the sky above it. */
.battle__backdrop {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

/* An empty cell on a short last page, so four cards do not spread across a row built for seven. */
.card--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* The filter bar carries the grade sections now: each chip is a section with its own count. */
.filter-bar {
    flex-shrink: 0;
    padding-top: var(--ex-space-1);
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
}

.filter-row {
    flex-direction: row;
    align-items: center;
    height: 72px;
}

.filter-row__label {
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    margin-right: var(--ex-space-1);
}

.filter-row__count {
    font-size: var(--ex-text-sm);
    -unity-font-style: bold;
    color: var(--ex-ink);
    margin-right: var(--ex-space-1);
}

.filter-chip {
    height: 56px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: var(--ex-text-xs);
    color: var(--ex-ink-muted);
    background-color: var(--ex-surface-sunken);
    border-width: 2px;
    border-color: var(--ex-line);
    border-radius: 28px;
}

.filter-chip--on {
    background-color: var(--ex-accent);
    border-color: var(--ex-accent-deep);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* Page turning, wherever a list is longer than the screen. Held sideways nothing scrolls, so this
   is how a list gets read. */
.pager {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 96px;
}

.pager__btn {
    width: 104px;
    height: 78px;
    font-size: var(--ex-text-sm);
    color: var(--ex-navy);
    background-color: var(--ex-surface-raised);
    border-width: 3px;
    border-color: var(--ex-line);
    border-bottom-width: 7px;
    border-bottom-color: var(--ex-line-strong);
    border-radius: var(--ex-rad-md);
}

.pager__btn:disabled { opacity: 0.35; }

.pager__label {
    min-width: 260px;
    font-size: var(--ex-text-sm);
    -unity-text-align: middle-center;
    color: var(--ex-ink-muted);
}

/* ---------------------------------------------------------------- landscape column layouts

   Nothing in this build scrolls. A list that outgrows the frame turns pages (.pager); everything
   else is laid out in columns, because the frame is twice as wide as it is tall and stacking is
   what put content below the fold in the first place. */

.gacha__cols { flex-direction: row; flex-grow: 1; min-height: 0; }

.gacha__left {
    width: 44%;
    flex-shrink: 0;
    padding: var(--ex-space-2);
}

.gacha__right {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: var(--ex-space-2);
}

.qs-cols { flex-direction: row; flex-grow: 1; min-height: 0; }

.qs-col {
    width: 40%;
    flex-shrink: 0;
    padding: var(--ex-space-2);
}

.qs-col--wide { flex-grow: 1; flex-shrink: 1; width: auto; min-width: 0; }

.charts__cols {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: var(--ex-space-2);
}

/* Three episode cards across, two down. */
.ep-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
}

.ep {
    width: 31.3%;
    height: 46%;
    margin: 1%;
    padding: var(--ex-space-2);
    justify-content: space-between;
    overflow: hidden;
}

/* Inside an episode card the type steps down a size: the card is a third of the frame wide. */
.ep .section-title { font-size: 30px; margin-bottom: 2px; }
.ep .muted { font-size: 24px; }
.ep .btn { flex-shrink: 0; height: 84px; margin-top: var(--ex-space-1); }

/* The screen's own heading is a line, not a panel taking a fifth of the frame. */
.ep-head {
    flex-shrink: 0;
    flex-direction: row;
    align-items: baseline;
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-3);
    padding-top: var(--ex-space-2);
}

.ep-head .section-title { margin-bottom: 0; margin-right: var(--ex-space-2); }

/* The cards half of the 모집 column; the rates block sits under it and is not its child, so a
   rebuild of the cards cannot take the odds with it. */
.gacha__cards { flex-grow: 1; min-height: 0; }

/* The contact shadow under each fighter. Inset rather than sized, so it stays centred under a
   sprite whose box is a different width per kind, and flat rather than soft because USS has no
   blur — an ellipse at a third opacity reads as ground contact anyway. */
.fighter__shadow {
    position: absolute;
    left: 46px;
    right: 46px;
    top: 126px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(0, 0, 0, 0.45);
}

.fighter--monster .fighter__shadow { top: 170px; }
.fighter--elite .fighter__shadow { left: 38px; right: 38px; top: 206px; }

.fighter--boss .fighter__shadow {
    left: 140px;
    right: 140px;
    top: 262px;
    height: 32px;
    border-radius: 16px;
}

/* ---------------------------------------------------------------- card sheet tabs

   The reference splits its own student sheet into 기본 정보 / 레벨 업 / 신비 해방 rather than
   running them down one scroll. Everything this modal knows is four screens of reading, and held
   sideways there is no scroll to put it in. */

.dtabs {
    flex-direction: row;
    flex-shrink: 0;
    padding-left: var(--ex-space-2);
    padding-right: var(--ex-space-2);
    padding-top: var(--ex-space-1);
}

.dtab {
    flex-grow: 1;
    flex-basis: 0;
    height: 84px;
    margin-right: 8px;
    font-size: var(--ex-text-sm);
    color: var(--ex-ink-muted);
    background-color: var(--ex-surface-sunken);
    border-width: 3px;
    border-color: var(--ex-line);
    border-radius: var(--ex-rad-md);
}

.dtab--on {
    background-color: var(--ex-surface-raised);
    border-color: var(--ex-accent);
    border-bottom-width: 7px;
    border-bottom-color: var(--ex-accent);
    color: var(--ex-ink);
    -unity-font-style: bold;
}

.detail__body { flex-grow: 1; min-height: 0; overflow: hidden; padding: var(--ex-space-2); }

.detail__foot {
    flex-shrink: 0;
    padding: var(--ex-space-2);
    border-top-width: 2px;
    border-top-color: var(--ex-line);
}

/* The hairline and the + that close every currency pill in the reference. */
.chip__rule {
    width: 3px;
    height: 44px;
    background-color: var(--ex-line);
}

.chip__plus {
    width: 58px;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--ex-accent);
    -unity-text-align: middle-center;
}

/* The star row on the plate, and the corner flag on a card the player did not already own —
   both straight off the reference's ten-pull. */
.reveal-grid__stars { font-size: 28px; -unity-font-style: bold; }

.reveal-grid__new {
    position: absolute;
    left: 0;
    top: 12px;
    padding-left: 14px;
    padding-right: 14px;
    height: 46px;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(72, 44, 0);
    background-color: var(--ex-gold);
    border-top-right-radius: var(--ex-rad-sm);
    border-bottom-right-radius: var(--ex-rad-sm);
}

.reveal-foot { align-items: center; margin-top: var(--ex-space-3); }
.reveal-foot__ok { min-width: 520px; }

/* The pity total, in the corner the reference keeps it in. */
.reveal-points {
    position: absolute;
    right: var(--ex-space-4);
    bottom: var(--ex-space-4);
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding-left: var(--ex-space-3);
    padding-right: var(--ex-space-3);
    background-color: var(--ex-navy);
    border-radius: var(--ex-rad-md);
}

.reveal-points__label { font-size: var(--ex-text-xs); color: rgba(255, 255, 255, 0.7); margin-right: var(--ex-space-2); }
.reveal-points__value { font-size: var(--ex-text-sm); -unity-font-style: bold; color: rgb(255, 255, 255); }

/* ---------------------------------------------------------------- 편성

   The line-up on the left at a size where a face reads, what it adds up to on the right — the
   arrangement the reference's own 부대 편성 uses. */

.party-cols { flex-direction: row; flex-grow: 1; min-height: 0; padding: var(--ex-space-2); }

.party-cols__left {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--ex-space-2);
}

.party-cols__right { width: 34%; flex-shrink: 0; }

.party-actions {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: var(--ex-space-2);
}

.party-actions .btn { margin-left: var(--ex-space-2); }

.slot__hint { font-size: var(--ex-text-xs); color: var(--ex-ink-muted); margin-top: 6px; }

.picker-grid { height: 620px; }

/* Inside the 편성 column everything steps down a size, so the composition's last row is on the
   screen rather than a pixel past the bottom of it. */
.party-cols__right .panel { padding: var(--ex-space-2); margin-bottom: var(--ex-space-2); }
.party-cols__right .section-title { font-size: var(--ex-text-sm); margin-bottom: var(--ex-space-1); }
.party-cols__right .stat-row { height: 56px; }
.party-cols__right .synergy-line { font-size: var(--ex-text-xs); }
