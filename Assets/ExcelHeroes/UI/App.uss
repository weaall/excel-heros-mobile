/* Excel Heroes — runtime styling for a portrait phone.

   The layout is Excel for Android, not desktop Excel scaled down. The phone app has no ribbon
   above the grid: a slim green app bar, then column letters, then the sheet, and every control
   along the bottom where a thumb reaches. Sizes are in the 1080x1920 reference the PanelSettings
   uses, so 40px here is roughly 15dp on a real 1080-wide phone — body text sits at 40-44px and
   anything tappable is at least 130px tall (~48dp). */

/* ---------------------------------------------------------------- shell */

.root {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    color: rgb(34, 34, 34);
    font-size: 40px;
}

/* The whole UI is set in Noto Sans KR. Unity's built-in font has no Hangul at all, so every
   Korean glyph was coming from whatever fallback the editor happened to pick — which is why the
   chrome, the card names and the battle log were in three subtly different faces. Text properties
   inherit, so declaring it once on the root covers the overlays too. */
.root {
    -unity-font-definition: url("project://database/Assets/ExcelHeroes/Fonts/NotoSansKR-Medium%20SDF.asset");
}

.spacer { flex-grow: 1; }
.hidden { display: none; }

/* ---------------------------------------------------------------- app bar */

.appbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 112px;
    padding-left: 24px;
    padding-right: 12px;
    background-color: rgb(33, 115, 70);
}

.app-icon {
    width: 56px;
    height: 56px;
    -unity-text-align: middle-center;
    background-color: rgb(255, 255, 255);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 6px;
    margin-right: 18px;
}

.appbar__title {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 38px;
    -unity-text-align: middle-center;
}
.appbar__save { color: rgba(255, 255, 255, 0.85); font-size: 30px; margin-right: 10px; }

.appbar__btn {
    width: 84px;
    height: 84px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 40px;
}

.appbar__btn:hover { background-color: rgba(255, 255, 255, 0.18); }

/* ---------------------------------------------------------------- worksheet frame */

/* Column letters and row numbers are the whole disguise once the ribbon is gone — they are what a
   passer-by reads before anything else, so they stay visible on every sheet. */
.ws-cols {
    flex-direction: row;
    flex-shrink: 0;
    height: 62px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(191, 191, 191);
}

.ws-corner {
    width: 74px;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(140, 140, 140);
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.ws-col {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 30px;
    color: rgb(70, 70, 70);
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.sheet-row { flex-direction: row; flex-grow: 1; min-height: 0; }

.ws-rows {
    width: 74px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.ws-row-num {
    height: 96px;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(120, 120, 120);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.sheet {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/UI/cell_rule.png");
    background-repeat: repeat;
    background-size: 96px 96px;
}

.screen { flex-grow: 1; overflow: hidden; }

.screen-body {
    flex-grow: 1;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 28px;
    padding-right: 28px;
}

/* ---------------------------------------------------------------- ribbon (bottom sheet) */

/* Tapping 홈 ▲ slides this up over the grid, the way the phone app does. It is not resident
   chrome — on a phone the ribbon is a thing you summon, not a thing you look past. */
.ribbon {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    flex-wrap: wrap;
    min-height: 168px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-top-color: rgb(191, 191, 191);
}

.rb-btn {
    height: 136px;
    min-width: 200px;
    margin-right: 12px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    border-radius: 6px;
    color: rgb(34, 34, 34);
    font-size: 34px;
}

.rb-btn:hover { background-color: rgb(226, 239, 218); }
.rb-btn:disabled { opacity: 0.45; }
.rb-btn__icon { font-size: 44px; color: rgb(33, 115, 70); }
.rb-btn__sub { font-size: 28px; color: rgb(107, 107, 107); }

.rb-sep {
    width: 1px;
    height: 104px;
    margin-left: 8px;
    margin-right: 14px;
    background-color: rgb(212, 212, 212);
}

/* ---------------------------------------------------------------- formula bar */

.formula-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 96px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.name-box {
    flex-shrink: 0;
    min-width: 96px;
    height: 62px;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(60, 60, 60);
    background-color: rgb(244, 244, 244);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    border-radius: 4px;
    margin-left: 10px;
    margin-right: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

.formula-expand {
    flex-shrink: 0;
    width: 52px;
    -unity-text-align: middle-center;
    font-size: 30px;
    color: rgb(107, 107, 107);
}

.fx {
    flex-shrink: 0;
    width: 62px;
    -unity-text-align: middle-center;
    font-size: 32px;
    color: rgb(107, 107, 107);
    -unity-font-style: italic;
    border-right-width: 1px;
    border-right-color: rgb(212, 212, 212);
}

.formula {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding-left: 14px;
    font-size: 27px;
    color: rgb(34, 34, 34);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ---------------------------------------------------------------- sheet tabs */

/* The sheet tabs are the game's navigation, so unlike the real app they stay put rather than
   hiding behind a sheet icon — and they sit low, inside thumb reach. */
.sheet-tabs-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 118px;
    background-color: rgb(247, 247, 247);
    border-top-width: 1px;
    border-top-color: rgb(212, 212, 212);
}

.sheet-tabs-scroll { flex-grow: 1; height: 118px; }

.sheet-list-btn, .sheet-add-btn {
    width: 92px;
    height: 118px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(107, 107, 107);
    font-size: 36px;
}

.sheet-tabs { flex-direction: row; align-items: center; height: 118px; }

.sheet-tab {
    height: 118px;
    flex-shrink: 0;
    white-space: nowrap;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(107, 107, 107);
    font-size: 33px;
}

.sheet-tab--active {
    background-color: rgb(255, 255, 255);
    color: rgb(24, 92, 55);
    -unity-font-style: bold;
    border-bottom-width: 5px;
    border-bottom-color: rgb(24, 92, 55);
}

/* Above the label rather than across it. With four short tab names the badge was landing squarely
   on the second syllable of 업무, which is worse than not having a badge. */
.sheet-tab__badge {
    position: absolute;
    top: 10px;
    right: 6px;
    min-width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(196, 43, 28);
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- command bar */

.commandbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 92px;
    padding-left: 12px;
    padding-right: 20px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-top-color: rgb(191, 191, 191);
}

.cmd-tab {
    height: 84px;
    min-width: 168px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    font-size: 34px;
}

.status-text { font-size: 26px; color: rgb(107, 107, 107); margin-left: 18px; }

.cell-stat { flex-direction: row; align-items: center; margin-left: 28px; }
.cell-stat__icon { font-size: 27px; margin-right: 10px; color: rgb(128, 128, 128); }
.cell-stat__value { font-size: 29px; color: rgb(70, 70, 70); }

#gemChip .cell-stat__value { color: rgb(70, 70, 70); }
#goldChip .cell-stat__value { color: rgb(70, 70, 70); }

/* ---------------------------------------------------------------- overlay */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
}

/* ---------------------------------------------------------------- sheet furniture */

.sheet-head {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 28px;
    padding-right: 28px;
    background-color: rgb(243, 243, 243);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.sheet-head__stat { font-size: 36px; -unity-font-style: bold; margin-right: 28px; }
.sheet-head .muted { font-size: 28px; white-space: normal; }

/* ---------------------------------------------------------------- generic pieces */

.panel {
    flex-shrink: 0;
    background-color: rgb(250, 250, 250);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    padding: 32px;
    margin-bottom: 26px;
}

.section-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(107, 107, 107);
    margin-bottom: 16px;
}

.muted { color: rgb(128, 128, 128); white-space: normal; }
.hidden { display: none; }

.btn {
    height: 141px;
    background-color: rgb(238, 238, 238);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(34, 34, 34);
    font-size: 45px;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.btn:hover { background-color: rgb(226, 239, 218); }
.btn:disabled { opacity: 0.4; }

.btn--primary {
    background-color: rgb(150, 112, 8);
    border-color: rgb(176, 132, 10);
    color: rgb(253, 246, 227);
}

.btn--primary:hover { background-color: rgb(24, 92, 55); }

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(191, 191, 191);
}

/* ---------------------------------------------------------------- home */

.home { flex-grow: 1; }

.home__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* stacked on the base art so a motion frame can cross-fade in */
.home__art-motion {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 0.9s;
}

.home__art-motion--on { opacity: 1; }

.home__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 992px;
    background-color: rgba(255, 255, 255, 0.62);
}

.home__strip {
    position: absolute;
    left: 32px;
    right: 32px;
    top: 26px;
    flex-direction: row;
    justify-content: space-between;
}

.home__stat {
    flex-grow: 1;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.72);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.6);
}

.home__stat-value { font-size: 48px; -unity-font-style: bold; color: rgb(176, 132, 10); }
.home__stat-key { font-size: 30px; color: rgb(107, 107, 107); }

.home__bubble {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 384px;
    padding: 32px;
    background-color: rgba(255, 255, 255, 0.82);
    border-radius: 29px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.7);
}

.home__who { font-size: 38px; color: rgb(33, 115, 70); -unity-font-style: bold; }

.home__speech {
    font-size: 43px;
    white-space: normal;
    margin-top: 13px;
    color: rgb(34, 34, 34);
}

.home__bond { margin-top: 26px; }
.home__bond-level { font-size: 32px; color: rgb(200, 60, 110); }

.home__bond-track {
    height: 16px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    overflow: hidden;
}

.home__bond-fill { height: 100%; background-color: rgb(200, 60, 110); }

.home__actions {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
    flex-direction: row;
}

.home__actions .btn { flex-grow: 1; margin-left: 8px; margin-right: 8px; }

/* ---------------------------------------------------------------- reveal */

.reveal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.94);
    align-items: center;
    justify-content: center;
}

.reveal__card {
    width: 896px;
    height: 1248px;
    border-radius: 32px;
    border-width: 4px;
    overflow: hidden;
    align-items: center;
    justify-content: flex-end;
}

.reveal__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal__plate {
    width: 100%;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.86);
    align-items: center;
}

.reveal__grade {
    font-size: 86px;
    -unity-font-style: bold;
}

.reveal__name {
    font-size: 54px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.reveal__nick { font-size: 35px; color: rgb(107, 107, 107); }

.reveal__line {
    font-size: 35px;
    color: rgb(70, 70, 70);
    margin-top: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.reveal__badge {
    margin-top: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 22px;
    font-size: 32px;
    background-color: rgb(150, 112, 8);
    color: rgb(253, 246, 227);
}

.reveal__hint {
    margin-top: 45px;
    font-size: 38px;
    color: rgb(107, 107, 107);
}

/* --- the tell -------------------------------------------------------------
   A column of light rises before the card resolves, in the rarity's colour.
   This is where the tension of a pull actually lives: by the time the art is
   on screen the player already knows, and the card is the confirmation. */

.tell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.tell__beam {
    width: 144px;
    height: 0;
    opacity: 0;
    transition-duration: 0.45s;
}

.tell__beam--up { height: 1760px; opacity: 0.9; }

.tell__ring {
    position: absolute;
    width: 256px;
    height: 256px;
    border-radius: 128px;
    border-width: 4px;
    opacity: 0;
    scale: 0.3 0.3;
    transition-duration: 0.5s;
}

.tell__ring--out { opacity: 0; scale: 3.4 3.4; }
.tell__ring--in { opacity: 0.95; scale: 1 1; }

.tell__label {
    position: absolute;
    bottom: 480px;
    font-size: 54px;
    -unity-font-style: bold;
    opacity: 0;
    transition-duration: 0.3s;
}

.tell__label--on { opacity: 1; }

/* the card landing */
.reveal__card {
    transition-duration: 0.28s;
}

/* ten-pull summary grid */

.reveal-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.reveal-grid__cell {
    width: 304px;
    height: 422px;
    margin: 10px;
    border-radius: 19px;
    border-width: 3px;
    overflow: hidden;
    justify-content: flex-end;
}

.reveal-grid__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-grid__plate {
    background-color: rgba(255, 255, 255, 0.86);
    padding-top: 6px;
    padding-bottom: 6px;
    align-items: center;
}

.reveal-grid__name { font-size: 29px; }
.reveal-grid__grade { font-size: 32px; -unity-font-style: bold; }

/* ---------------------------------------------------------------- roster */

.roster-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.card {
    width: 32%;
    margin: 0.66%;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: 10px;
    overflow: hidden;
}

/* Portrait proportions, cropped from the TOP — the face identifies the card, and a centred crop
   on a 2:3 illustration lands on the chest. */
.card__art {
    height: 340px;
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top 0;
}

.card__grade {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 26px;
    -unity-text-align: middle-center;
}

.card__role {
    position: absolute;
    right: 8px;
    top: 8px;
    padding: 4px 12px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.85);
    color: rgb(70, 70, 70);
    font-size: 21px;
}

.card__stars {
    position: absolute;
    left: 8px;
    bottom: 6px;
    font-size: 22px;
    -unity-font-style: bold;
}

.card__level {
    position: absolute;
    right: 8px;
    bottom: 6px;
    padding: 2px 10px;
    border-radius: 10px;
    background-color: rgba(20, 22, 28, 0.72);
    color: rgb(255, 255, 255);
    font-size: 20px;
}

.card__plate {
    padding: 8px 10px;
    background-color: rgb(248, 248, 248);
    border-top-width: 1px;
    border-top-color: rgb(226, 226, 226);
}

.card__name { font-size: 25px; -unity-font-style: bold; overflow: hidden; }
.card__sub { font-size: 20px; color: rgb(31, 111, 235); }
.card--locked .card__art { opacity: 0.25; }
.card--locked .card__name { color: rgb(150, 150, 150); }

/* A modal, not a second full screen. Tapping a card is a look at one card — taking over the whole
   display for it loses where you were in a list of fifty-five, and on the way back the scroll
   position went with it. The dim behind it is the overlay's own. */
.detail {
    width: 90%;
    max-height: 88%;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(196, 196, 196);
    overflow: hidden;
}

/* The height is set from the illustration's own aspect ratio in HeroDetail, so the whole card is
   visible with neither a crop nor letterbox bars. */
.detail__art {
    flex-shrink: 0;
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: stretch-to-fill;
}

.detail__scrim { display: none; }

.detail__head {
    padding: 22px 38px;
    background-color: rgb(243, 243, 243);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(212, 212, 212);
    border-bottom-color: rgb(212, 212, 212);
}

.detail__name { font-size: 64px; -unity-font-style: bold; }
.detail__nick { font-size: 38px; color: rgb(107, 107, 107); }

.detail__body {
    flex-grow: 1;
    padding: 38px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(238, 238, 238);
}

.stat-row__key { color: rgb(107, 107, 107); font-size: 38px; }
.stat-row__value { font-size: 38px; -unity-font-style: bold; }

.detail__close {
    position: absolute;
    right: 32px;
    top: 32px;
    width: 115px;
    height: 115px;
    border-radius: 58px;
    background-color: rgba(255, 255, 255, 0.8);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(34, 34, 34);
    font-size: 51px;
}

/* ---------------------------------------------------------------- party */

.party-slots {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 26px;
}

.slot {
    width: 304px;
    height: 419px;
    border-radius: 19px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(250, 250, 250);
    overflow: hidden;
    justify-content: flex-end;
}

.slot--empty {
    align-items: center;
    justify-content: center;
    border-color: rgb(226, 239, 218);
}

.slot__plus { font-size: 70px; color: rgb(160, 160, 160); }

.synergy-line {
    font-size: 35px;
    color: rgb(24, 92, 55);
    margin-bottom: 6px;
}

.power-readout {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 13px;
}

.power-readout__value {
    font-size: 83px;
    -unity-font-style: bold;
    color: rgb(176, 132, 10);
}

.power-readout__label {
    font-size: 35px;
    color: rgb(107, 107, 107);
    margin-left: 16px;
    margin-bottom: 16px;
}

/* ---------------------------------------------------------------- battle */

.battle {
    flex-grow: 1;
}

/* The battlefield is the worksheet. A painted landscape was both off-premise and unreadable behind
   16x28 pixel sprites; a tiled cell grid gives them a surface to stand on and survives the disguise,
   because what a passer-by sees is cells. */
/* The battlefield keeps the web build's 2:1 shape — a side-view street band across the top of
   the sheet, with the party's EX buttons below it. The backdrop texture is set from code because
   it is generated per phase. */
.battle__stage {
    flex-shrink: 0;
    flex-grow: 1;
    min-height: 540px;
    max-height: 760px;
    background-color: rgb(30, 34, 44);
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.fighter {
    position: absolute;
    width: 92px;
    align-items: center;
}

/* Pixel sprites want whole-number scale and no crop. 16x28 at 6x is 96x168, which reads clearly at
   arm's length on a phone and still lines the cast up on one baseline. */
.fighter__body {
    width: 52px;
    height: 92px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.fighter__body--chibi {
    width: 52px;
    height: 70px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Monsters face the party: the tileset draws everything facing right. */
.fighter--monster .fighter__body { scale: -1 1; }

/* Integer multiples only, and the web build's ratio: wave enemies 2x, bosses 3x. */
.fighter--boss { width: 220px; }
.fighter--boss .fighter__body { width: 78px; height: 138px; }
.fighter--boss .fighter__hpbar { width: 110px; }
.fighter--elite .fighter__body { width: 62px; height: 110px; }

.fighter--dead { opacity: 0.25; }

.fighter__hpbar {
    width: 74px;
    height: 10px;
    /* Tight under the feet. At the old 10px the bar floated a sprite-width below its owner once
       the cast was scaled up, and read as a mark on the road rather than as that thing's health. */
    margin-top: 2px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 8px;
    overflow: hidden;
}

.fighter__hpfill {
    height: 100%;
    background-color: rgb(33, 115, 70);
}

.fighter--monster .fighter__hpfill { background-color: rgb(196, 43, 28); }

.fighter__name { display: none; }

/* Damage numbers. White on the dark field rather than the old mustard, which was invisible over
   the road, and with a dark outline so they stay readable over a lit window or a sprite. */
.floater {
    position: absolute;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 12, 18, 0.9);
}

.floater--heal { color: rgb(24, 92, 55); }
.floater--skill { color: rgb(31, 111, 235); font-size: 38px; }

.battle__hud {
    height: 144px;
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    background-color: rgb(243, 243, 243);
}

.battle__wave {
    flex-grow: 1;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(34, 34, 34);
    transition-duration: 0.3s;
}

/* 야근: overtime has started and the errors are hitting harder every second */
.battle__wave--enraged { color: rgb(196, 43, 28); }

.ex-bar {
    flex-direction: row;
    height: 256px;
    align-items: center;
    justify-content: center;
    background-color: rgb(250, 250, 250);
    padding-top: 16px;
    padding-bottom: 16px;
}

.ex-button {
    width: 211px;
    height: 211px;
    margin-left: 11px;
    margin-right: 11px;
    border-radius: 29px;
    border-width: 3px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(243, 243, 243);
    overflow: hidden;
    justify-content: flex-end;
    align-items: center;
    transition-duration: 0.15s;
}

.ex-button--ready {
    border-color: rgb(176, 132, 10);
    scale: 1.05 1.05;
}

.ex-button--spent { opacity: 0.45; }

.ex-button__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.ex-button__charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(240, 196, 70, 0.28);
}

.ex-button__label {
    width: 100%;
    font-size: 27px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.85);
    padding-top: 5px;
    padding-bottom: 5px;
}

.result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.92);
    align-items: center;
    justify-content: center;
}

.result__title {
    font-size: 115px;
    -unity-font-style: bold;
    margin-bottom: 26px;
}

.result__title--win { color: rgb(176, 132, 10); }
.result__title--lose { color: rgb(196, 43, 28); }

/* ---------------------------------------------------------------- daily */

.stamp__row { flex-direction: row; margin-top: 13px; margin-bottom: 13px; }

.stamp__dot {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    margin-right: 13px;
    background-color: rgb(238, 238, 238);
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    transition-duration: 0.2s;
}

.stamp__dot--on {
    background-color: rgb(33, 115, 70);
    border-color: rgb(196, 152, 20);
}

.quest--done { opacity: 0.5; }

.quest__track {
    height: 19px;
    margin-top: 16px;
    background-color: rgb(238, 238, 238);
    border-radius: 10px;
    overflow: hidden;
}

.quest__fill { height: 100%; background-color: rgb(31, 111, 235); }

.quest__meta { font-size: 34px; color: rgb(107, 107, 107); margin-top: 13px; }

/* a count of claimable rewards, parked on the nav button */
.nav-badge {
    position: absolute;
    right: 29px;
    top: 22px;
    min-width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgb(196, 43, 28);
    color: rgb(120, 40, 70);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 13px;
    padding-right: 13px;
}

/* ---------------------------------------------------------------- onboarding */

.onboard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 45px;
    padding-right: 45px;
}

.onboard__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(243, 243, 243);
}

.onboard__card {
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 32px;
    border-width: 1px;
    border-color: rgba(191, 191, 191, 0.8);
    padding: 48px;
}

.onboard__title {
    font-size: 70px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    margin-bottom: 29px;
}

.onboard__line {
    font-size: 43px;
    white-space: normal;
    margin-bottom: 13px;
    color: rgb(34, 34, 34);
}

.onboard__tip {
    margin-top: 35px;
    margin-bottom: 35px;
    padding: 29px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 22px;
    border-left-width: 4px;
    border-left-color: rgb(31, 111, 235);
}

.onboard__tip-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
    margin-bottom: 6px;
}

.onboard__card .btn { margin-top: 16px; }

/* ---------------------------------------------------------------- EX cut-in */

/* The signature moment: firing a skill throws the character's own illustration across the
   screen shouting their line. It is the one time the art is at full size during play, and
   it is what makes a skill feel like a person acting rather than a number resolving. */

/* `clips` tells LayoutAudit that children overrunning this box are deliberate. */
/* The EX cut-in: a band across the bottom of the battlefield, not a takeover of it.

   It used to cover the whole field, so firing a skill hid the fight the skill was part of — the
   party, the monsters and the effects all disappeared for a second and a quarter behind a portrait.
   Blue Archive puts its EX portrait in the lower corner for exactly this reason: the moment is
   worth announcing, but not worth blinding the player through.

   `clips` tells LayoutAudit that children overrunning this box are deliberate. */
.cutin {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 46%;
    justify-content: center;
    overflow: hidden;
}

.cutin__sweep {
    position: absolute;
    left: -120%;
    right: 120%;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 20, 28, 0.72);
    border-top-width: 3px;
    border-top-color: rgba(240, 196, 70, 0.9);
    transition-duration: 0.28s;
}

.cutin__sweep--in { left: -10%; right: -10%; }

/* A bust crop anchored to the left of the band, sliding in from off-screen. */
.cutin__art {
    position: absolute;
    left: -40%;
    bottom: 0;
    width: 46%;
    height: 150%;
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__art--in { left: -2%; opacity: 1; }

.cutin__plate {
    position: absolute;
    right: 38px;
    align-items: flex-end;
    opacity: 0;
    transition-duration: 0.3s;
}

.cutin__plate--in { opacity: 1; }

.cutin__skill {
    font-size: 74px;
    -unity-font-style: bold;
    color: rgb(150, 112, 8);
}

.cutin__line {
    font-size: 42px;
    color: rgb(34, 34, 34);
    max-width: 896px;
    white-space: normal;
    -unity-text-align: upper-right;
    margin-top: 10px;
}

/* --- hit feedback ------------------------------------------------------- */

.fighter__body { transition-duration: 0.09s; }

/* a lunge towards the enemy on the swing, so an attack has a body behind it */
.fighter--hero .fighter__body--swing { translate: 22px 0; }
.fighter--monster .fighter__body--swing { translate: -22px 0; }

.fighter__body--hurt { scale: 1.18 1.18; }

.fighter--dead {
    opacity: 0.25;
    transition-duration: 0.35s;
    scale: 0.82 0.82;
}

/* ---------------------------------------------------------------- story */

/* episode list */

.ep--locked { opacity: 0.45; }

.ep__cast { flex-direction: row; margin-bottom: 16px; }

.ep__face {
    width: 102px;
    height: 102px;
    border-radius: 51px;
    margin-right: -14px;
    border-width: 2px;
    border-color: rgb(212, 212, 212);
    background-color: rgb(238, 238, 238);
    -unity-background-scale-mode: scale-and-crop;
}

/* the log itself */

.chat__header {
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.chat__title { font-size: 54px; -unity-font-style: bold; }

.chat-room {
    font-size: 35px;
    color: rgb(31, 111, 235);
    margin-top: 6px;
}

.chat-line {
    flex-direction: row;
    margin-bottom: 26px;
    align-items: flex-start;
}

.chat-line--mine { justify-content: flex-end; }

.chat-line--sys {
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 29px;
}

.chat-avatar {
    width: 122px;
    height: 122px;
    border-radius: 61px;
    margin-right: 19px;
    border-width: 2px;
    border-color: rgb(191, 191, 191);
    background-color: rgb(243, 243, 243);
    -unity-background-scale-mode: scale-and-crop;
}

/* a repeated speaker keeps the indent but drops the face */
.chat-avatar--blank {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.chat-column { flex-shrink: 1; }

.chat-who {
    font-size: 32px;
    color: rgb(107, 107, 107);
    margin-bottom: 8px;
}

.chat-bubble {
    max-width: 1056px;
    padding: 24px;
    border-radius: 26px;
    background-color: rgb(240, 240, 240);
    font-size: 38px;
    white-space: normal;
}

.chat-line--mine .chat-bubble {
    background-color: rgb(226, 239, 218);
    color: rgb(253, 246, 227);
}

.chat-line--sys .chat-bubble {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    color: rgb(107, 107, 107);
    font-size: 34px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- sheet furniture */

/* Every sheet opens with a summary strip, the way a real one opens with a header row. */


.xl-row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.xl-row--head {
    background-color: rgb(243, 243, 243);
    border-bottom-color: rgb(191, 191, 191);
}

.xl-row--head .xl-cell { -unity-font-style: bold; color: rgb(70, 70, 70); }
.xl-row--boss .xl-cell { color: rgb(150, 112, 8); -unity-font-style: bold; }
.xl-row--locked .xl-cell { color: rgb(170, 170, 170); }

.xl-cell {
    flex-shrink: 1;
    width: 230px;
    padding-left: 26px;
    font-size: 35px;
    border-right-width: 1px;
    border-right-color: rgb(226, 226, 226);
}

.xl-cell--wide { flex-grow: 1; flex-basis: 0; min-width: 0; }
.xl-cell--num { -unity-text-align: middle-right; padding-right: 26px; }
.xl-body { flex-grow: 1; }

/* ---------------------------------------------------------------- album */

.album { flex-grow: 1; }
.album__scroll { flex-grow: 1; }

.album__grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 19px;
}

/* Three across on a 1080-wide phone, at the art's own 2:3 — cropping a card to a square is what
   made the thumbnails look mismatched. */
.album__cell {
    width: 33%;
    padding: 10px;
}

.album__art {
    height: 752px;
    background-color: rgb(238, 238, 238);
    border-width: 1px;
    border-color: rgb(212, 212, 212);
    -unity-background-scale-mode: scale-and-crop;
}

.album__name {
    font-size: 32px;
    -unity-text-align: middle-center;
    padding-top: 10px;
}

.album__cell--locked .album__art { opacity: 0.18; }
.album__cell--locked .album__name { color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- full-size viewer */

.viewer {
    width: 96%;
    height: 94%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    align-items: center;
}

/* scale-to-fit, not scale-and-crop: the whole point of the viewer is that nothing is cut off. */
.viewer__art {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.viewer__caption { align-items: center; padding: 16px; }
.viewer__name { font-size: 54px; -unity-font-style: bold; color: rgb(33, 115, 70); }
.viewer__nick { font-size: 35px; color: rgb(107, 107, 107); }

.viewer__skins { flex-direction: row; justify-content: center; padding-bottom: 16px; }

.viewer__skin {
    height: 102px;
    min-width: 224px;
    margin: 0 10px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 35px;
}

.viewer__skin--active {
    background-color: rgb(226, 239, 218);
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
}

.viewer__close { margin-bottom: 22px; min-width: 320px; }

.detail__skins { flex-direction: row; justify-content: center; padding: 13px; }

.detail__skin {
    height: 90px;
    min-width: 192px;
    margin: 0 8px;
    background-color: rgb(243, 243, 243);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    border-radius: 6px;
    font-size: 32px;
}

/* ---------------------------------------------------------------- picker */

.picker {
    width: 86%;
    max-height: 80%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: 29px;
}

.picker__list { flex-grow: 1; }

.picker__row {
    flex-direction: row;
    align-items: center;
    min-height: 141px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 226, 226);
}

.picker__face {
    width: 102px;
    height: 102px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgb(212, 212, 212);
}

.picker__name { font-size: 38px; }

/* ---------------------------------------------------------------- charts */

.charts { flex-grow: 1; }
.charts__scroll { flex-grow: 1; padding: 22px; }

/* A chart object dropped on a sheet: a plain white box with a border and a shadowless edge. */
.chart-obj {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
    padding: 22px;
    margin-bottom: 26px;
}

.chart-obj__title {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 16px;
}

.chart-row { flex-direction: row; align-items: center; height: 77px; }
.chart-row__label { width: 320px; font-size: 34px; }
.chart-row__track { flex-grow: 1; height: 42px; background-color: rgb(243, 243, 243); }
.chart-row__fill { height: 42px; background-color: rgb(33, 115, 70); }
.chart-row__value { width: 192px; -unity-text-align: middle-right; font-size: 34px; }

/* Excel's 작업 창: a panel docked over the sheet rather than a centred dialog. */
.task-pane {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 86%;
    background-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-left-color: rgb(191, 191, 191);
    padding: 26px;
}

/* ---------------------------------------------------------------- cost pool */

.cost-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.cost-row__value {
    width: 70px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(31, 111, 235);
}

.cost-row__track { flex-direction: row; flex-grow: 1; }

.cost-cell {
    flex-grow: 1;
    height: 24px;
    margin-right: 4px;
    background-color: rgb(226, 226, 226);
    border-width: 1px;
    border-color: rgb(191, 191, 191);
}

.cost-cell--full { background-color: rgb(31, 111, 235); }
.cost-cell--part { background-color: rgb(150, 190, 245); }

.ex-button__cost {
    position: absolute;
    top: 6px;
    left: 8px;
    min-width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(31, 111, 235);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* charged, but the budget is not there yet */
.ex-button--poor { opacity: 0.55; }
.ex-button--poor .ex-button__cost { background-color: rgb(150, 150, 150); }

/* ---------------------------------------------------------------- icons */

/* Drawn, not typed. Unity's default font has no glyph for a search loupe or a window, so those
   characters rendered as missing-glyph boxes — the boss key looked like it was simply absent. */
.icon { -unity-background-scale-mode: scale-to-fit; }
.icon--back { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/back.png"); }
.icon--search { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/search.png"); }
.icon--undo { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/undo.png"); }
.icon--bosskey { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/bosskey.png"); }
.icon--bosskey-on { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/bosskey_on.png"); }
.icon--overflow { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/overflow.png"); }
.icon--sheets { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/sheets.png"); }
.icon--add { background-image: url("project://database/Assets/ExcelHeroes/Resources/Art/Icons/add.png"); }

/* The corner cell's select-all mark, drawn with a border rather than a glyph. */
.ws-corner {
    border-bottom-width: 14px;
    border-bottom-color: rgb(170, 170, 170);
    border-left-width: 14px;
    border-left-color: rgba(0, 0, 0, 0);
}

/* ---------------------------------------------------------------- 위장 모드 시트 */

.stealth-sheet { flex-grow: 1; }
.xl-row--total { border-top-width: 2px; border-top-color: rgb(70, 70, 70); }
.xl-row--total .xl-cell { -unity-font-style: bold; }
.xl-cell--up { color: rgb(24, 92, 55); }
.xl-cell--down { color: rgb(196, 43, 28); }

/* The monster strips come out of the tileset already facing the party, so the blanket mirror that
   the hero-facing sprites need would turn them back around.

   They are also a different kind of frame: the web build composes each monster into a 64x64 box
   with the creature already scaled and standing on the bottom edge, whereas the hero strips are the
   raw 16x28 cells. Sizing both boxes the same made every monster look like a doll next to the
   party. 64 canvas pixels is 84 at this field's scale. */
.fighter--monster { width: 116px; }

.fighter--monster .fighter__body--creature {
    scale: 1 1;
    width: 110px;
    height: 110px;
}

.fighter--boss .fighter__body--creature { width: 216px; height: 196px; }
.fighter--boss.fighter--monster { width: 224px; }

/* Pixel HP bars: hard edges, a one-pixel dark border and no rounding, so they sit on the same grid
   as the sprites instead of looking like a web widget dropped onto a tileset. */
.fighter__hpbar {
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(27, 29, 37);
    background-color: rgb(58, 62, 74);
    overflow: hidden;
}

.fighter__hpfill { border-radius: 0; }
.fighter--hero .fighter__hpfill { background-color: rgb(74, 200, 108); }
.fighter--monster .fighter__hpfill { background-color: rgb(214, 62, 52); }

/* ---------------------------------------------------------------- shots */

/* Office supplies in flight. Small and hard-edged so they belong to the pixel layer rather than
   looking like UI drawn over it. */
.shot {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(27, 29, 37);
}

.shot--drop { background-color: rgb(214, 62, 52); border-radius: 7px; }
.shot--slash { width: 22px; height: 6px; background-color: rgb(255, 240, 200); }

/* ---------------------------------------------------------------- 프롤로그 */

/* Letterboxed, not full bleed: the illustration sits in a band with black above and below, which
   is how the web build frames it. Filling a 9:16 phone with a 16:9 picture means cropping most of
   it away, and the crop always takes the part with the character in it. */
.prologue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 9, 13);
    justify-content: center;
    padding-bottom: 180px;
}

/* The letterbox. Its height is set from the picture's aspect ratio in PrologueScreen, so the
   left and right edges of the illustration always reach the screen and the spare space ends up
   above and below it instead of being cropped off the sides. */
.prologue__stage {
    width: 100%;
    background-color: rgb(0, 0, 0);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.prologue__art {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.prologue__head {
    margin-left: 48px;
    margin-top: 56px;
    flex-direction: row;
    align-items: center;
}

.prologue__counter {
    width: 54px;
    height: 54px;
    -unity-text-align: middle-center;
    font-size: 28px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 27px;
    margin-right: 16px;
}

.prologue__title { font-size: 40px; color: rgb(255, 255, 255); -unity-font-style: bold; }

.prologue__body {
    margin-left: 48px;
    margin-right: 48px;
    margin-top: 32px;
    font-size: 40px;
    color: rgb(240, 242, 248);
    white-space: normal;
}

.prologue__foot {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 56px;
    flex-direction: row;
    align-items: center;
}

.prologue__skip {
    height: 88px;
    min-width: 180px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    border-radius: 8px;
    color: rgb(215, 220, 232);
    font-size: 32px;
}

.prologue__dots { flex-grow: 1; flex-direction: row; justify-content: center; }

.prologue__dot {
    width: 18px;
    height: 18px;
    margin-left: 7px;
    margin-right: 7px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.25);
}

.prologue__dot--on { background-color: rgb(33, 115, 70); }

.prologue__nav {
    height: 88px;
    min-width: 168px;
    margin-left: 14px;
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 0;
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 32px;
}

.prologue__nav:disabled { opacity: 0.35; }
.prologue__nav--primary { background-color: rgb(33, 115, 70); }

/* ---------------------------------------------------------------- battle log */

/* Rows in the sheet under the field, numbered like cells. In 위장 모드 the same rows carry
   recalculation progress, which is the whole reason the log is here and not in a floating panel. */
.battle-log {
    flex-shrink: 1;
    max-height: 420px;
    background-color: rgb(255, 255, 255);
}

.log-row {
    flex-direction: row;
    align-items: center;
    height: 54px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(238, 238, 238);
}

.log-row__n {
    width: 74px;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(160, 160, 160);
    border-right-width: 1px;
    border-right-color: rgb(238, 238, 238);
}

.log-row__text { padding-left: 18px; font-size: 24px; color: rgb(70, 70, 70); }

/* ---------------------------------------------------------------- 필터 바 */

.filter-bar {
    flex-shrink: 0;
    padding: 10px 16px 14px 16px;
    background-color: rgb(250, 250, 250);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 212, 212);
}

.filter-bar__label { font-size: 24px; color: rgb(107, 107, 107); margin-bottom: 6px; }

.filter-row { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 6px; }
.filter-row__label { width: 76px; font-size: 24px; color: rgb(107, 107, 107); }

/* Chips, not dropdowns: a select on a phone is two taps and a modal, and these lists are short. */
.filter-chip {
    height: 62px;
    min-width: 86px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    border-radius: 31px;
    color: rgb(70, 70, 70);
    font-size: 24px;
}

.filter-chip--on {
    background-color: rgb(226, 239, 218);
    border-color: rgb(33, 115, 70);
    color: rgb(24, 92, 55);
    -unity-font-style: bold;
}

.filter-empty { padding: 60px; -unity-text-align: middle-center; font-size: 28px; }

/* Ash, and the odd sheet of office paper. Two pixels each — they are weather, not decoration. */
.mote {
    position: absolute;
    width: 4px;
    height: 4px;
    background-color: rgba(220, 220, 220, 0.42);
}

.mote--paper {
    width: 10px;
    height: 8px;
    background-color: rgba(236, 236, 226, 0.7);
}


/* ---------------------------------------------------------------- AUTO + office upgrades */

/* One toggle where the auto-skill and speed buttons used to be. Off is an outline, on is filled,
   so its state reads from across the room without anyone having to parse ON / OFF. */
.auto-toggle {
    flex-shrink: 0;
    min-width: 132px;
    height: 68px;
    margin-left: 12px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(150, 156, 170);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 8px;
}

.auto-toggle--on {
    color: rgb(12, 16, 22);
    background-color: rgb(120, 214, 160);
    border-color: rgb(120, 214, 160);
}

/* The gold sink, as a strip of four cells under the EX bar. Cells, deliberately: this is a
   spreadsheet, and a row of bordered boxes with a number in each is what one looks like. */
.upgrades {
    flex-direction: row;
    flex-shrink: 0;
    height: 124px;
    margin-top: 8px;
    margin-left: 6px;
    margin-right: 6px;
}

.upgrade {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 3px;
    margin-right: 3px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgb(250, 250, 250);
    border-width: 1px;
    border-color: rgb(205, 205, 205);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

/* Affordable is the only state worth colouring: everything else is just a price you cannot pay. */
.upgrade--ready {
    background-color: rgb(233, 246, 238);
    border-color: rgb(33, 115, 70);
}

.upgrade__name {
    font-size: 24px;
    color: rgb(60, 62, 70);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.upgrade__level {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    margin-top: 4px;
}

.upgrade__cost {
    font-size: 23px;
    color: rgb(126, 130, 140);
    margin-top: 2px;
}

.result__auto {
    font-size: 26px;
    color: rgb(150, 156, 170);
    margin-top: 14px;
}

/* ---------------------------------------------------------------- sheet list */

.sheet-list {
    width: 84%;
    max-height: 76%;
    background-color: rgb(255, 255, 255);
    border-radius: 10px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    padding-right: 18px;
}

.sheet-list__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
    margin-bottom: 12px;
    margin-left: 10px;
}

.sheet-list__row {
    height: 96px;
    font-size: 30px;
    color: rgb(40, 42, 48);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(232, 232, 232);
    -unity-text-align: middle-left;
    padding-left: 18px;
}

.sheet-list__row--active {
    color: rgb(33, 115, 70);
    -unity-font-style: bold;
    background-color: rgb(240, 248, 243);
}


/* ---------------------------------------------------------------- roster sections */

/* The sheet header is a title and a count, and the count is the whole of the codex readout:
   a number on the right, where a spreadsheet puts its numbers. */
.sheet-head--tight {
    flex-wrap: nowrap;
    padding-top: 12px;
    padding-bottom: 12px;
}

.sheet-head__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
}

.sheet-head__count {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    -unity-text-align: middle-right;
}

/* One band per grade. The coloured rule down the left is what makes the sections scannable while
   scrolling fast — the tag alone disappears at speed. */
.grade-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 74px;
    margin-top: 18px;
    margin-left: 10px;
    margin-right: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(246, 246, 246);
    border-bottom-width: 1px;
    border-bottom-color: rgb(216, 216, 216);
}

.grade-head__rule {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
}

.grade-head__tag {
    min-width: 52px;
    height: 52px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(255, 255, 255);
    border-radius: 4px;
    margin-right: 14px;
}

.grade-head__label {
    font-size: 28px;
    color: rgb(70, 72, 80);
}

.grade-head__count {
    font-size: 28px;
    color: rgb(120, 124, 134);
}


/* ---------------------------------------------------------------- Excel dialog */

/* The shape of an Office dialog: a grey caption bar, a body with the message and an icon, and a
   button row bottom-right. Used for anything that has to interrupt, so interruptions look like
   part of the spreadsheet rather than part of a game. */
.xl-dialog {
    width: 90%;
    max-height: 86%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(150, 150, 150);
    border-radius: 6px;
    overflow: hidden;
}

.xl-dialog__caption {
    flex-direction: row;
    align-items: center;
    height: 88px;
    flex-shrink: 0;
    background-color: rgb(242, 242, 242);
    border-bottom-width: 1px;
    border-bottom-color: rgb(214, 214, 214);
    padding-left: 24px;
}

.xl-dialog__caption-title {
    font-size: 28px;
    color: rgb(70, 72, 78);
}

.xl-dialog__close {
    width: 88px;
    height: 88px;
    font-size: 32px;
    color: rgb(90, 92, 98);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.xl-dialog__body {
    padding-top: 28px;
    padding-bottom: 20px;
    padding-left: 28px;
    padding-right: 28px;
}

.xl-dialog__head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 22px;
}

/* The round information glyph Office puts beside a message. Drawn rather than imported, because
   Unity's default font has no symbol for it. */
.xl-dialog__icon {
    width: 68px;
    height: 68px;
    flex-shrink: 0;
    margin-right: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold-and-italic;
    font-size: 36px;
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-radius: 34px;
}

.xl-dialog__head-text { flex-grow: 1; flex-shrink: 1; }

.xl-dialog__title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(30, 32, 38);
}

.xl-dialog__subtitle {
    font-size: 26px;
    color: rgb(120, 124, 134);
    margin-top: 6px;
}

/* A block of worksheet rows inside the dialog: row numbers, cell borders, the lot. */
.xl-dialog__sheet {
    border-width: 1px;
    border-color: rgb(214, 214, 214);
}

.xl-row {
    flex-direction: row;
    align-items: center;
    min-height: 82px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(228, 228, 228);
}

.xl-row__n {
    width: 62px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(130, 134, 142);
    background-color: rgb(243, 243, 243);
    border-right-width: 1px;
    border-right-color: rgb(214, 214, 214);
    height: 100%;
}

.xl-row__cell {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 28px;
    color: rgb(42, 44, 50);
    padding-left: 18px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.xl-row--grant { background-color: rgb(240, 248, 243); }

.xl-row__value {
    flex-shrink: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    -unity-text-align: middle-right;
    padding-right: 20px;
}

.xl-dialog__note {
    font-size: 25px;
    color: rgb(126, 130, 140);
    white-space: normal;
    margin-top: 18px;
}

.xl-dialog__foot {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 18px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgb(247, 247, 247);
    border-top-width: 1px;
    border-top-color: rgb(222, 222, 222);
}

.xl-btn {
    min-width: 200px;
    height: 92px;
    margin-left: 14px;
    font-size: 30px;
    color: rgb(45, 47, 53);
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(170, 172, 178);
    border-radius: 4px;
}

/* The default button — the one Enter would press. */
.xl-btn--default {
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-color: rgb(24, 88, 54);
    -unity-font-style: bold;
}


/* ---------------------------------------------------------------- check-in stamp */

.stamp {
    flex-shrink: 0;
    margin: 14px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgb(252, 252, 252);
    border-width: 1px;
    border-color: rgb(210, 210, 210);
    border-radius: 6px;
}

.stamp__head { flex-direction: row; align-items: center; margin-bottom: 16px; }
.stamp__title { font-size: 34px; -unity-font-style: bold; color: rgb(38, 40, 46); }
.stamp__streak { font-size: 28px; color: rgb(33, 115, 70); -unity-font-style: bold; }

/* Eight day cells across, so a week plus "이후" fits one row without wrapping on a phone. */
.stamp__grid { flex-direction: row; }

.stamp-day {
    flex-grow: 1;
    flex-basis: 0;
    height: 132px;
    margin-left: 3px;
    margin-right: 3px;
    align-items: center;
    justify-content: center;
    background-color: rgb(246, 246, 246);
    border-width: 1px;
    border-color: rgb(216, 216, 216);
    border-radius: 4px;
}

.stamp-day--on { background-color: rgb(236, 246, 240); border-color: rgb(160, 200, 178); }

/* Today is an outline rather than a fill — a filled cell means "already stamped". */
.stamp-day--today {
    border-width: 3px;
    border-color: rgb(33, 115, 70);
    background-color: rgb(255, 255, 255);
}

.stamp-day__n { font-size: 24px; color: rgb(110, 114, 122); }
.stamp-day__gems { font-size: 26px; -unity-font-style: bold; color: rgb(52, 96, 178); margin-top: 4px; }

/* The stamp itself: a red approval mark at an angle, the way an actual 도장 lands. */
.stamp-day__mark {
    position: absolute;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(199, 62, 62, 0.85);
    border-width: 2px;
    border-color: rgba(199, 62, 62, 0.7);
    border-radius: 6px;
    padding-left: 6px;
    padding-right: 6px;
    rotate: -14deg;
}

.stamp__go { margin-top: 18px; }
.stamp__done { margin-top: 16px; font-size: 27px; color: rgb(126, 130, 140); }

/* ---------------------------------------------------------------- summon banner

   Built from docs/design/pickup.md. Flat-only tricks throughout, because USS has no gradients
   and no box-shadow: thick bottom borders stand in for elevation and carry the rarity colour,
   one skewed tag breaks the spreadsheet grid, and an oversized low-opacity word fills the space
   the splash art leaves empty. */

.gacha { flex-grow: 1; background-color: rgb(243, 245, 247); }
.gacha__scroll { flex-grow: 1; }

.banner {
    height: 800px;
    flex-shrink: 0;
    justify-content: flex-end;
    padding-bottom: 40px;
    padding-left: 40px;
    background-color: rgb(26, 37, 48);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
    overflow: hidden;
}

.banner__watermark {
    position: absolute;
    left: 20px;
    bottom: 150px;
    font-size: 200px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    opacity: 0.08;
}

/* The one geometric break in a screen made entirely of right angles. */
.banner__tag {
    position: absolute;
    left: 40px;
    top: 36px;
    height: 62px;
    padding-left: 30px;
    padding-right: 30px;
    justify-content: center;
    rotate: -2deg;
    scale: 1 1;
}

.banner__tag-text {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
}

.banner__plate {
    width: 700px;
    padding: 26px 30px 26px 30px;
    background-color: rgb(255, 255, 255);
    border-left-width: 12px;
}

.banner__kicker {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(33, 115, 70);
    letter-spacing: 4px;
}

.banner__title {
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(26, 37, 48);
}

/* ---- the two featured cards ---- */

.pickup {
    flex-direction: row;
    flex-shrink: 0;
    padding: 28px 28px 0 28px;
}

.pcard {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    /* Rarity and elevation in one stroke — the colour is set per card from grades.json. */
    border-bottom-width: 16px;
    overflow: hidden;
}

.pcard__art {
    height: 320px;
    background-color: rgb(232, 234, 238);
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
}

.pcard__grade {
    position: absolute;
    left: 0;
    top: 0;
    min-width: 64px;
    height: 64px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 32px;
    color: rgb(20, 22, 28);
    border-bottom-right-radius: 10px;
}

.pcard__foot { padding: 18px 22px 20px 22px; }

.pcard__name {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(26, 37, 48);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pcard__track {
    height: 12px;
    margin-top: 14px;
    background-color: rgb(226, 229, 234);
    border-radius: 6px;
    overflow: hidden;
}

.pcard__fill { height: 100%; }

.pcard__line { flex-direction: row; align-items: center; margin-top: 12px; }

.pcard__points { font-size: 28px; color: rgb(110, 116, 128); }

.pcard__take {
    min-width: 130px;
    height: 66px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-width: 0;
    border-bottom-width: 6px;
    border-bottom-color: rgb(22, 82, 50);
    border-radius: 8px;
}

.pcard__take:disabled {
    background-color: rgb(214, 216, 220);
    border-bottom-color: rgb(190, 192, 198);
    color: rgb(150, 154, 162);
}

/* ---- rates and the two pity floors ---- */

.rates {
    margin: 28px 28px 24px 28px;
    padding: 24px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
}

.rates__row { flex-direction: row; margin-bottom: 18px; }

.rate-chip {
    flex-direction: row;
    align-items: center;
    height: 60px;
    margin-right: 10px;
    padding-right: 14px;
    background-color: rgb(243, 245, 247);
    border-radius: 6px;
}

.rate-chip__id {
    width: 56px;
    height: 60px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(20, 22, 28);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.rate-chip__rate { font-size: 26px; color: rgb(90, 96, 106); margin-left: 10px; }

.pity__row { flex-direction: row; align-items: center; height: 62px; }

.pity__tag {
    width: 56px;
    height: 56px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(20, 22, 28);
    border-radius: 6px;
    margin-right: 16px;
}

.pity__track {
    flex-grow: 1;
    height: 16px;
    background-color: rgb(230, 233, 238);
    border-radius: 8px;
    overflow: hidden;
}

.pity__fill { height: 100%; }

.pity__label {
    width: 140px;
    -unity-text-align: middle-right;
    font-size: 28px;
    color: rgb(90, 96, 106);
}

/* ---- the foot ---- */

.pull-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 20px 28px 26px 28px;
    background-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-top-color: rgb(222, 226, 232);
}

.pull-bar__points { width: 210px; flex-shrink: 0; }
.pull-bar__label { font-size: 26px; -unity-font-style: bold; color: rgb(130, 140, 150); }
.pull-bar__value { font-size: 52px; -unity-font-style: bold; color: rgb(26, 37, 48); }

.pull-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 140px;
    margin-left: 16px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(26, 37, 48);
    background-color: rgb(255, 255, 255);
    border-width: 4px;
    border-color: rgb(26, 37, 48);
    border-bottom-width: 12px;
    border-radius: 12px;
    white-space: normal;
}

.pull-btn--primary {
    flex-grow: 1.8;
    color: rgb(255, 255, 255);
    background-color: rgb(33, 115, 70);
    border-color: rgb(33, 115, 70);
    border-bottom-color: rgb(20, 74, 45);
}

.pull-btn:disabled {
    color: rgb(160, 164, 172);
    background-color: rgb(238, 240, 244);
    border-color: rgb(206, 210, 216);
    border-bottom-color: rgb(190, 194, 200);
}


/* The first-run home screen, before anyone has been recruited. It replaces the battlefield rather
   than sitting inside it — a notice on a black band under an empty EX bar reads as a broken
   battle, which is exactly what it is not. */
.battle-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 60px;
    padding-right: 60px;
}

.battle-empty__title {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(40, 42, 48);
}

.battle-empty__line {
    font-size: 30px;
    color: rgb(120, 124, 134);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 16px;
}

.battle-empty__go { margin-top: 40px; min-width: 460px; }


/* The run's result. Narrower than the onboarding dialog because it carries three numbers, and it
   never needs to be dismissed — the next run takes it down. */
.result-dialog { width: 84%; }


/* ---------------------------------------------------------------- hit effects */

/* The Painter2D canvas the arcs, bursts and sparks are drawn on. It covers the field and never
   takes a click; the fighters are added after it, so nothing is painted over a face. */
.fx-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* One frame of blowout on the thing that just got hit. The eye reads this as contact before it
   reads the number, which is most of why a hit lands at all. */
.fighter__body--flash {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    scale: 1.12 1.12;
}

.floater--crit {
    font-size: 58px;
    color: rgb(250, 204, 70);
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
}

/* 콤보. Only appears once a run of hits is worth noticing, so it means something when it does. */
.combo {
    position: absolute;
    right: 18px;
    top: 14px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(250, 204, 70);
    opacity: 0;
}

.combo--on { opacity: 1; }
