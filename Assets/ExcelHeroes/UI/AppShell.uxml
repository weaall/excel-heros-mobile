<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="App.uss" />
    <!--
      A landscape mobile game, held sideways, laid out against how Blue Archive lays its own out.

      Copied from its screens rather than approximated from memory:

        * A light top bar. On the main screen it carries the player plate — the dark badge with the
          rank on a coloured tab that it puts in this exact corner. On every other screen that
          plate is replaced by a round back arrow and the screen's name, which is what its 부대 편성
          and 현상수배 screens do.
        * Currencies are white pills with a coloured icon, a bold dark number and a + to buy more,
          and the settings and home buttons sit to their right.
        * Navigation is a row of icon-over-label buttons along the bottom, every screen on it, with
          one loud call to action in the corner. No overflow menu: a screen behind a menu is a
          screen players never learn exists.
        * Everything between is the scene, full bleed, with the readouts floating on it.

      The Excel disguise this file used to carry — a green app bar, a formula bar, column letters,
      a row gutter and sheet tabs — is gone, along with the boss key that only served it.
    -->
    <ui:VisualElement name="root" class="root">

        <ui:VisualElement name="topbar" class="topbar">
            <!-- 메인 only: who is playing and how far they have got. -->
            <ui:VisualElement name="playerPlate" class="plate clips">
                <ui:VisualElement class="plate__rank">
                    <ui:Label text="Lv" class="plate__rank-word" />
                    <ui:Label name="stageValue" text="1" class="plate__rank-num" />
                </ui:VisualElement>
                <ui:VisualElement class="plate__body">
                    <ui:Label name="docTitle" text="김인턴" class="plate__name" />
                    <ui:Label name="plateSub" text="" class="plate__sub" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Every other screen: back to 메인, and the screen's name. -->
            <ui:VisualElement name="navBack" class="navback hidden">
                <ui:Button name="backBtn" class="navback__btn icon" />
                <ui:Label name="screenTitle" text="" class="navback__title" />
            </ui:VisualElement>

            <ui:VisualElement class="spacer" />

            <ui:VisualElement name="goldChip" class="chip">
                <ui:Label name="goldIcon" text="" class="chip__icon icon" />
                <ui:Label name="goldValue" text="0" class="chip__value" />
                <ui:VisualElement class="chip__rule" />
                <ui:Label text="+" class="chip__plus" />
            </ui:VisualElement>
            <ui:VisualElement name="gemChip" class="chip">
                <ui:Label name="gemIcon" text="" class="chip__icon icon chip__icon--gem" />
                <ui:Label name="gemValue" text="0" class="chip__value" />
                <ui:VisualElement class="chip__rule" />
                <ui:Label text="+" class="chip__plus" />
            </ui:VisualElement>

            <ui:Button name="overflowBtn" class="topbar__btn icon" />
            <ui:Button name="homeBtn" class="topbar__btn icon" />
        </ui:VisualElement>

        <ui:VisualElement name="content" class="sheet" />

        <ui:VisualElement name="navbar" class="navbar">
            <ui:Button name="tabHome" class="navtab navtab--active">
                <ui:Label name="tabHomeIcon" text="" class="navtab__icon icon" />
                <ui:Label text="로비" class="navtab__label" />
            </ui:Button>
            <ui:Button name="tabRoster" class="navtab">
                <ui:Label name="tabRosterIcon" text="" class="navtab__icon icon" />
                <ui:Label text="사원" class="navtab__label" />
            </ui:Button>
            <ui:Button name="tabParty" class="navtab">
                <ui:Label name="tabPartyIcon" text="" class="navtab__icon icon" />
                <ui:Label text="편성" class="navtab__label" />
            </ui:Button>
            <ui:Button name="tabQuests" class="navtab">
                <ui:Label name="tabQuestsIcon" text="" class="navtab__icon icon" />
                <ui:Label text="업무" class="navtab__label" />
                <ui:Label name="dailyBadge" text="" class="navtab__badge hidden" />
            </ui:Button>
            <ui:Button name="tabProgress" class="navtab">
                <ui:Label name="tabProgressIcon" text="" class="navtab__icon icon" />
                <ui:Label text="검토" class="navtab__label" />
                <ui:Label name="progressBadge" text="" class="navtab__badge hidden" />
            </ui:Button>
            <ui:Button name="tabStory" class="navtab">
                <ui:Label name="tabStoryIcon" text="" class="navtab__icon icon" />
                <ui:Label text="메신저" class="navtab__label" />
            </ui:Button>
            <ui:Button name="tabAlbum" class="navtab">
                <ui:Label name="tabAlbumIcon" text="" class="navtab__icon icon" />
                <ui:Label text="앨범" class="navtab__label" />
            </ui:Button>
            <ui:Button name="tabCodex" class="navtab">
                <ui:Label name="tabCodexIcon" text="" class="navtab__icon icon" />
                <ui:Label text="도감" class="navtab__label" />
            </ui:Button>
            <ui:Button name="tabChart" class="navtab">
                <ui:Label name="tabChartIcon" text="" class="navtab__icon icon" />
                <ui:Label text="통계" class="navtab__label" />
            </ui:Button>

            <ui:VisualElement class="spacer" />

            <ui:Button name="tabGacha" class="navcta">
                <ui:Label name="tabGachaIcon" text="" class="navcta__icon icon" />
                <ui:Label text="모집" class="navcta__label" />
            </ui:Button>
        </ui:VisualElement>

        <ui:Label name="statusText" text="" class="statusbar hidden" />
        <ui:VisualElement name="overlay" class="overlay hidden" />
    </ui:VisualElement>
</ui:UXML>
