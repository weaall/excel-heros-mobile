<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="App.uss" />
    <!--
      A landscape mobile game, held sideways.

      This was an Excel window: a green app bar, a formula bar, column letters, a row gutter and
      sheet tabs, with the game hidden inside the grid. That disguise is gone, and the boss key
      that existed only to serve it went with it.

      What replaces it is the shape a landscape game actually uses. A slim top bar carries what you
      have. A rail of large buttons down the left is the navigation, because held sideways the
      thumbs rest at the sides and the bottom edge is the worst place to reach. Everything between
      is the game, and it now gets the whole frame rather than what a spreadsheet left over.
    -->
    <ui:VisualElement name="root" class="root">

        <ui:VisualElement name="topbar" class="topbar">
            <ui:Label name="docTitle" text="엑셀 히어로즈" class="topbar__title" />
            <ui:VisualElement class="spacer" />

            <ui:VisualElement name="goldChip" class="chip">
                <ui:Label name="goldIcon" text="" class="chip__icon icon" />
                <ui:Label name="goldValue" text="0" class="chip__value" />
            </ui:VisualElement>
            <ui:VisualElement name="gemChip" class="chip">
                <ui:Label name="gemIcon" text="" class="chip__icon icon chip__icon--gem" />
                <ui:Label name="gemValue" text="0" class="chip__value" />
            </ui:VisualElement>

            <ui:Button name="overflowBtn" class="topbar__btn icon" />
        </ui:VisualElement>

        <ui:VisualElement name="middle" class="middle">

            <!-- The navigation rail. Held sideways this is where a thumb already is. -->
            <ui:VisualElement name="rail" class="rail">
                <ui:Button name="tabHome" class="rail__tab rail__tab--active">
                    <ui:Label name="tabHomeIcon" text="" class="rail__icon icon" />
                    <ui:Label text="메인" class="rail__label" />
                </ui:Button>
                <ui:Button name="tabRoster" class="rail__tab">
                    <ui:Label name="tabRosterIcon" text="" class="rail__icon icon" />
                    <ui:Label text="인사" class="rail__label" />
                </ui:Button>
                <ui:Button name="tabGacha" class="rail__tab">
                    <ui:Label name="tabGachaIcon" text="" class="rail__icon icon" />
                    <ui:Label text="모집" class="rail__label" />
                </ui:Button>
                <ui:Button name="tabQuests" class="rail__tab">
                    <ui:Label name="tabQuestsIcon" text="" class="rail__icon icon" />
                    <ui:Label text="업무" class="rail__label" />
                    <ui:Label name="dailyBadge" text="" class="rail__badge hidden" />
                </ui:Button>
                <ui:VisualElement class="spacer" />
                <ui:Button name="sheetListBtn" class="rail__tab rail__tab--more">
                    <ui:Label name="moreIcon" text="" class="rail__icon icon" />
                    <ui:Label text="더보기" class="rail__label" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="content" class="sheet" />
        </ui:VisualElement>

        <ui:Label name="statusText" text="" class="statusbar" />
        <ui:VisualElement name="overlay" class="overlay hidden" />
    </ui:VisualElement>
</ui:UXML>
