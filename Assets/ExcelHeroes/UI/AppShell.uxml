<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="App.uss" />
    <!--
      Excel for Android, not desktop Excel shrunk down.

      The phone app throws the ribbon away: there is a slim green app bar, then the grid starts
      immediately, and every control lives along the BOTTOM where a thumb reaches — formula bar,
      then a command bar whose "홈 ▲" slides the ribbon up as a sheet over the grid. Stacking a
      title bar, ribbon tabs, a ribbon and a formula bar above the content, the way the desktop
      does, spends a third of a phone screen on chrome before the game gets any.

      Order here is top to bottom, and it is the order the phone app uses.
    -->
    <ui:VisualElement name="root" class="root">

        <!-- Back, the file name centred, then the action icons — the order the phone app uses. -->
        <ui:VisualElement name="appbar" class="appbar">
            <ui:Button name="backBtn" class="appbar__btn icon icon--back" />
            <ui:Label name="docTitle" text="통합 문서1" class="appbar__title" />
            <ui:Button name="searchBtn" class="appbar__btn icon icon--search" />
            <ui:Button name="undoBtn" class="appbar__btn icon icon--undo" />
            <!-- The disguise has to be reachable without looking, so it is pinned, not in the overflow. -->
            <ui:Button name="stealthToggle" class="appbar__btn icon icon--bosskey" />
            <ui:Button name="overflowBtn" class="appbar__btn icon icon--overflow" />
        </ui:VisualElement>

        <!-- fx belongs at the top: the name box and the formula read as a header for the grid,
             and down at the thumb end it was competing with the tab strip for the same band. -->
        <ui:VisualElement name="formulaBar" class="formula-bar">
            <ui:Label name="nameBox" text="A1" class="name-box" />
            <ui:Label text="fx" class="fx" />
            <ui:Label name="formula" text="=SUM(Hero_ATK)" class="formula" />
            <ui:Label text="v" class="formula-expand" />
        </ui:VisualElement>

        <!-- Column letters. With the ribbon gone this is what says "spreadsheet" at a glance. -->
        <ui:VisualElement name="colHeaders" class="ws-cols">
            <ui:Label text="" class="ws-corner" />
            <ui:Label text="A" class="ws-col" />
            <ui:Label text="B" class="ws-col" />
            <ui:Label text="C" class="ws-col" />
            <ui:Label text="D" class="ws-col" />
            <ui:Label text="E" class="ws-col" />
            <ui:Label text="F" class="ws-col" />
        </ui:VisualElement>

        <ui:VisualElement name="sheetRow" class="sheet-row">
            <ui:VisualElement name="rowGutter" class="ws-rows" />
            <ui:VisualElement name="content" class="sheet" />
        </ui:VisualElement>

        <!-- Slides up over the grid when 홈 ▲ is tapped; collapsed is the resting state. -->
        <ui:VisualElement name="ribbon" class="ribbon hidden" />

        <ui:VisualElement name="sheetTabsRow" class="sheet-tabs-row">
            <ui:Button name="sheetListBtn" class="sheet-list-btn icon icon--sheets" />
            <ui:ScrollView name="sheetTabsScroll" mode="Horizontal" class="sheet-tabs-scroll">
            <ui:VisualElement name="sheetTabs" class="sheet-tabs">
                <ui:Button name="tabHome" text="메인" class="sheet-tab sheet-tab--active" />
                <ui:Button name="tabRoster" text="인사" class="sheet-tab" />
                <ui:Button name="tabGacha" text="데이터" class="sheet-tab" />
                <ui:Button name="tabQuests" text="업무" class="sheet-tab">
                    <ui:Label name="dailyBadge" text="" class="sheet-tab__badge hidden" />
                </ui:Button>
            </ui:VisualElement>
            </ui:ScrollView>
            <ui:Button name="addSheetBtn" class="sheet-add-btn icon icon--add" />
        </ui:VisualElement>

        <ui:VisualElement name="commandbar" class="commandbar">
            <ui:Button name="ribbonToggle" text="홈 ▲" class="cmd-tab" />
            <ui:VisualElement class="spacer" />
            <ui:VisualElement name="gemChip" class="cell-stat">
                <ui:Label text="합계" class="cell-stat__icon" />
                <ui:Label name="gemValue" text="0" class="cell-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement name="goldChip" class="cell-stat">
                <ui:Label text="개수" class="cell-stat__icon" />
                <ui:Label name="goldValue" text="0" class="cell-stat__value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="overlay" class="overlay hidden" />
    </ui:VisualElement>
</ui:UXML>
